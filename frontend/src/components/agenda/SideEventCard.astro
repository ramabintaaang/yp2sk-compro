---
interface Props {
  day: string;
  month: string;
  tag: string;
  title: string;
  description: string;
}

const { day, month, tag, title, description } = Astro.props;
---

<div class="bg-white p-6 sm:p-7 rounded-3xl shadow-soft border border-slate-200/80 hover:shadow-lg transition transform hover:-translate-y-1 flex-1 flex flex-col justify-between group">
  <div class="flex items-start gap-4 sm:gap-5">
    <div class="text-brand-emerald font-bold text-center border-r pr-4 sm:pr-5 border-slate-100 shrink-0 font-sans">
      <span class="block text-2xl sm:text-3xl font-bold leading-none mb-1 text-brand-emerald">{day}</span>
      <span class="block text-xs uppercase font-semibold text-slate-500 tracking-wider font-sans">{month}</span>
    </div>
    <div class="space-y-2">
      <span class="badge-pill bg-brand-iceBlue text-brand-emerald border border-brand-mint font-sans text-[11px] font-semibold uppercase tracking-wider inline-block">
        {tag}
      </span>
      <h4 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-brand-emerald transition-colors font-sans leading-snug">
        {title}
      </h4>
      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans">
        {description}
      </p>
    </div>
  </div>
</div>
