---
const { pathname } = Astro.url;
// Normalize pathname by removing trailing slash if present, unless it is root
const activePath = pathname === '/' ? '/' : pathname.replace(/\/$/, '');
---
<nav class="sticky top-0 left-0 w-full z-50 flex justify-between items-center px-4 sm:px-6 lg:px-8 shadow-xs border-b border-slate-100 transition-all duration-200 ease-in-out h-20 bg-white/95 backdrop-blur-md font-sans">
  <div class="max-w-7xl w-full mx-auto flex items-center justify-between">
    <!-- Brand Logo -->
    <a class="flex items-center gap-3 group" href="/">
      <div class="w-12 h-12 rounded-xl bg-white p-1 flex items-center justify-center border border-slate-200/80 shadow-xs group-hover:scale-105 transition-transform shrink-0">
        <img src="/images/logo-yp2sk.png" alt="Logo Yayasan Pendidikan Pesantren Sunan Kudus" class="w-full h-full object-contain" />
      </div>
      <div>
        <span class="block font-bold text-lg leading-tight text-slate-900 tracking-tight flex items-center gap-1.5 font-sans">
          YP2SK
        </span>
        <span class="block text-[11px] text-slate-500 tracking-wide uppercase font-medium font-sans">Yayasan Pesantren Sunan Kudus</span>
      </div>
    </a>
    
    <!-- Desktop Navigation -->
    <div class="hidden lg:flex items-center space-x-7 text-[13px] font-medium text-slate-700">
      <a class={`transition-colors font-medium ${activePath === '/' ? 'text-brand-emerald font-bold' : 'hover:text-brand-emerald'}`} href="/">Beranda</a>
      
      <!-- Profil Dropdown -->
      <div class="relative nav-dropdown py-2">
        <button class={`dropdown-trigger flex items-center gap-1 transition-colors cursor-pointer ${activePath.startsWith('/profil') ? 'text-brand-emerald font-bold' : 'hover:text-brand-emerald'}`} aria-expanded="false">
          <span>Profil</span>
          <svg class="dropdown-icon w-3.5 h-3.5 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
        <div class="dropdown-menu absolute left-0 top-full mt-1 w-52 bg-white rounded-xl shadow-xl border border-slate-100 py-2 z-50 opacity-0 pointer-events-none scale-95 -translate-y-2 transition-all duration-200 ease-out origin-top-left">
          <a class={`block px-4 py-2 text-xs transition-colors ${activePath === '/profil/yayasan' ? 'text-brand-emerald bg-emerald-50 font-bold' : 'text-slate-700 hover:bg-emerald-50 hover:text-brand-emerald'}`} href="/profil/yayasan">Profil Yayasan</a>
          <a class={`block px-4 py-2 text-xs transition-colors ${activePath === '/profil/visi-misi' ? 'text-brand-emerald bg-emerald-50 font-bold' : 'text-slate-700 hover:bg-emerald-50 hover:text-brand-emerald'}`} href="/profil/visi-misi">Visi dan Misi</a>
        </div>
      </div>
      
      <!-- Pendidikan Dropdown -->
      <div class="relative nav-dropdown py-2">
        <button class={`dropdown-trigger flex items-center gap-1 transition-colors cursor-pointer ${activePath.startsWith('/pendidikan') ? 'text-brand-emerald font-bold' : 'hover:text-brand-emerald'}`} aria-expanded="false">
          <span>Pendidikan</span>
          <svg class="dropdown-icon w-3.5 h-3.5 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
        <div class="dropdown-menu absolute left-0 top-full mt-1 w-64 bg-white rounded-xl shadow-xl border border-slate-100 py-2 z-50 opacity-0 pointer-events-none scale-95 -translate-y-2 transition-all duration-200 ease-out origin-top-left">
          <a class={`block px-4 py-2 text-xs transition-colors ${activePath.startsWith('/pendidikan/tpa-kb-tk-naneymi') ? 'text-brand-emerald bg-emerald-50 font-bold' : 'text-slate-700 hover:bg-emerald-50 hover:text-brand-emerald'}`} href="/pendidikan/tpa-kb-tk-naneymi">TPA - KB - TK NANEYMI</a>
          <a class={`block px-4 py-2 text-xs transition-colors ${activePath.startsWith('/pendidikan/tpa-kb-tk-dinado') ? 'text-brand-emerald bg-emerald-50 font-bold' : 'text-slate-700 hover:bg-emerald-50 hover:text-brand-emerald'}`} href="/pendidikan/tpa-kb-tk-dinado">TPA - KB - TK DINADO</a>
          <a class={`block px-4 py-2 text-xs transition-colors ${activePath.startsWith('/pendidikan/kb-tk-inklusi-istimewa') ? 'text-brand-emerald bg-emerald-50 font-bold' : 'text-slate-700 hover:bg-emerald-50 hover:text-brand-emerald'}`} href="/pendidikan/kb-tk-inklusi-istimewa">KB - TK Inklusi Istimewa</a>
          <a class={`block px-4 py-2 text-xs transition-colors ${activePath.startsWith('/pendidikan/skiis') ? 'text-brand-emerald bg-emerald-50 font-bold' : 'text-slate-700 hover:bg-emerald-50 hover:text-brand-emerald'}`} href="/pendidikan/skiis">SD - SMP - SMA - SMK (SKISS)</a>
          <a class={`block px-4 py-2 text-xs transition-colors ${activePath.startsWith('/pendidikan/graha-autis') ? 'text-brand-emerald bg-emerald-50 font-bold' : 'text-slate-700 hover:bg-emerald-50 hover:text-brand-emerald'}`} href="/pendidikan/graha-autis">Graha Autis (Layanan ABK)</a>
          <a class={`block px-4 py-2 text-xs transition-colors ${activePath.startsWith('/pendidikan/ponpes-tahfidz') ? 'text-brand-emerald bg-emerald-50 font-bold' : 'text-slate-700 hover:bg-emerald-50 hover:text-brand-emerald'}`} href="/pendidikan/ponpes-tahfidz">Ponpes Tahfidz Al Qur'an Sunan Kudus</a>
        </div>
      </div>
      
      <a class={`transition-colors font-medium ${activePath === '/agenda' ? 'text-brand-emerald font-bold' : 'hover:text-brand-emerald'}`} href="/agenda">Agenda</a>
      <a class={`transition-colors font-medium ${activePath === '/berita' ? 'text-brand-emerald font-bold' : 'hover:text-brand-emerald'}`} href="/berita">Berita</a>
      <a class={`transition-colors font-medium ${activePath === '/galeri' ? 'text-brand-emerald font-bold' : 'hover:text-brand-emerald'}`} href="/galeri">Galeri</a>
      <a class={`transition-colors font-medium ${activePath === '/kontak' ? 'text-brand-emerald font-bold' : 'hover:text-brand-emerald'}`} href="/kontak">Kontak</a>
    </div>
    
    <!-- Action Buttons -->
    <div class="flex items-center gap-3">
      <a
        class="inline-flex items-center justify-center px-5 py-2.5 rounded-full text-xs font-semibold text-white bg-brand-emerald hover:bg-brand-emeraldDark transition shadow-sm hover:shadow gap-1.5"
        href="/kontak"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        <span>Daftar PSB</span>
      </a>
      <button id="open-mobile-menu" class="lg:!hidden material-symbols-outlined text-slate-800 text-[30px] cursor-pointer" aria-label="Open Mobile Menu">menu</button>
    </div>
  </div>
</nav>

<!-- Mobile Drawer Overlay -->
<div id="mobile-menu-drawer" class="fixed inset-0 z-50 translate-x-full transition-transform duration-300 ease-in-out lg:hidden">
  <!-- Backdrop -->
  <div id="mobile-menu-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
  <!-- Content -->
  <div class="absolute right-0 top-0 h-full w-80 bg-white p-6 shadow-2xl flex flex-col justify-between border-l border-slate-100 z-50 overflow-y-auto">
    <div>
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-slate-100">
        <div class="flex items-center gap-2">
          <div class="w-9 h-9 rounded-lg bg-white p-1 flex items-center justify-center border border-slate-200/80 shadow-xs shrink-0">
            <img src="/images/logo-yp2sk.png" alt="Logo YP2SK" class="w-full h-full object-contain" />
          </div>
          <span class="font-bold text-base text-slate-900">YP2SK</span>
        </div>
        <button id="close-mobile-menu" class="material-symbols-outlined text-slate-700 text-[24px] cursor-pointer" aria-label="Close Mobile Menu">close</button>
      </div>
      <nav class="flex flex-col gap-3 font-sans text-sm">
        <a class={`py-2 transition-colors ${activePath === '/' ? 'text-brand-emerald font-bold' : 'text-slate-700 hover:text-brand-emerald'}`} href="/">Beranda</a>
        
        <div class="flex flex-col py-1">
          <span class="text-xs uppercase tracking-wider text-slate-400 font-bold mb-2">Profil</span>
          <div class="flex flex-col pl-3 gap-2 border-l-2 border-slate-100">
            <a class={`py-1 text-xs transition-colors ${activePath === '/profil/yayasan' ? 'text-brand-emerald font-bold' : 'text-slate-600 hover:text-brand-emerald'}`} href="/profil/yayasan">Profil Yayasan</a>
            <a class={`py-1 text-xs transition-colors ${activePath === '/profil/visi-misi' ? 'text-brand-emerald font-bold' : 'text-slate-600 hover:text-brand-emerald'}`} href="/profil/visi-misi">Visi dan Misi</a>
          </div>
        </div>

        <div class="flex flex-col py-1">
          <span class="text-xs uppercase tracking-wider text-slate-400 font-bold mb-2">Pendidikan</span>
          <div class="flex flex-col pl-3 gap-2 border-l-2 border-slate-100">
            <a class={`py-1 text-xs transition-colors ${activePath.startsWith('/pendidikan/tpa-kb-tk-naneymi') ? 'text-brand-emerald font-bold' : 'text-slate-600 hover:text-brand-emerald'}`} href="/pendidikan/tpa-kb-tk-naneymi">TPA - KB - TK NANEYMI</a>
            <a class={`py-1 text-xs transition-colors ${activePath.startsWith('/pendidikan/tpa-kb-tk-dinado') ? 'text-brand-emerald font-bold' : 'text-slate-600 hover:text-brand-emerald'}`} href="/pendidikan/tpa-kb-tk-dinado">TPA - KB - TK DINADO</a>
            <a class={`py-1 text-xs transition-colors ${activePath.startsWith('/pendidikan/kb-tk-inklusi-istimewa') ? 'text-brand-emerald font-bold' : 'text-slate-600 hover:text-brand-emerald'}`} href="/pendidikan/kb-tk-inklusi-istimewa">KB - TK Inklusi Istimewa</a>
            <a class={`py-1 text-xs transition-colors ${activePath.startsWith('/pendidikan/skiis') ? 'text-brand-emerald font-bold' : 'text-slate-600 hover:text-brand-emerald'}`} href="/pendidikan/skiis">SD - SMP - SMA - SMK (SKISS)</a>
            <a class={`py-1 text-xs transition-colors ${activePath.startsWith('/pendidikan/graha-autis') ? 'text-brand-emerald font-bold' : 'text-slate-600 hover:text-brand-emerald'}`} href="/pendidikan/graha-autis">Graha Autis (Layanan ABK)</a>
            <a class={`py-1 text-xs transition-colors ${activePath.startsWith('/pendidikan/ponpes-tahfidz') ? 'text-brand-emerald font-bold' : 'text-slate-600 hover:text-brand-emerald'}`} href="/pendidikan/ponpes-tahfidz">Ponpes Tahfidz Al Qur'an Sunan Kudus</a>
          </div>
        </div>
        
        <a class={`py-2 transition-colors ${activePath === '/agenda' ? 'text-brand-emerald font-bold' : 'text-slate-700 hover:text-brand-emerald'}`} href="/agenda">Agenda</a>
        <a class={`py-2 transition-colors ${activePath === '/berita' ? 'text-brand-emerald font-bold' : 'text-slate-700 hover:text-brand-emerald'}`} href="/berita">Berita</a>
        <a class={`py-2 transition-colors ${activePath === '/galeri' ? 'text-brand-emerald font-bold' : 'text-slate-700 hover:text-brand-emerald'}`} href="/galeri">Galeri</a>
        <a class={`py-2 transition-colors ${activePath === '/kontak' ? 'text-brand-emerald font-bold' : 'text-slate-700 hover:text-brand-emerald'}`} href="/kontak">Kontak</a>
      </nav>
    </div>
    <div class="pt-6 border-t border-slate-100">
      <a href="/kontak" class="w-full py-3 bg-brand-emerald hover:bg-brand-emeraldDark text-white text-xs font-bold rounded-full transition shadow-sm text-center block">Daftar PSB 2025/2026</a>
    </div>
  </div>
</div>

<script>
  function setupNavbar() {
    const openBtn = document.getElementById('open-mobile-menu');
    const closeBtn = document.getElementById('close-mobile-menu');
    const drawer = document.getElementById('mobile-menu-drawer');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    const dropdowns = document.querySelectorAll('.nav-dropdown');

    function openMenu() {
      drawer?.classList.remove('translate-x-full');
    }

    function closeMenu() {
      drawer?.classList.add('translate-x-full');
    }

    function closeAllDropdowns() {
      dropdowns.forEach(dropdown => {
        dropdown.classList.remove('is-open');
        const trigger = dropdown.querySelector('.dropdown-trigger');
        const menu = dropdown.querySelector('.dropdown-menu');
        const icon = dropdown.querySelector('.dropdown-icon');
        
        menu?.classList.remove('opacity-100', 'scale-100', 'translate-y-0', 'pointer-events-auto');
        menu?.classList.add('opacity-0', 'scale-95', '-translate-y-2', 'pointer-events-none');
        icon?.classList.remove('rotate-180');
        trigger?.setAttribute('aria-expanded', 'false');
      });
    }

    openBtn?.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);
    backdrop?.addEventListener('click', closeMenu);

    // Dropdown toggle functionality
    dropdowns.forEach(dropdown => {
      const trigger = dropdown.querySelector('.dropdown-trigger');
      const menu = dropdown.querySelector('.dropdown-menu');
      const icon = dropdown.querySelector('.dropdown-icon');

      trigger?.addEventListener('click', (e) => {
        e.stopPropagation();
        
        const isOpen = dropdown.classList.contains('is-open');

        // Close all other dropdowns first
        closeAllDropdowns();

        if (!isOpen) {
          dropdown.classList.add('is-open');
          menu?.classList.remove('opacity-0', 'scale-95', '-translate-y-2', 'pointer-events-none');
          menu?.classList.add('opacity-100', 'scale-100', 'translate-y-0', 'pointer-events-auto');
          icon?.classList.add('rotate-180');
          trigger?.setAttribute('aria-expanded', 'true');
        }
      });
    });

    // Close dropdowns when clicking outside
    document.addEventListener('click', (e) => {
      if (!(e.target as Element)?.closest('.nav-dropdown')) {
        closeAllDropdowns();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAllDropdowns();
        closeMenu();
      }
    });
  }

  // Support both standard page loads and Astro View Transitions
  setupNavbar();
  document.addEventListener('astro:page-load', setupNavbar);
</script>
