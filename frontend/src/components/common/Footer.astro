---
// Footer.astro - Clean & Compact Modern Footer
---
<footer class="bg-white border-t border-slate-200/80 pt-10 pb-8 text-slate-600 text-xs font-sans">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-6 pb-8 border-b border-slate-100">
      <!-- Col 1: Brand Info (2 cols) -->
      <div class="lg:col-span-2 space-y-3">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-white p-1 flex items-center justify-center border border-slate-200/80 shadow-xs shrink-0">
            <img src="/images/logo-yp2sk.png" alt="Logo Yayasan Pendidikan Pesantren Sunan Kudus" class="w-full h-full object-contain" />
          </div>
          <div>
            <span class="block font-bold text-sm sm:text-base text-slate-900 leading-tight">YP2SK Kudus</span>
            <span class="block text-[10px] text-slate-400">Yayasan Pendidikan Pesantren Sunan Kudus</span>
          </div>
        </div>

        <!-- Organized Contact Details -->
        <div class="space-y-2 text-xs text-slate-500 font-sans pt-1">
          <div class="flex items-start gap-2.5">
            <span class="material-symbols-outlined text-brand-emerald text-[16px] shrink-0 mt-0.5">location_on</span>
            <span class="leading-relaxed text-slate-600">
              Jln. Madurekso No. 22, Langgar Dalem, <br class="hidden sm:inline" />
              Kota Kudus, Jawa Tengah
            </span>
          </div>

          <div class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-brand-emerald text-[16px] shrink-0">call</span>
            <span class="text-slate-600">
              WA: 
              <a href="https://wa.me/6281234567890" target="_blank" rel="noopener noreferrer" class="text-slate-800 hover:text-brand-emerald font-semibold transition-colors">
                +62 812-3456-7890
              </a>
            </span>
          </div>

          <div class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-brand-emerald text-[16px] shrink-0">mail</span>
            <span class="text-slate-600">
              Email: 
              <a href="mailto:sekretariat@yp2sk.sch.id" class="text-slate-800 hover:text-brand-emerald font-semibold transition-colors">
                sekretariat@yp2sk.sch.id
              </a>
            </span>
          </div>
        </div>

        <!-- Social media pills -->
        <div class="flex items-center gap-2 pt-2">
          <a href="#" class="w-7 h-7 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center font-bold text-[10px] hover:bg-brand-emerald hover:text-white transition shadow-2xs" aria-label="WhatsApp">WA</a>
          <a href="#" class="w-7 h-7 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center font-bold text-[10px] hover:bg-brand-emerald hover:text-white transition shadow-2xs" aria-label="Instagram">IG</a>
          <a href="#" class="w-7 h-7 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center font-bold text-[10px] hover:bg-brand-emerald hover:text-white transition shadow-2xs" aria-label="YouTube">YT</a>
          <a href="#" class="w-7 h-7 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center font-bold text-[10px] hover:bg-brand-emerald hover:text-white transition shadow-2xs" aria-label="Facebook">FB</a>
        </div>
      </div>

      <!-- Col 2: Program / Jenjang -->
      <div>
        <h5 class="font-bold text-slate-900 mb-2.5 text-xs tracking-wider uppercase">Jenjang</h5>
        <ul class="space-y-1.5 text-slate-500 text-[11px] sm:text-xs">
          <li><a class="hover:text-brand-emerald transition-colors" href="/pendidikan/tpa-kb-tk-naneymi">TPA - KB - TK NANEYMI</a></li>
          <li><a class="hover:text-brand-emerald transition-colors" href="/pendidikan/tpa-kb-tk-dinado">TPA - KB - TK DINADO</a></li>
          <li><a class="hover:text-brand-emerald transition-colors" href="/pendidikan/kb-tk-inklusi-istimewa">KB - TK Inklusi Istimewa</a></li>
          <li><a class="hover:text-brand-emerald transition-colors" href="/pendidikan/skiis">SD - SMP - SMA - SMK (SKISS)</a></li>
          <li><a class="hover:text-brand-emerald transition-colors" href="/pendidikan/graha-autis">Graha Autis (Layanan ABK)</a></li>
          <li><a class="hover:text-brand-emerald transition-colors" href="/pendidikan/ponpes-tahfidz">Ponpes Tahfidz Al Qur'an Sunan Kudus</a></li>
        </ul>
      </div>

      <!-- Col 3: Lembaga / Tentang Kami -->
      <div>
        <h5 class="font-bold text-slate-900 mb-2.5 text-xs tracking-wider uppercase">Profil</h5>
        <ul class="space-y-1.5 text-slate-500 text-[11px] sm:text-xs">
          <li><a class="hover:text-brand-emerald transition-colors" href="/profil/yayasan">Sejarah &amp; Masyayikh</a></li>
          <li><a class="hover:text-brand-emerald transition-colors" href="/profil/visi-misi">Visi &amp; Misi Kelembagaan</a></li>
          <li><a class="hover:text-brand-emerald transition-colors" href="/berita">Kabar &amp; Prestasi Santri</a></li>
          <li><a class="hover:text-brand-emerald transition-colors" href="/galeri">Galeri Kegiatan</a></li>
        </ul>
      </div>

      <!-- Col 4: Informasi & Bantuan -->
      <div>
        <h5 class="font-bold text-slate-900 mb-2.5 text-xs tracking-wider uppercase">Informasi</h5>
        <ul class="space-y-1.5 text-slate-500 text-[11px] sm:text-xs">
          <li><a class="hover:text-brand-emerald transition-colors" href="/agenda">Panduan PSB 2025/2026</a></li>
          <li><a class="hover:text-brand-emerald transition-colors" href="/kontak">Brosur &amp; Rincian Biaya</a></li>
          <li><a class="hover:text-brand-emerald transition-colors" href="/kontak">Beasiswa Tahfidz &amp; Dhu'afa</a></li>
          <li><a class="hover:text-brand-emerald transition-colors" href="/kontak">Hubungi Call Center</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-5 flex flex-col sm:flex-row items-center justify-between text-[11px] text-slate-400 gap-2 sm:gap-4 font-sans">
      <p>© 2025 Yayasan Pendidikan Pesantren Sunan Kudus (YP2SK). Hak Cipta Dilindungi.</p>
      <p class="flex items-center gap-2">
        <span>Terakreditasi BAN-PDM &amp; Kemenag RI</span>
        <span>•</span>
        <span>Kudus, Jawa Tengah</span>
      </p>
    </div>
  </div>
</footer>
