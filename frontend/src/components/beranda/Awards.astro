---
// Awards and recognitions section matching raw/beranda.html
---
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16" id="prestasi">
  <div class="bg-slate-50 rounded-3xl p-8 sm:p-12 lg:p-16 border border-slate-200/70 flex flex-col lg:flex-row items-center gap-12">
    <!-- Circular Visual Layout like Severna reference -->
    <div 
      class="relative w-64 h-64 sm:w-80 sm:h-80 flex-shrink-0 flex items-center justify-center"
      data-aos="zoom-in"
      data-aos-delay="100"
    >
      <div class="w-full h-full rounded-full overflow-hidden border-8 border-white shadow-xl">
        <img
          alt="Prestasi Santri Sunan Kudus"
          class="w-full h-full object-cover"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuBDgdJ6hHiolU1CAs6TSwoBsIGy1bhIGN3AIbHeM54yRD4XWQSCzBiZcjGxqT_vzlbh2CU2BL_RBJDSj5biYfvCGkxNO0nZZpwyjwymL_b4U3utJX5bdtxMygHaitr31uarFpchrTQVX9tabYQeNmmpGBOk0pa9Zx6Bj42QsiE7PySLnjLOyNFuPQDqJrjktA7Rm_u5bt1b6keLLIzBxRl2a0h04MQOLn-SFn2zSB8k1yB1YLNzG1-Fyg"
        />
      </div>
      <!-- Floating Badge -->
      <div 
        class="absolute -bottom-2 right-4 bg-white rounded-2xl p-3 shadow-lg border border-slate-100 flex items-center gap-3"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        <span class="text-2xl">🏆</span>
        <div>
          <p class="text-xs font-bold text-slate-800 font-sans">Juara Umum</p>
          <p class="text-[10px] text-slate-500 font-sans">MHQ &amp; OSN Nasional</p>
        </div>
      </div>
    </div>

    <!-- Awards Text Content -->
    <div 
      class="space-y-5 font-sans"
      data-aos="fade-left"
      data-aos-delay="200"
    >
      <span class="badge-pill bg-white text-slate-700 border border-slate-200 shadow-sm font-sans">
        Prestasi Santri
      </span>
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight font-sans">
        Pesantren &amp; Madrasah Berprestasi Nasional &amp; Internasional
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans">
        Dedikasi para santri terbukti melalui berbagai capaian membanggakan, mulai dari kejuaraan Musabaqah Hifdzil Qur’an (MHQ) tingkat nasional, Olimpiade Sains Madrasah, hingga lomba karya ilmiah remaja tingkat internasional.
      </p>

      <!-- Badges list matching layout -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
        <div class="p-3 bg-white rounded-xl border border-slate-200 flex items-center gap-2 shadow-xs">
          <span class="text-emerald-600 text-lg">🥇</span>
          <span class="text-xs font-semibold text-slate-800 font-sans">Juara 1 MHQ 30 Juz Nasional</span>
        </div>
        <div class="p-3 bg-white rounded-xl border border-slate-200 flex items-center gap-2 shadow-xs">
          <span class="text-blue-600 text-lg">🏅</span>
          <span class="text-xs font-semibold text-slate-800 font-sans">Medali Perak OSN Fisika &amp; Kimia</span>
        </div>
        <div class="p-3 bg-white rounded-xl border border-slate-200 flex items-center gap-2 shadow-xs">
          <span class="text-amber-600 text-lg">⭐</span>
          <span class="text-xs font-semibold text-slate-800 font-sans">Pesantren Ramah Santri Terakreditasi</span>
        </div>
      </div>

      <div class="pt-2">
        <a
          href="/berita"
          class="text-xs font-bold text-brand-emerald hover:text-brand-emeraldDark inline-flex items-center gap-1 font-sans transition-colors"
        >
          Lihat Seluruh Daftar Penghargaan &amp; Sertifikasi Sanad ↗
        </a>
      </div>
    </div>
  </div>
</section>
