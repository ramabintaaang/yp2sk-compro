---

<!-- Program Pendidikan Grid -->
<section class="py-xl px-margin-mobile md:px-margin-desktop bg-background" id="lembaga">
  <div class="max-w-[1140px] mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-xl">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary/10 text-secondary font-label-md text-xs font-semibold mb-3">
        <span class="material-symbols-outlined text-[16px]">mosque</span> Naungan Pendidikan YP2SK
      </span>
      <h2 class="font-headline-lg text-headline-lg text-primary mb-4">Lembaga Pendidikan Kami</h2>
      <p class="text-on-surface-variant max-w-2xl mx-auto font-body-md">
        Membina generasi beriman, berilmu, dan berakhlakul karimah dari usia dini hingga pendidikan menengah kejuruan dan pondok pesantren tahfidz Al-Qur'an.
      </p>
    </div>
    
    <!-- Top 2 Featured: SKISS & Ponpes Tahfidz -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter mb-gutter">
      {programs.filter(p => p.featured).map((prog) => (
        <div class="group bg-surface-container-lowest rounded-2xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-300 flex flex-col justify-between border border-surface-variant/40 hover:border-secondary/40 relative">
          <div class="flex flex-col">
            <div class="h-64 sm:h-72 overflow-hidden relative">
              <img 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" 
                alt={prog.title} 
                src={prog.image} 
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-transparent to-transparent"></div>
              <div class="absolute top-4 left-4">
                <span class="px-3 py-1 rounded-full bg-surface-container-lowest/90 backdrop-blur-md text-secondary font-label-md text-xs font-bold shadow-sm">
                  {prog.badge}
                </span>
              </div>
              <div class="absolute bottom-4 left-4 right-4 text-white">
                <p class="text-xs text-secondary-container font-semibold tracking-wide uppercase mb-1">{prog.tagline}</p>
                <h3 class="font-headline-md text-xl md:text-2xl font-bold text-white leading-tight drop-shadow-sm">{prog.title}</h3>
              </div>
            </div>
            <div class="p-6">
              <p class="text-on-surface-variant text-sm leading-relaxed mb-4">{prog.desc}</p>
              <div class="flex flex-wrap gap-1.5">
                {prog.tags.map((tag) => (
                  <span class="px-2.5 py-0.5 rounded-md bg-surface-container text-on-surface-variant text-xs font-medium">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
          <div class="p-6 pt-0 border-t border-surface-container/60 mt-2">
            <a 
              href={prog.link} 
              class="w-full py-2.5 px-4 rounded-xl bg-secondary/10 hover:bg-secondary text-secondary hover:text-white font-label-md font-semibold text-sm flex items-center justify-center gap-2 transition-all duration-200 cursor-pointer"
            >
              <span>Pelajari Profil Lembaga</span>
              <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom 4: TPA-KB-TK Naneymi, TPA-KB-TK Dinado, KB-TK Inklusi Istimewa, Graha Autis -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter items-stretch">
      {programs.filter(p => !p.featured).map((prog) => (
        <div class="group bg-surface-container-lowest rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between border border-surface-variant/40 hover:border-secondary/30">
          <div class="flex flex-col">
            <div class="h-44 overflow-hidden relative">
              <img 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                alt={prog.title} 
                src={prog.image} 
                loading="lazy"
              />
              <div class="absolute top-3 left-3">
                <span class="px-2.5 py-0.5 rounded-full bg-surface-container-lowest/90 backdrop-blur-md text-secondary font-label-md text-xs font-bold">
                  {prog.badge}
                </span>
              </div>
            </div>
            <div class="p-5">
              <p class="text-xs text-secondary font-semibold mb-1">{prog.tagline}</p>
              <h3 class="font-headline-md text-base text-primary font-bold mb-2 leading-snug">{prog.title}</h3>
              <p class="text-on-surface-variant text-xs leading-relaxed mb-4">{prog.desc}</p>
              <div class="flex flex-wrap gap-1">
                {prog.tags.map((tag) => (
                  <span class="px-2 py-0.5 rounded bg-surface-container text-on-surface-variant text-[11px]">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
          <div class="p-5 pt-0">
            <a 
              href={prog.link} 
              class="font-label-md text-secondary text-xs font-bold flex items-center justify-between py-2 border-t border-surface-container hover:text-primary transition-colors cursor-pointer"
            >
              <span>Pelajari Detail</span>
              <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
