<!-- Hero Section -->
<header
  class="relative pt-20 h-[90vh] flex items-center overflow-hidden bg-primary"
>
  <!-- Slides Container -->
  <div class="absolute inset-0 z-0">
    <!-- Slide 1 (Active by default) -->
    <div
      class="absolute inset-0 opacity-100 z-0 hero-slide"
      data-index="0"
      data-active="true"
    >
      <div
        class="slide-bg w-full h-full bg-cover bg-center scale-100"
        style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCavFC-99FADJK6mO15qdRLjoreFX-FK3DeOp-_BK11xqeikKtizE4CjRMes2HaSlT6lx-2Yl_6SF53rsp0awfSaGCJ_Yw1xg-jEwYgrEiUN4d29JRAEZ8jF2iBGfZceSjU6rQrSR-0aoc9vP060egOHlfluZTT0I1VU-IECfDv87L0YYmQ_Cv0qKeVfJSoQJYcJfve44NMj6h3ldF3T9lG1XF1vg4KBpuLs-10nqCanmN97hm9jfmyjg')"
        role="img"
        aria-label="Yayasan Dinado Kindergarten Building"
      >
      </div>
    </div>

    <!-- Slide 2 -->
    <div
      class="absolute inset-0 opacity-0 -z-10 hero-slide"
      data-index="1"
      data-active="false"
    >
      <div
        class="slide-bg w-full h-full bg-cover bg-center scale-110"
        style="background-image: url('https://images.unsplash.com/photo-1577896851231-70ef18881754?q=80&w=1600&auto=format&fit=crop')"
        role="img"
        aria-label="Kegiatan Belajar Anak-anak"
      >
      </div>
    </div>

    <!-- Slide 3 -->
    <div
      class="absolute inset-0 opacity-0 -z-10 hero-slide"
      data-index="2"
      data-active="false"
    >
      <div
        class="slide-bg w-full h-full bg-cover bg-center scale-110"
        style="background-image: url('https://images.unsplash.com/photo-1516627145497-ae6968895b74?q=80&w=1600&auto=format&fit=crop')"
        role="img"
        aria-label="Aktivitas Kreatif dan Bermain"
      >
      </div>
    </div>

    <!-- Gradient & Dark Tint Overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-primary/95 via-primary/70 to-transparent"
    >
    </div>
    <div class="absolute inset-0 bg-black/15"></div>
  </div>

  <!-- Text Content Area -->
  <div
    class="relative z-10 px-margin-mobile md:px-margin-desktop max-w-4xl text-on-primary"
  >
    <h1
      class="font-headline-xl text-5xl sm:text-6xl md:text-7xl lg:text-6xl mb-md leading-[1.1] tracking-tight font-bold drop-shadow-lg"
    >
      Membangun Generasi <br />
      <span
        class="text-transparent bg-clip-text bg-gradient-to-r from-secondary-fixed via-emerald-300 to-secondary-fixed"
        >Unggul Berkarakter</span
      >
    </h1>
    <p
      class="font-body-lg text-lg sm:text-xl md:text-2xl mb-lg max-w-2xl text-on-primary/95 font-medium leading-relaxed drop-shadow-md"
    >
      YP2SK berkomitmen menghadirkan pendidikan anak usia dini yang berkualitas,
      amanah, dan menumbuhkan potensi terbaik anak dalam lingkungan yang islami
      dan menyenangkan.
    </p>
    <div class="flex flex-wrap gap-4">
      <a
        href="#"
        class="px-8 py-3.5 bg-secondary text-on-primary font-label-lg text-label-lg rounded-lg hover:translate-y-[-2px] hover:shadow-xl hover:bg-secondary/90 transition-all shadow-lg text-center cursor-pointer"
      >
        Daftar Sekarang
      </a>
      <a
        href="#"
        class="px-8 py-3.5 border border-on-primary text-on-primary font-label-lg text-label-lg rounded-lg hover:bg-on-primary/10 transition-all text-center cursor-pointer"
      >
        Jelajahi Program
      </a>
    </div>
  </div>

  <!-- Slide Navigation Buttons (Hidden on mobile for cleaner UI) -->
  <button
    id="hero-prev"
    class="hidden md:flex absolute left-6 top-1/2 -translate-y-1/2 z-20 w-12 h-12 items-center justify-center rounded-full bg-white/10 hover:bg-white/20 border border-white/15 text-on-primary transition-all duration-200 backdrop-blur-sm cursor-pointer group shadow-lg"
    aria-label="Slide Sebelumnya"
  >
    <span
      class="material-symbols-outlined transition-transform group-hover:-translate-x-0.5 text-2xl"
      >chevron_left</span
    >
  </button>
  <button
    id="hero-next"
    class="hidden md:flex absolute right-6 top-1/2 -translate-y-1/2 z-20 w-12 h-12 items-center justify-center rounded-full bg-white/10 hover:bg-white/20 border border-white/15 text-on-primary transition-all duration-200 backdrop-blur-sm cursor-pointer group shadow-lg"
    aria-label="Slide Berikutnya"
  >
    <span
      class="material-symbols-outlined transition-transform group-hover:translate-x-0.5 text-2xl"
      >chevron_right</span
    >
  </button>

  <!-- Slide Indicator Dots -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex gap-2.5">
    <button
      class="hero-dot w-8 h-3 rounded-full bg-secondary-fixed transition-all duration-300 cursor-pointer shadow-md"
      aria-label="Slide 1"></button>
    <button
      class="hero-dot w-3 h-3 rounded-full bg-on-primary/30 hover:bg-on-primary/50 transition-all duration-300 cursor-pointer shadow-sm"
      aria-label="Slide 2"></button>
    <button
      class="hero-dot w-3 h-3 rounded-full bg-on-primary/30 hover:bg-on-primary/50 transition-all duration-300 cursor-pointer shadow-sm"
      aria-label="Slide 3"></button>
  </div>
</header>

<style>
  /* Smooth Fade transitions for slides */
  .hero-slide {
    transition: opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Ken Burns zoom transition on background images */
  .slide-bg {
    transition: transform 6.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
</style>

<script>
  function initHeroSlider() {
    const slides = document.querySelectorAll(".hero-slide");
    const dots = document.querySelectorAll(".hero-dot");
    const prevBtn = document.getElementById("hero-prev");
    const nextBtn = document.getElementById("hero-next");

    if (slides.length === 0) return;

    let currentSlide = 0;
    let slideInterval: any;
    const intervalTime = 6000; // 6 seconds

    function showSlide(index: number) {
      // Deactivate current active slide
      slides[currentSlide].classList.remove("opacity-100", "z-0");
      slides[currentSlide].classList.add("opacity-0", "-z-10");
      slides[currentSlide].setAttribute("data-active", "false");

      // Reset scale to zoomed-in state for inactive slide
      const currentBg = slides[currentSlide].querySelector(".slide-bg");
      if (currentBg) {
        currentBg.classList.remove("scale-100");
        currentBg.classList.add("scale-110");
      }

      // Update dot styles
      if (dots.length > 0) {
        dots[currentSlide].classList.remove("bg-secondary-fixed", "w-8");
        dots[currentSlide].classList.add("bg-on-primary/30", "w-3");
      }

      // Calculate new index
      currentSlide = (index + slides.length) % slides.length;

      // Activate new slide
      slides[currentSlide].classList.remove("opacity-0", "-z-10");
      slides[currentSlide].classList.add("opacity-100", "z-0");
      slides[currentSlide].setAttribute("data-active", "true");

      // Trigger slow zoom-in transition (to scale-100)
      const newBg = slides[currentSlide].querySelector(".slide-bg");
      if (newBg) {
        newBg.classList.remove("scale-110");
        newBg.classList.add("scale-100");
      }

      // Update active dot style
      if (dots.length > 0) {
        dots[currentSlide].classList.remove("bg-on-primary/30", "w-3");
        dots[currentSlide].classList.add("bg-secondary-fixed", "w-8");
      }
    }

    function nextSlide() {
      showSlide(currentSlide + 1);
    }

    function prevSlide() {
      showSlide(currentSlide - 1);
    }

    function startSlideShow() {
      clearInterval(slideInterval);
      slideInterval = setInterval(nextSlide, intervalTime);
    }

    // Set click handlers for dot indicators
    dots.forEach((dot, idx) => {
      dot.addEventListener("click", () => {
        showSlide(idx);
        startSlideShow();
      });
    });

    // Set click handlers for arrow buttons
    if (prevBtn) {
      prevBtn.addEventListener("click", () => {
        prevSlide();
        startSlideShow();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener("click", () => {
        nextSlide();
        startSlideShow();
      });
    }

    // Trigger initial slide zoom-in
    const firstBg = slides[0].querySelector(".slide-bg");
    if (firstBg) {
      // Small timeout ensures transition engine registers the change from initial state
      setTimeout(() => {
        firstBg.classList.remove("scale-110");
        firstBg.classList.add("scale-100");
      }, 50);
    }

    startSlideShow();
  }

  // Support Astro View Transitions (re-run script after navigation)
  document.addEventListener("astro:page-load", initHeroSlider);
  // Run on initial load
  initHeroSlider();
</script>
