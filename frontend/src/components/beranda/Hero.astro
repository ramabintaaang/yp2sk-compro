---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-12 sm:pb-16 font-sans">
  <!-- Hero Slider Container -->
  <div 
    id="hero-slider" 
    class="relative rounded-3xl overflow-hidden bg-[#092328] text-white min-h-[520px] md:min-h-[560px] shadow-xl border border-[#12544F] group select-none"
    data-aos="zoom-out"
    data-aos-duration="900"
    aria-roledescription="carousel"
    aria-label="Sorotan Utama YP2SK"
  >
    <!-- Slides Wrapper -->
    {slides.map((slide, index) => (
      <div 
        class={`hero-slide absolute inset-0 transition-all duration-700 ease-in-out flex items-center p-7 sm:p-12 lg:p-16 ${
          index === 0 ? "opacity-100 z-10 pointer-events-auto" : "opacity-0 z-0 pointer-events-none"
        }`}
        data-index={index}
        role="group"
        aria-roledescription="slide"
        aria-label={`Slide ${index + 1} dari ${slides.length}`}
      >
        <!-- Background Image with Clean Tonal Gradient Overlay -->
        <div class="absolute inset-0 z-0 overflow-hidden">
          <img
            alt={slide.imageAlt}
            class="hero-slide-img w-full h-full object-cover transition-transform duration-1000 ease-out scale-100"
            src={slide.image}
            loading={index === 0 ? "eager" : "lazy"}
          />
          <div
            class="absolute inset-0"
            style="background: linear-gradient(to right, rgba(9,35,40,0.96) 0%, rgba(9,35,40,0.88) 50%, rgba(9,35,40,0.55) 78%, rgba(9,35,40,0.2) 100%);"
          ></div>
        </div>
        
        <!-- Slide Content -->
        <div class="relative z-20 max-w-2xl space-y-4 sm:space-y-5">
          <!-- Badge -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-medium bg-[#12544F] text-[#8BBB92] border border-[#2A835F]/40 backdrop-blur-sm w-fit">
            <span class="w-1.5 h-1.5 rounded-full bg-[#8BBB92]"></span>
            <span>{slide.badge}</span>
          </div>
        
          <!-- Title -->
          <h1 class="text-2xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-tight font-sans" set:html={slide.title} />
          
          <!-- Subtitle -->
          <p class="text-xs sm:text-sm md:text-base text-slate-200 leading-relaxed font-normal">
            {slide.subtitle}
          </p>
          
          <!-- Highlight Badges -->
          <div class="flex flex-wrap items-center gap-2 pt-1">
            {slide.highlights.map((h) => (
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs bg-[#12544F]/60 text-slate-200 border border-[#8BBB92]/25">
                <span>{h.icon}</span>
                <span>{h.text}</span>
              </span>
            ))}
          </div>
          
          <!-- CTA Buttons -->
          <div class="pt-2 flex flex-wrap items-center gap-3">
            <a
              class="px-6 py-3.5 rounded-xl bg-[#2A835F] hover:bg-[#12544F] text-white font-semibold text-xs sm:text-sm shadow-md transition-all duration-200 transform hover:-translate-y-0.5 whitespace-nowrap cursor-pointer flex items-center gap-2"
              href={slide.primaryBtn.href}
            >
              <span>{slide.primaryBtn.text}</span>
              <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
            <a
              class="px-6 py-3.5 rounded-xl bg-[#12544F]/60 hover:bg-[#12544F] border border-[#8BBB92]/40 text-white font-medium text-xs sm:text-sm transition-all duration-200 whitespace-nowrap cursor-pointer"
              href={slide.secondaryBtn.href}
            >
              {slide.secondaryBtn.text}
            </a>
          </div>
        </div>
      </div>
    ))}

    <!-- Bottom Controls Bar (Dots Indicators & Navigation Arrows) -->
    <div class="absolute bottom-6 left-6 right-6 sm:bottom-8 sm:left-12 sm:right-12 z-30 flex items-center justify-between pointer-events-none">
      <!-- Dots Indicators -->
      <div class="flex items-center gap-2 pointer-events-auto bg-[#092328]/80 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-[#12544F]">
        {slides.map((_, i) => (
          <button
            type="button"
            class={`slider-dot transition-all duration-300 rounded-full h-2 cursor-pointer ${
              i === 0 ? "w-7 bg-[#8BBB92] shadow-sm" : "w-2 bg-white/30 hover:bg-white/60"
            }`}
            data-target={i}
            aria-label={`Pindah ke slide ${i + 1}`}
          />
        ))}
      </div>

      <!-- Arrow Controls & Counter -->
      <div class="flex items-center gap-2 pointer-events-auto">
        <span id="slider-counter" class="text-xs font-mono font-medium text-slate-300 bg-[#092328]/80 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-[#12544F] mr-1 hidden sm:inline-block">
          01 / {slides.length < 10 ? `0${slides.length}` : slides.length}
        </span>
        <button
          type="button"
          id="hero-slider-prev"
          class="w-9 h-9 rounded-full bg-[#092328]/80 hover:bg-[#12544F] backdrop-blur-md border border-[#12544F] text-[#8BBB92] hover:text-white flex items-center justify-center transition active:scale-95 text-base cursor-pointer"
          aria-label="Slide sebelumnya"
        >
          ‹
        </button>
        <button
          type="button"
          id="hero-slider-next"
          class="w-9 h-9 rounded-full bg-[#092328]/80 hover:bg-[#12544F] backdrop-blur-md border border-[#12544F] text-[#8BBB92] hover:text-white flex items-center justify-center transition active:scale-95 text-base cursor-pointer"
          aria-label="Slide selanjutnya"
        >
          ›
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  function setupHeroSlider() {
    const sliderContainer = document.getElementById('hero-slider');
    if (!sliderContainer) return;

    const slides = sliderContainer.querySelectorAll<HTMLElement>('.hero-slide');
    const dots = sliderContainer.querySelectorAll<HTMLButtonElement>('.slider-dot');
    const prevBtn = document.getElementById('hero-slider-prev');
    const nextBtn = document.getElementById('hero-slider-next');
    const counter = document.getElementById('slider-counter');

    if (slides.length <= 1) return;

    let currentIndex = 0;
    let timer: number | null = null;
    const intervalTime = 5500; // 5.5 seconds per slide

    const updateSlider = (newIndex: number) => {
      currentIndex = (newIndex + slides.length) % slides.length;

      slides.forEach((slide, idx) => {
        const img = slide.querySelector<HTMLImageElement>('.hero-slide-img');
        if (idx === currentIndex) {
          slide.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
          slide.classList.add('opacity-100', 'z-10', 'pointer-events-auto');
          if (img) {
            img.classList.remove('scale-105');
            img.classList.add('scale-100');
          }
        } else {
          slide.classList.remove('opacity-100', 'z-10', 'pointer-events-auto');
          slide.classList.add('opacity-0', 'z-0', 'pointer-events-none');
          if (img) {
            img.classList.remove('scale-100');
            img.classList.add('scale-105');
          }
        }
      });

      // Update dots
      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.classList.remove('w-2', 'bg-white/30');
          dot.classList.add('w-7', 'bg-[#8BBB92]', 'shadow-sm');
        } else {
          dot.classList.remove('w-7', 'bg-[#8BBB92]', 'shadow-sm');
          dot.classList.add('w-2', 'bg-white/30');
        }
      });

      // Update counter
      if (counter) {
        const curNum = currentIndex + 1;
        const totalNum = slides.length;
        counter.textContent = `${curNum < 10 ? '0' + curNum : curNum} / ${totalNum < 10 ? '0' + totalNum : totalNum}`;
      }
    };

    const startAutoSlide = () => {
      stopAutoSlide();
      timer = window.setInterval(() => {
        updateSlider(currentIndex + 1);
      }, intervalTime);
    };

    const stopAutoSlide = () => {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    };

    // Controls listeners
    prevBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      updateSlider(currentIndex - 1);
      startAutoSlide();
    });

    nextBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      updateSlider(currentIndex + 1);
      startAutoSlide();
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const target = parseInt(dot.getAttribute('data-target') || '0', 10);
        updateSlider(target);
        startAutoSlide();
      });
    });

    // Pause on hover
    sliderContainer.addEventListener('mouseenter', stopAutoSlide);
    sliderContainer.addEventListener('mouseleave', startAutoSlide);

    // Touch swipe support for mobile
    let touchStartX = 0;
    let touchEndX = 0;

    sliderContainer.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      stopAutoSlide();
    }, { passive: true });

    sliderContainer.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const swipeDistance = touchEndX - touchStartX;
      if (Math.abs(swipeDistance) > 40) {
        if (swipeDistance < 0) {
          updateSlider(currentIndex + 1); // Swipe left -> next
        } else {
          updateSlider(currentIndex - 1); // Swipe right -> prev
        }
      }
      startAutoSlide();
    }, { passive: true });

    // Initial start
    startAutoSlide();
  }

  // Support both standard load and Astro page transitions
  setupHeroSlider();
  document.addEventListener('astro:page-load', setupHeroSlider);
</script>
