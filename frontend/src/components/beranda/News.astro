---
import { allNewsArticles } from '../../data/berita';

const featuredNews = allNewsArticles.slice(0, 3);
---

<!-- Berita Terkini Section -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 font-sans">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-10 gap-4" data-aos="fade-up">
    <div>
      <span class="badge-pill bg-brand-iceBlue text-brand-emerald mb-2 border border-brand-mint font-sans">
        Kabar Terkini
      </span>
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight font-sans">
        Berita &amp; Artikel Pendidikan
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 mt-1 font-sans">
        Update terkini mengenai kegiatan, prestasi, dan wawasan pendidikan di YP2SK.
      </p>
    </div>
    <a
      href="/berita"
      class="text-xs font-bold text-brand-emerald hover:text-brand-emeraldDark inline-flex items-center gap-1 group font-sans transition-colors"
    >
      <span>Lihat Semua Berita</span>
      <span class="group-hover:translate-x-1 transition-transform">→</span>
    </a>
  </div>
  
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch font-sans">
    {featuredNews.map((article, index) => (
      <article
        class="bg-white rounded-3xl shadow-sm hover:shadow-md transition-all duration-300 border border-slate-200/80 overflow-hidden group flex flex-col justify-between"
        data-aos="fade-up"
        data-aos-delay={(index + 1) * 100}
      >
        <div>
          <a href={`/berita/${article.slug}`} class="h-48 sm:h-52 block overflow-hidden relative bg-slate-100">
            <img 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              alt={article.imageAlt} 
              src={article.imageSrc}
              loading="lazy"
            />
            <div class="absolute top-3.5 left-3.5">
              <span class="text-[10px] font-bold text-slate-800 bg-white/95 backdrop-blur-md px-3 py-1 rounded-full shadow-xs uppercase tracking-wider">
                {article.category}
              </span>
            </div>
          </a>
          <div class="p-6">
            <a href={`/berita/${article.slug}`} class="block group-hover:text-brand-emerald transition-colors">
              <h3 class="font-bold text-slate-900 text-base sm:text-lg mb-2 line-clamp-2 leading-snug font-sans">
                {article.title}
              </h3>
            </a>
            <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed mb-4 font-sans">
              {article.description}
            </p>
          </div>
        </div>
        <div class="p-6 pt-0">
          <div class="flex items-center justify-between pt-4 border-t border-slate-100 text-xs text-slate-400">
            <span>{article.date}</span>
            <a 
              href={`/berita/${article.slug}`} 
              class="text-brand-emerald hover:text-brand-emeraldDark font-bold inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform" 
              aria-label={`Baca ${article.title}`}
            >
              Baca Selengkapnya →
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
