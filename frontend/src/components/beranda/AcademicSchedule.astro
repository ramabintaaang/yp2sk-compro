---
// AcademicSchedule.astro - Compact & Tidy PSB Schedule Banner
---
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10" id="agenda" data-aos="fade-up">
  <div class="relative overflow-hidden bg-gradient-to-r from-emerald-50/90 via-white to-blue-50/70 border border-emerald-200/60 rounded-2xl sm:rounded-3xl p-6 sm:p-8 shadow-xs">
    <!-- Subtle ambient glow -->
    <div class="absolute -top-12 -right-12 w-48 h-48 bg-brand-emerald/10 rounded-full blur-2xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 font-sans">
      <!-- Left: Title, Badges & Schedule Info -->
      <div class="space-y-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-brand-emerald text-white shadow-2xs">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-200 animate-pulse"></span>
            PSB 2025/2026 Dibuka
          </span>
          
        </div>

        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight leading-snug">
            Jadwal Penerimaan Santri &amp; Siswa Baru
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 mt-1 max-w-2xl leading-relaxed">
            Pendaftaran online &amp; offline seluruh jenjang (PAUD, Graha Autis, SKIIS, dan Ponpes Tahfidz Sunan Kudus). Kuota terbatas untuk memastikan pembinaan personal dan beradab.
          </p>
        </div>
      </div>

      <!-- Right: Action Buttons -->
      <div class="flex flex-wrap sm:flex-nowrap items-center gap-3 shrink-0">
        <a
          href="/agenda"
          class="px-4 py-2.5 rounded-full text-xs font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 transition text-center whitespace-nowrap shadow-2xs"
        >
          Lihat Alur &amp; Syarat
        </a>
        <a
          href="/kontak"
          class="px-5 py-2.5 rounded-full text-xs font-bold text-white bg-brand-emerald hover:bg-brand-emeraldDark transition shadow-xs text-center whitespace-nowrap flex items-center gap-1.5"
        >
          <span>Daftar Sekarang</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </div>
</section>
