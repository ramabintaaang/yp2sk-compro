---
// Campuses locations section matching raw/beranda.html
---
<section class="max-w-5xl mx-auto px-4 sm:px-6 py-16 text-center" id="kampus" data-aos="fade-up">
  <span class="badge-pill bg-slate-100 text-slate-600 mb-3 font-sans">
    Lokasi Kampus
  </span>
  <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 font-sans">
    3 Kampus Terpadu di Kota Kudus
  </h2>
  <p class="text-xs sm:text-sm text-slate-500 max-w-lg mx-auto mt-2 mb-10 font-sans">
    Lingkungan belajar yang kondusif, tenang, dan terpisah antara santri putra dan putri untuk menjaga adab dan ketentraman ibadah.
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-left font-sans">
    <!-- Campus 1 -->
    <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-md transition" data-aos="fade-up" data-aos-delay="100">
      <div class="w-8 h-8 rounded-lg bg-emerald-100 text-brand-emerald flex items-center justify-center font-bold text-xs mb-4">
        01
      </div>
      <h3 class="font-bold text-slate-900 text-sm">Kampus Pusat (Putra)</h3>
      <p class="text-xs text-slate-500 mt-1">Kompleks Kauman, Dekat Menara Kudus</p>
      <p class="text-[11px] text-emerald-700 mt-3 font-semibold">Madrasah Tsanawiyah &amp; Tahfidz Dasar</p>
    </div>

    <!-- Campus 2 -->
    <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-md transition" data-aos="fade-up" data-aos-delay="200">
      <div class="w-8 h-8 rounded-lg bg-emerald-100 text-brand-emerald flex items-center justify-center font-bold text-xs mb-4">
        02
      </div>
      <h3 class="font-bold text-slate-900 text-sm">Kampus Banat (Putri)</h3>
      <p class="text-xs text-slate-500 mt-1">Kawasan Asri Bae Kudus</p>
      <p class="text-[11px] text-emerald-700 mt-3 font-semibold">MTs - MA Unggulan Putri &amp; Tahfidz</p>
    </div>

    <!-- Campus 3 -->
    <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-md transition" data-aos="fade-up" data-aos-delay="300">
      <div class="w-8 h-8 rounded-lg bg-emerald-100 text-brand-emerald flex items-center justify-center font-bold text-xs mb-4">
        03
      </div>
      <h3 class="font-bold text-slate-900 text-sm">Kampus Riset &amp; Sains MA (Putra)</h3>
      <p class="text-xs text-slate-500 mt-1">Kompleks Terpadu Gebog Kudus</p>
      <p class="text-[11px] text-emerald-700 mt-3 font-semibold">Laboratorium Sains &amp; Pusat Bahasa</p>
    </div>
  </div>
</section>
