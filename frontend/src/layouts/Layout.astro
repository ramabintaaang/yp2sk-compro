---
import '../styles/global.css';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import FloatingButton from '../components/common/FloatingButton.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  schema?: Record<string, any> | Record<string, any>[];
}

const { 
  title = "YP2SK | Yayasan Pendidikan Pesantren Sunan Kudus", 
  description = "YP2SK berkomitmen menghadirkan pendidikan berkualitas, amanah, dan menumbuhkan potensi terbaik anak dalam lingkungan yang islami dan menyenangkan.",
  image = "/og-image.png",
  type = "website",
  schema
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://yp2sk.or.id');
const imageUrl = new URL(image, canonicalURL.origin).href;
---

<!doctype html>
<html class="light" lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content="YP2SK" />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={imageUrl} />

    <!-- JSON-LD Structured Data -->
    {schema && (
      <script type="application/ld+json" is:raw set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body class="bg-background text-on-surface font-body-md overflow-x-hidden">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <FloatingButton />
  </body>
</html>
