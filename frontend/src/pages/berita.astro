const newsArticles = fallbackNews;

const beritaSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Beranda",
      "item": "https://yp2sk.or.id"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Berita & Kabar",
      "item": "https://yp2sk.or.id/berita"
    }
  ]
};
---

<Layout 
  title="Berita & Wawasan Pendidikan Terbaru | YP2SK - Yayasan Pendidikan Pesantren Sunan Kudus" 
  description="Dapatkan kabar terkini mengenai prestasi siswa, inovasi program pembelajaran, serta tulisan opini dan wawasan pendidikan dari YP2SK."
  schema={beritaSchema}
>
  <div class="pt-20">
    <div class="max-w-[1140px] mx-auto px-margin-mobile md:px-0 py-xl">
      <!-- Header Section -->
      <header class="mb-lg space-y-md">
        <div class="inline-flex items-center gap-2 bg-secondary-container text-on-secondary-container px-4 py-1.5 rounded-full text-label-md font-label-md font-bold uppercase tracking-wider">
          <span class="material-symbols-outlined text-[18px]">newspaper</span>
          <span>Kabar &amp; Wawasan Terkini</span>
        </div>
        <h1 class="text-headline-xl-mobile md:text-headline-xl font-headline-xl text-primary max-w-[42rem] leading-tight">
          Berita &amp; Artikel Pendidikan
        </h1>
        <p class="text-body-lg font-body-lg text-on-surface-variant max-w-[36rem]">
          Ikuti perkembangan prestasi, info kegiatan, dan artikel opini terbaru dari seluruh lingkungan lembaga YP2SK.
        </p>
      </header>

      <!-- News & Articles Section -->
      <section>
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-md gap-4">
          <div>
            <h2 class="text-headline-md font-headline-md text-primary">Kumpulan Artikel &amp; Berita</h2>
            <p class="text-body-md text-on-surface-variant">Filter berdasarkan topik yang ingin Anda baca di bawah ini.</p>
          </div>
          <div class="flex flex-wrap gap-2 bg-surface-container-low p-1.5 rounded-full border border-outline-variant/30">
            <button data-filter="semua" class="px-5 py-2 bg-primary text-on-primary rounded-full text-label-md cursor-pointer transition-colors font-bold">Semua</button>
            <button data-filter="kegiatan" class="px-5 py-2 text-on-surface-variant hover:text-primary rounded-full text-label-md cursor-pointer transition-colors font-bold">Kegiatan</button>
            <button data-filter="prestasi" class="px-5 py-2 text-on-surface-variant hover:text-primary rounded-full text-label-md cursor-pointer transition-colors font-bold">Prestasi</button>
            <button data-filter="opini" class="px-5 py-2 text-on-surface-variant hover:text-primary rounded-full text-label-md cursor-pointer transition-colors font-bold">Opini</button>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
          {newsArticles.map(article => (
            <NewsCard {...article} />
          ))}
        </div>

        <!-- Pagination -->
        <div class="mt-lg flex justify-center items-center gap-2">
          <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant text-primary hover:bg-surface-container transition-colors cursor-pointer">
            <span class="material-symbols-outlined">chevron_left</span>
          </button>
          <button class="w-10 h-10 flex items-center justify-center rounded-lg bg-primary text-on-primary font-bold cursor-pointer">1</button>
          <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant text-primary hover:bg-surface-container transition-colors cursor-pointer">2</button>
          <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant text-primary hover:bg-surface-container transition-colors cursor-pointer">3</button>
          <span class="text-on-surface-variant px-2">...</span>
          <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant text-primary hover:bg-surface-container transition-colors cursor-pointer">
            <span class="material-symbols-outlined">chevron_right</span>
          </button>
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  function setupFilters() {
    const filterButtons = document.querySelectorAll('[data-filter]');
    const newsCards = document.querySelectorAll('[data-category]');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filterValue = btn.getAttribute('data-filter');

        // Toggle active button style
        filterButtons.forEach(b => {
          b.classList.remove('bg-primary', 'text-on-primary');
          b.classList.add('text-on-surface-variant', 'hover:text-primary');
        });
        btn.classList.add('bg-primary', 'text-on-primary');
        btn.classList.remove('text-on-surface-variant', 'hover:text-primary');

        // Filter cards
        newsCards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filterValue === 'semua' || category === filterValue) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  }

  // Setup immediately
  setupFilters();
  // Re-run on View Transitions
  document.addEventListener('astro:after-swap', setupFilters);
</script>
