---
import Layout from '../layouts/Layout.astro';
import { allNewsArticles } from '../data/berita';

const beritaSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Beranda",
      "item": "https://yp2sk.or.id"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Berita & Kabar",
      "item": "https://yp2sk.or.id/berita"
    }
  ]
};
---

<Layout 
  title="Berita & Artikel Pendidikan Terkini | YP2SK Yayasan Sunan Kudus" 
  description="Dapatkan informasi kabar terkini mengenai prestasi santri, agenda kegiatan lembaga, pengumuman resmi, dan wawasan pendidikan Islami dari YP2SK."
  schema={beritaSchema}
>
  <!-- Floating Vector Ribbon Line matching yayasan.astro & index.astro -->
  <div aria-hidden="true" class="curved-line-bg">
    <svg class="w-full h-full opacity-35" fill="none" preserveAspectRatio="none" viewBox="0 0 1440 4800">
      <path d="M720,200 C1100,500 1200,900 850,1300 C500,1700 200,2000 550,2500 C900,3000 1250,3300 950,3800 C700,4200 400,4500 720,4800" stroke="#8BBB92" stroke-dasharray="8 8" stroke-width="2.5"></path>
    </svg>
  </div>

  <div class="relative z-10 font-sans">
    <!-- Header Hero Section (Panoramic Banner with Overlapping Card matching yayasan.astro) -->
    <section class="relative font-sans pb-6 sm:pb-10">
      <!-- Panoramic Banner -->
      <div class="relative w-full h-[320px] sm:h-[380px] lg:h-[420px] overflow-hidden bg-slate-950">
        <img 
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuCavFC-99FADJK6mO15qdRLjoreFX-FK3DeOp-_BK11xqeikKtizE4CjRMes2HaSlT6lx-2Yl_6SF53rsp0awfSaGCJ_Yw1xg-jEwYgrEiUN4d29JRAEZ8jF2iBGfZceSjU6rQrSR-0aoc9vP060egOHlfluZTT0I1VU-IECfDv87L0YYmQ_Cv0qKeVfJSoQJYcJfve44NMj6h3ldF3T9lG1XF1vg4KBpuLs-10nqCanmN97hm9jfmyjg"
          alt="Berita & Artikel Yayasan Pendidikan Pesantren Sunan Kudus" 
          class="w-full h-full object-cover object-center opacity-80"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/35 to-brand-emeraldDark/25"></div>
      </div>

      <!-- Overlapping Header Card -->
      <div class="max-w-4xl mx-auto px-4 sm:px-6 -mt-20 sm:-mt-24 lg:-mt-28 relative z-20" data-aos="fade-up">
        <div class="bg-white/95 backdrop-blur-md rounded-3xl p-8 sm:p-12 shadow-soft border border-slate-200/90 text-center">
          <span class="badge-pill bg-brand-iceBlue text-brand-emerald border border-brand-mint font-sans mb-4 inline-flex items-center gap-1.5">
            <span class="material-symbols-outlined text-sm">newspaper</span>
            Kabar &amp; Wawasan Terkini
          </span>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-slate-900 leading-tight font-sans">
            Berita &amp; Artikel YP2SK
          </h1>

          <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed font-sans font-normal">
            Ikuti perkembangan prestasi siswa, kegiatan inspiratif, dan artikel edukatif dari seluruh naungan lembaga pendidikan Yayasan Pendidikan Pesantren Sunan Kudus.
          </p>

          <!-- Search Input Bar -->
          <div class="mt-8 relative max-w-xl mx-auto">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-[20px]">
              search
            </span>
            <input 
              type="text" 
              id="news-search" 
              placeholder="Cari judul berita atau topik..." 
              class="w-full pl-12 pr-10 py-3.5 rounded-full bg-slate-50 border border-slate-200 text-slate-900 placeholder:text-slate-400 text-xs sm:text-sm shadow-inner focus:outline-none focus:ring-2 focus:ring-brand-emerald focus:bg-white transition-all font-sans"
            />
            <button 
              id="clear-search" 
              class="hidden absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 cursor-pointer"
              aria-label="Bersihkan pencarian"
            >
              <span class="material-symbols-outlined text-[18px]">close</span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content Area -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 font-sans">
      
      <!-- Filter & Status Bar -->
      <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4 pb-6 mb-8 sm:mb-10 border-b border-slate-200/80">
        <!-- Category Filter Pills -->
        <div class="flex flex-wrap items-center gap-2" id="filter-buttons-container">
          <button 
            data-filter="semua" 
            class="filter-btn active px-4 py-2 rounded-full text-xs font-bold transition-all duration-200 cursor-pointer bg-brand-emerald text-white shadow-sm font-sans"
          >
            Semua Artikel
          </button>
          <button 
            data-filter="prestasi" 
            class="filter-btn px-4 py-2 rounded-full text-xs font-semibold transition-all duration-200 cursor-pointer bg-white text-slate-700 border border-slate-200/90 hover:bg-slate-50 font-sans"
          >
            Prestasi
          </button>
          <button 
            data-filter="pesantren" 
            class="filter-btn px-4 py-2 rounded-full text-xs font-semibold transition-all duration-200 cursor-pointer bg-white text-slate-700 border border-slate-200/90 hover:bg-slate-50 font-sans"
          >
            Pesantren
          </button>
          <button 
            data-filter="kegiatan" 
            class="filter-btn px-4 py-2 rounded-full text-xs font-semibold transition-all duration-200 cursor-pointer bg-white text-slate-700 border border-slate-200/90 hover:bg-slate-50 font-sans"
          >
            Kegiatan
          </button>
          <button 
            data-filter="inklusi" 
            class="filter-btn px-4 py-2 rounded-full text-xs font-semibold transition-all duration-200 cursor-pointer bg-white text-slate-700 border border-slate-200/90 hover:bg-slate-50 font-sans"
          >
            Inklusi &amp; ABK
          </button>
          <button 
            data-filter="opini" 
            class="filter-btn px-4 py-2 rounded-full text-xs font-semibold transition-all duration-200 cursor-pointer bg-white text-slate-700 border border-slate-200/90 hover:bg-slate-50 font-sans"
          >
            Opini &amp; Edukasi
          </button>
        </div>

        <!-- Info Count -->
        <div class="text-xs text-slate-500 font-medium shrink-0 font-sans" id="articles-count-info">
          Menampilkan <span class="font-bold text-slate-900" id="current-range">1 - 6</span> dari <span class="font-bold text-slate-900" id="total-articles">{allNewsArticles.length}</span> artikel
        </div>
      </div>

      <!-- Articles Grid (6 per page) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch" id="news-grid">
        {allNewsArticles.map((article, index) => (
          <article 
            class="news-card group bg-white rounded-3xl overflow-hidden shadow-soft hover:shadow-lg transition-all duration-300 border border-slate-200/80 flex flex-col justify-between transform hover:-translate-y-1"
            data-id={article.id}
            data-index={index}
            data-category={article.categoryKey}
            data-title={article.title.toLowerCase()}
            data-desc={article.description.toLowerCase()}
          >
            <div>
              <!-- Thumbnail -->
              <a href={`/berita/${article.slug}`} class="h-56 block relative overflow-hidden bg-slate-900">
                <img 
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" 
                  alt={article.imageAlt} 
                  src={article.imageSrc}
                  loading="lazy"
                />
                <div class="absolute top-3.5 left-3.5">
                  <span class="badge-pill bg-white/95 backdrop-blur-md text-brand-emerald border border-brand-mint text-[11px] font-bold uppercase tracking-wider shadow-xs font-sans">
                    {article.category}
                  </span>
                </div>
              </a>

              <!-- Content Body -->
              <div class="p-6 sm:p-7 space-y-3 font-sans">
                <div class="flex items-center text-xs text-slate-500 font-sans">
                  <span class="flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[15px] text-brand-emerald">calendar_today</span>
                    {article.date}
                  </span>
                </div>

                <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-emerald transition-colors line-clamp-2 leading-snug font-sans">
                  <a href={`/berita/${article.slug}`}>
                    {article.title}
                  </a>
                </h3>

                <p class="text-slate-600 text-xs sm:text-sm leading-relaxed line-clamp-3 font-sans">
                  {article.description}
                </p>
              </div>
            </div>

            <!-- Card Footer -->
            <div class="p-6 sm:p-7 pt-0 font-sans">
              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-[11px] text-slate-400 font-medium font-sans">{article.author}</span>
                <a href={`/berita/${article.slug}`} class="inline-flex items-center gap-1 text-brand-emerald font-bold text-xs group-hover:translate-x-1 transition-transform cursor-pointer font-sans">
                  Baca Selengkapnya
                  <span class="material-symbols-outlined text-sm">arrow_forward</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Empty State Message -->
      <div id="empty-state" class="hidden text-center py-16 bg-white rounded-3xl border border-dashed border-slate-200 shadow-soft my-6 font-sans">
        <span class="material-symbols-outlined text-5xl text-slate-300 mb-3 block">search_off</span>
        <h3 class="text-xl font-bold text-slate-900 mb-1 font-sans">Artikel Tidak Ditemukan</h3>
        <p class="text-slate-600 text-xs sm:text-sm max-w-md mx-auto mb-6 leading-relaxed font-sans">
          Tidak ada artikel yang cocok dengan pencarian atau filter yang Anda pilih. Silakan gunakan kata kunci lain.
        </p>
        <button 
          id="reset-filter-btn" 
          class="px-6 py-2.5 rounded-full bg-brand-emerald text-white text-xs font-bold hover:bg-brand-emeraldDark transition-all cursor-pointer shadow-md font-sans"
        >
          Tampilkan Semua Artikel
        </button>
      </div>

      <!-- Pagination Controls (6 per page) -->
      <nav id="pagination-controls" aria-label="Navigasi Halaman Berita" class="mt-12 flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 border-t border-slate-200/80 font-sans">
        <div class="text-xs text-slate-500 font-sans">
          Halaman <span id="current-page-num" class="font-bold text-slate-900">1</span> dari <span id="total-pages-num" class="font-bold text-slate-900">2</span>
        </div>

        <div class="flex items-center gap-1.5" id="pagination-buttons">
          <!-- Prev Button -->
          <button 
            id="prev-page-btn" 
            class="w-10 h-10 rounded-2xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 flex items-center justify-center transition-colors disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer shadow-xs"
            aria-label="Halaman Sebelumnya"
          >
            <span class="material-symbols-outlined text-[20px]">chevron_left</span>
          </button>

          <!-- Page Numbers Container -->
          <div id="page-numbers" class="flex items-center gap-1.5">
            <!-- Injected by JS -->
          </div>

          <!-- Next Button -->
          <button 
            id="next-page-btn" 
            class="w-10 h-10 rounded-2xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 flex items-center justify-center transition-colors disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer shadow-xs"
            aria-label="Halaman Berikutnya"
          >
            <span class="material-symbols-outlined text-[20px]">chevron_right</span>
          </button>
        </div>
      </nav>

    </main>
  </div>
</Layout>

<script>
  function setupNewsDirectory() {
    const ITEMS_PER_PAGE = 6;
    let currentPage = 1;
    let currentFilter = 'semua';
    let searchQuery = '';

    const allCards = Array.from(document.querySelectorAll('.news-card')) as HTMLElement[];
    const filterButtons = document.querySelectorAll('.filter-btn');
    const searchInput = document.getElementById('news-search') as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById('clear-search');
    const resetBtn = document.getElementById('reset-filter-btn');
    const emptyState = document.getElementById('empty-state');
    const paginationControls = document.getElementById('pagination-controls');
    const pageNumbersContainer = document.getElementById('page-numbers');
    const prevBtn = document.getElementById('prev-page-btn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('next-page-btn') as HTMLButtonElement | null;
    const currentRangeEl = document.getElementById('current-range');
    const totalArticlesEl = document.getElementById('total-articles');
    const currentPageNumEl = document.getElementById('current-page-num');
    const totalPagesNumEl = document.getElementById('total-pages-num');
    const newsGrid = document.getElementById('news-grid');

    function updateFilterButtonStyles() {
      filterButtons.forEach(b => {
        const val = b.getAttribute('data-filter') || 'semua';
        if (val === currentFilter) {
          b.classList.add('active', 'bg-brand-emerald', 'text-white', 'shadow-sm');
          b.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200/90', 'hover:bg-slate-50');
        } else {
          b.classList.remove('active', 'bg-brand-emerald', 'text-white', 'shadow-sm');
          b.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200/90', 'hover:bg-slate-50');
        }
      });
    }

    function getMatchingCards(): HTMLElement[] {
      return allCards.filter(card => {
        const category = card.getAttribute('data-category') || '';
        const title = card.getAttribute('data-title') || '';
        const desc = card.getAttribute('data-desc') || '';

        const matchesFilter = currentFilter === 'semua' || category === currentFilter;
        const matchesSearch = !searchQuery || title.includes(searchQuery) || desc.includes(searchQuery);

        return matchesFilter && matchesSearch;
      });
    }

    function renderPage() {
      const matchingCards = getMatchingCards();
      const totalMatching = matchingCards.length;
      const totalPages = Math.ceil(totalMatching / ITEMS_PER_PAGE) || 1;

      if (currentPage > totalPages) {
        currentPage = totalPages;
      }
      if (currentPage < 1) {
        currentPage = 1;
      }

      // Hide all first
      allCards.forEach(card => {
        card.classList.add('hidden');
      });

      if (totalMatching === 0) {
        emptyState?.classList.remove('hidden');
        paginationControls?.classList.add('hidden');
        if (currentRangeEl) currentRangeEl.textContent = '0';
        if (totalArticlesEl) totalArticlesEl.textContent = '0';
        return;
      }

      emptyState?.classList.add('hidden');
      paginationControls?.classList.remove('hidden');

      // Slice 6 items for current page
      const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
      const endIndex = Math.min(startIndex + ITEMS_PER_PAGE, totalMatching);
      const pageCards = matchingCards.slice(startIndex, endIndex);

      pageCards.forEach(card => {
        card.classList.remove('hidden');
      });

      // Update counters
      if (currentRangeEl) currentRangeEl.textContent = `${startIndex + 1} - ${endIndex}`;
      if (totalArticlesEl) totalArticlesEl.textContent = totalMatching.toString();
      if (currentPageNumEl) currentPageNumEl.textContent = currentPage.toString();
      if (totalPagesNumEl) totalPagesNumEl.textContent = totalPages.toString();

      // Update Pagination Buttons
      if (prevBtn) prevBtn.disabled = currentPage === 1;
      if (nextBtn) nextBtn.disabled = currentPage === totalPages;

      // Render Number buttons
      if (pageNumbersContainer) {
        pageNumbersContainer.innerHTML = '';
        for (let i = 1; i <= totalPages; i++) {
          const btn = document.createElement('button');
          btn.className = `w-10 h-10 rounded-2xl text-xs font-bold transition-all cursor-pointer shadow-xs ${
            i === currentPage 
              ? 'bg-brand-emerald text-white shadow-sm' 
              : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-50'
          }`;
          btn.textContent = i.toString();
          btn.setAttribute('aria-label', `Halaman ${i}`);
          btn.addEventListener('click', () => {
            currentPage = i;
            renderPage();
            newsGrid?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
          pageNumbersContainer.appendChild(btn);
        }
      }
    }

    // Filter Buttons click handler
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-filter') || 'semua';
        currentFilter = val;
        updateFilterButtonStyles();
        currentPage = 1;
        renderPage();
      });
    });

    // Search handler
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      if (searchQuery.length > 0) {
        clearSearchBtn?.classList.remove('hidden');
      } else {
        clearSearchBtn?.classList.add('hidden');
      }
      currentPage = 1;
      renderPage();
    });

    clearSearchBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      clearSearchBtn.classList.add('hidden');
      currentPage = 1;
      renderPage();
    });

    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      clearSearchBtn?.classList.add('hidden');
      currentFilter = 'semua';
      updateFilterButtonStyles();
      currentPage = 1;
      renderPage();
    });

    // Prev / Next button listeners
    prevBtn?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        renderPage();
        newsGrid?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    nextBtn?.addEventListener('click', () => {
      const matchingCards = getMatchingCards();
      const totalPages = Math.ceil(matchingCards.length / ITEMS_PER_PAGE) || 1;
      if (currentPage < totalPages) {
        currentPage++;
        renderPage();
        newsGrid?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    // Initial render
    updateFilterButtonStyles();
    renderPage();
  }

  setupNewsDirectory();
  document.addEventListener('astro:after-swap', setupNewsDirectory);
</script>
