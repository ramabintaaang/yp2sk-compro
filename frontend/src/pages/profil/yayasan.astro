---
import Layout from "../../layouts/Layout.astro";

const profileSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://yp2sk.or.id/profil/yayasan#webpage",
      url: "https://yp2sk.or.id/profil/yayasan",
      name: "Profil Yayasan | YP2SK",
      description:
        "Profil lengkap Yayasan Pendidikan Pesantren Sunan Kudus (YP2SK) - sejarah, nilai dasar, kepemimpinan, dan komitmen kami.",
      breadcrumb: {
        "@id": "https://yp2sk.or.id/profil/yayasan/#breadcrumb",
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://yp2sk.or.id/profil/yayasan/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Beranda",
          item: "https://yp2sk.or.id",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Profil Yayasan",
          item: "https://yp2sk.or.id/profil/yayasan",
        },
      ],
    },
  ],
};
---

<Layout
  title="Profil Yayasan | YP2SK - Yayasan Pendidikan Pesantren Sunan Kudus"
  description="Dedikasi tak henti dalam membangun generasi unggul yang berakhlak mulia, cerdas, dan mandiri melalui pendidikan berkelanjutan di YP2SK."
  schema={profileSchema}
>
  <!-- Floating Vector Ribbon Line matching index.astro -->
  <div aria-hidden="true" class="curved-line-bg">
    <svg class="w-full h-full opacity-35" fill="none" preserveAspectRatio="none" viewBox="0 0 1440 4800">
      <path d="M720,200 C1100,500 1200,900 850,1300 C500,1700 200,2000 550,2500 C900,3000 1250,3300 950,3800 C700,4200 400,4500 720,4800" stroke="#8BBB92" stroke-dasharray="8 8" stroke-width="2.5"></path>
    </svg>
  </div>

  <div class="relative z-10 font-sans">
    <!-- Hero Section (Cinematic Panoramic Banner with Overlapping Profile Card) -->
    <section class="relative font-sans pb-6 sm:pb-10">
      <!-- Panoramic Campus Banner -->
      <div class="relative w-full h-[320px] sm:h-[380px] lg:h-[420px] overflow-hidden bg-slate-950">
        <img
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuCavFC-99FADJK6mO15qdRLjoreFX-FK3DeOp-_BK11xqeikKtizE4CjRMes2HaSlT6lx-2Yl_6SF53rsp0awfSaGCJ_Yw1xg-jEwYgrEiUN4d29JRAEZ8jF2iBGfZceSjU6rQrSR-0aoc9vP060egOHlfluZTT0I1VU-IECfDv87L0YYmQ_Cv0qKeVfJSoQJYcJfve44NMj6h3ldF3T9lG1XF1vg4KBpuLs-10nqCanmN97hm9jfmyjg"
          alt="Prestigious school campus at sunrise representing YP2SK foundation"
          class="w-full h-full object-cover object-center opacity-80"
          loading="eager"
        />
        <!-- Atmospheric Vignette & Gradient Overlays -->
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/35 to-brand-emeraldDark/25"></div>
      </div>

      <!-- Overlapping Profile Header Card -->
      <div class="max-w-4xl mx-auto px-4 sm:px-6 -mt-20 sm:-mt-24 lg:-mt-28 relative z-20" data-aos="fade-up">
        <div class="bg-white/95 backdrop-blur-md rounded-3xl p-8 sm:p-12 shadow-soft border border-slate-200/90 text-center">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-slate-900 leading-tight font-sans">
            Profil Yayasan
          </h1>
          <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed font-sans font-normal">
            Dedikasi tak henti dalam membangun generasi unggul yang berakhlak mulia, cerdas, dan mandiri melalui pendidikan berkelanjutan.
          </p>
        </div>
      </div>
    </section>

    <!-- Nilai-Nilai Dasar (3 Pillars Style matching Pillars.astro) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 scroll-mt-24" id="nilai-nilai">
      <div class="max-w-3xl mx-auto text-center font-sans mb-12" data-aos="fade-up">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-900 tracking-tight font-sans">
          Nilai-Nilai Dasar Kami
        </h2>
        <div class="w-16 h-1 bg-brand-emerald mx-auto rounded-full mt-3"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Amanah (Soft Ice Blue matching Pillars Card 1) -->
        <div
          class="bg-brand-iceBlue rounded-3xl p-8 border border-blue-100 flex flex-col justify-between transition transform hover:-translate-y-1 shadow-soft group"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <div>
            <div class="w-12 h-12 rounded-2xl bg-blue-500/10 text-blue-700 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 group-hover:bg-blue-600 group-hover:text-white transition-all">
              <span class="material-symbols-outlined text-2xl">verified_user</span>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2 font-sans">
              Amanah
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans">
              Menjaga kepercayaan masyarakat dan stakeholder dengan integritas tinggi dan transparansi dalam setiap aspek pengelolaan yayasan.
            </p>
          </div>
        </div>

        <!-- Tumbuh (Soft Mint matching Pillars Card 2) -->
        <div
          class="bg-brand-mint rounded-3xl p-8 border border-emerald-100 flex flex-col justify-between transition transform hover:-translate-y-1 shadow-soft group"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <div>
            <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-800 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 group-hover:bg-brand-emerald group-hover:text-white transition-all">
              <span class="material-symbols-outlined text-2xl">trending_up</span>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2 font-sans">
              Tumbuh
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans">
              Terus berkembang secara berkelanjutan, inovatif, dan adaptif terhadap perubahan zaman guna memberikan layanan pendidikan terbaik.
            </p>
          </div>
        </div>

        <!-- Unggul (Soft Yellow/Warm matching Pillars Card 3) -->
        <div
          class="bg-brand-warmYellow rounded-3xl p-8 border border-amber-100 flex flex-col justify-between transition transform hover:-translate-y-1 shadow-soft group"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <div>
            <div class="w-12 h-12 rounded-2xl bg-amber-500/15 text-amber-900 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 group-hover:bg-amber-600 group-hover:text-white transition-all">
              <span class="material-symbols-outlined text-2xl">workspace_premium</span>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2 font-sans">
              Unggul
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans">
              Berkomitmen pada kualitas pendidikan yang melampaui standar, mencetak lulusan yang kompetitif dan berkarakter kuat.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sejarah Yayasan -->
    <section class="py-12 sm:py-20 scroll-mt-24" id="sejarah">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Section Title -->
        <div class="max-w-3xl mx-auto text-center font-sans mb-12 sm:mb-16" data-aos="fade-up">
          <span class="badge-pill bg-brand-iceBlue text-brand-emerald mb-3 border border-brand-mint font-sans">
            Jejak Langkah
          </span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-900 tracking-tight leading-snug font-sans">
            Sejarah Berdirinya Yayasan
          </h2>
          <div class="w-16 h-1 bg-brand-emerald mx-auto rounded-full mt-3"></div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
          <!-- Left Column: The Timeline & Detailed History (lg:col-span-8) -->
          <div class="lg:col-span-8 space-y-8" data-aos="fade-up">
            <!-- Bismillahirrahmanirrahim Block -->
            <div class="bg-white p-7 sm:p-9 rounded-3xl shadow-soft border border-slate-200/80 text-center relative overflow-hidden font-sans">
              <div class="absolute top-0 left-0 w-full h-1.5 bg-gradient-to-r from-brand-emerald via-teal-500 to-brand-gold"></div>
              <p class="font-serif italic text-lg sm:text-xl text-brand-emerald font-bold mb-3">
                Bismillahirrahmanirrahim
              </p>
              <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-sans">
                Segala puji bagi Allah SWT, Dzat Yang Maha Memberikan petunjuk, pertolongan, serta membuka jalan bagi setiap perjuangan yang diniatkan demi mencari ridha-Nya. Shalawat dan salam semoga senantiasa tercurah kepada junjungan Nabi Muhammad SAW, keluarga beliau, para sahabat, para ulama pewaris nabi, serta seluruh umat yang istiqamah mengikuti jalan beliau hingga akhir zaman.
              </p>
            </div>

            <!-- Timeline -->
            <div class="relative pl-6 sm:pl-8 border-l-2 border-brand-mint space-y-8 sm:space-y-10 ml-2">
              <!-- Timeline Item 1 -->
              <div class="relative" data-aos="fade-up" data-aos-delay="100">
                <!-- Timeline dot -->
                <div class="absolute -left-[35px] sm:-left-[43px] top-1 w-7 h-7 rounded-full bg-brand-emerald flex items-center justify-center text-white ring-4 ring-white shadow-xs">
                  <span class="material-symbols-outlined text-sm font-bold">assignment</span>
                </div>
                <div>
                  <span class="badge-pill bg-brand-mint text-brand-emeraldDark font-semibold text-xs mb-2 font-sans">
                    Amanah Awal (Kudus Kulon)
                  </span>
                  <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2 font-sans">
                    Dawuh Romo KH. Umar Bachruddin
                  </h3>
                  <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-sans">
                    Berdirinya Yayasan Pendidikan Pesantren Sunan Kudus (YP2SK) lahir melalui perjalanan panjang penuh restu. Awal mula perjuangan ini berakar dari dawuh <strong>Romo Kyai Haji Umar Bachruddin</strong> (Tanjung Karang, Jati, Kudus) kepada <strong>Robby Yassin Abdullah</strong> (bin Haji Zaenal Arifin bin Watono Wakilun bin Kyai Raden Prawiro) untuk mendirikan pondok pesantren dan lembaga pendidikan di wilayah Kudus Kulon. Amanah tersebut diterima dengan penuh takzim untuk berkhidmah kepada agama, bangsa, dan masyarakat.
                  </p>
                </div>
              </div>

              <!-- Timeline Item 2 -->
              <div class="relative" data-aos="fade-up" data-aos-delay="150">
                <!-- Timeline dot -->
                <div class="absolute -left-[35px] sm:-left-[43px] top-1 w-7 h-7 rounded-full bg-brand-emerald flex items-center justify-center text-white ring-4 ring-white shadow-xs">
                  <span class="material-symbols-outlined text-sm font-bold">check_circle</span>
                </div>
                <div>
                  <span class="badge-pill bg-brand-mint text-brand-emeraldDark font-semibold text-xs mb-2 font-sans">
                    Peneguhan Niat
                  </span>
                  <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2 font-sans">
                    Petunjuk &amp; Doa Para Sesepuh
                  </h3>
                  <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-sans">
                    Niat mulia tersebut semakin diperkuat dengan nasihat dan doa dari <strong>Romo Kyai Haji Shiddiq</strong> (Piji, Dawe, Kudus) serta <strong>Mbah Shiddiq</strong> (Ngemplak, Undaan, Kudus). Petunjuk dari para sesepuh ini meneguhkan tekad untuk menghadirkan sebuah lembaga pendidikan yang mampu melahirkan generasi berilmu, berakhlakul karimah, mencintai Al-Qur’an, dan istiqamah dalam ajaran Islam Ahlussunnah wal Jamaah.
                  </p>
                </div>
              </div>

              <!-- Timeline Item 3 -->
              <div class="relative" data-aos="fade-up" data-aos-delay="200">
                <!-- Timeline dot -->
                <div class="absolute -left-[35px] sm:-left-[43px] top-1 w-7 h-7 rounded-full bg-brand-emerald flex items-center justify-center text-white ring-4 ring-white shadow-xs">
                  <span class="material-symbols-outlined text-sm font-bold">volunteer_activism</span>
                </div>
                <div>
                  <span class="badge-pill bg-brand-mint text-brand-emeraldDark font-semibold text-xs mb-2 font-sans">
                    Dukungan Ulama Kharismatik
                  </span>
                  <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2 font-sans">
                    Restu KH. Sahal Mahfudz &amp; Habib Ja'far Al Kaff
                  </h3>
                  <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-sans">
                    Perjuangan memperoleh dorongan spiritual luar biasa dari ulama kharismatik Nusantara, yaitu <strong>Romo Kyai Haji Sahal Mahfudz</strong> (Kajen, Pati) dan <strong>Habib Ja'far Al Kaff</strong> (Kudus). Dukungan dan motivasi beliau berdua memperkuat cita-cita mewujudkan pondok pesantren dan lembaga pendidikan sebagai media dakwah.
                  </p>
                </div>
              </div>

              <!-- Timeline Item 4 -->
              <div class="relative" data-aos="fade-up" data-aos-delay="250">
                <!-- Timeline dot -->
                <div class="absolute -left-[35px] sm:-left-[43px] top-1 w-7 h-7 rounded-full bg-brand-emerald flex items-center justify-center text-white ring-4 ring-white shadow-xs">
                  <span class="material-symbols-outlined text-sm font-bold">menu_book</span>
                </div>
                <div>
                  <span class="badge-pill bg-brand-mint text-brand-emeraldDark font-semibold text-xs mb-2 font-sans">
                    Penamaan Lembaga
                  </span>
                  <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2 font-sans">
                    Restu Nama "Pondok Pesantren Sunan Kudus"
                  </h3>
                  <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-sans">
                    Robby Yassin Abdullah sowan kepada <strong>Romo Kyai Haji Sya’roni Ahmadi Al-Hafidz</strong> didampingi <strong>Haji Sya’roni Anwari</strong> (pengusaha jamu). Atas izin Allah, KH. Sya’roni Ahmadi memberikan nama <strong>“Pondok Pesantren Sunan Kudus”</strong>, yang didukung oleh <strong>Romo Kyai Haji Nursa’di Sunggingan</strong> (cucu Kyai Noor Hadi). Nama ini membawa doa agar lembaga senantiasa meneladani perjuangan dakwah Sunan Kudus yang penuh kebijaksanaan, keluasan ilmu, toleransi, dan keteladanan akhlak.
                  </p>
                </div>
              </div>

              <!-- Timeline Item 5 -->
              <div class="relative" data-aos="fade-up" data-aos-delay="300">
                <!-- Timeline dot -->
                <div class="absolute -left-[35px] sm:-left-[43px] top-1 w-7 h-7 rounded-full bg-brand-emerald flex items-center justify-center text-white ring-4 ring-white shadow-xs">
                  <span class="material-symbols-outlined text-sm font-bold">groups</span>
                </div>
                <div>
                  <span class="badge-pill bg-brand-mint text-brand-emeraldDark font-semibold text-xs mb-2 font-sans">
                    Kolaborasi &amp; Legalitas
                  </span>
                  <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2 font-sans">
                    Dukungan Para Tokoh &amp; Ulama
                  </h3>
                  <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-sans">
                    Pendirian yayasan ini didukung penuh oleh berbagai tokoh penting, antara lain <strong>Kyai Haji Drs. Nadjib Hassan</strong> (Ketua Menara), <strong>Dr. K.H. Mu'tashim Billah, S.Q., M.Pd.I.</strong> (Yogyakarta), <strong>Romo KH. Shofwan</strong> (Jati Wetan), <strong>Romo KH. Qomar</strong> (Sambung), <strong>Dr. H. Sakli Anggoro, M.PAc.</strong>, <strong>Ir. H. Suhartono Soedibyo Putro, M.E.</strong>, <strong>H. Mutamam, Ak., M.Hum.</strong>, dan <strong>Prof. Dr. H. Gunadi, M.Sc., Ak., CPA</strong>. Berkat doa dan kerja bersama, yayasan ini berdiri resmi menaungi lembaga formal dan pesantren Al-Qur'an.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Sticky Media & Quote Sidebar (lg:col-span-4) -->
          <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-24" data-aos="fade-up" data-aos-delay="200">
            <!-- Image Card -->
            <div class="bg-white rounded-3xl p-3 sm:p-4 shadow-soft border border-slate-200/80 overflow-hidden group">
              <div class="relative overflow-hidden rounded-2xl">
                <img
                  class="w-full h-auto transform group-hover:scale-105 transition-transform duration-700 object-cover"
                  alt="Sejarah perkembangan gedung sekolah dan sarana prasarana YP2SK"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuAKTGMe0Do3irW0eWwCcpz1qngx-q-9ZSk8rN-2bIVyhy_8-z-mZ4hBq0mzL3B0-ecKFrW5sQCe5M85igOSMJo7eZ-W3bCB0iIi9bwa6I-KVDMv_T1OgH_Xn37NHdK3hKzN82HfFUpNyE1owO-_uD-bzUh12ofUkC5EAqWVhdzr1BEBd-jt8sKaj7gAzGFseIyxH8fQNhhunAHBRCvKQHtpjK73Gbyk3I8EYyAQgqZa-sK2OSquXe2WBA"
                  loading="lazy"
                />
              </div>
              <div class="p-3 text-center">
                <p class="text-xs text-slate-500 italic font-sans">
                  Pondok Pesantren &amp; Lembaga Pendidikan YP2SK Kudus
                </p>
              </div>
            </div>

            <!-- Quote Block matching Greeting.astro quote styling -->
            <div class="bg-gradient-to-br from-slate-950 via-brand-emeraldDark to-brand-emerald text-white p-7 sm:p-8 rounded-3xl shadow-xl relative overflow-hidden border border-white/10">
              <div class="absolute -right-4 -bottom-6 text-white/5 select-none pointer-events-none font-serif text-[120px] leading-none">
                “
              </div>
              <span class="material-symbols-outlined text-emerald-300 text-3xl block mb-3">format_quote</span>
              <p class="font-serif italic text-white/95 leading-relaxed text-sm sm:text-base mb-4">
                "Pendidikan bukan sekadar transfer ilmu, melainkan proses penanaman nilai-nilai luhur yang akan menjadi kompas kehidupan bagi generasi mendatang."
              </p>
              <div class="w-10 h-0.5 bg-brand-gold mb-3"></div>
              <p class="text-xs font-semibold tracking-wider uppercase text-emerald-200 font-sans">
                Kutipan Esensial
              </p>
            </div>

            <!-- Formal Units Card -->
            <div class="bg-white p-6 sm:p-7 rounded-3xl shadow-soft border border-slate-200/80 space-y-3 font-sans">
              <h4 class="text-base sm:text-lg font-bold text-slate-900 font-sans">
                Unit Pendidikan Kami
              </h4>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans">
                Didirikan dengan semangat pengabdian sosial dan keagamaan, YP2SK menaungi beberapa unit pendidikan sejak usia dini:
              </p>
              <ul class="space-y-2.5 pt-2">
                <li class="flex items-center gap-3">
                  <span class="w-2.5 h-2.5 rounded-full bg-brand-emerald shrink-0"></span>
                  <span class="text-xs sm:text-sm text-slate-800 font-medium font-sans">TPA - KB DINADO</span>
                </li>
                <li class="flex items-center gap-3">
                  <span class="w-2.5 h-2.5 rounded-full bg-brand-emerald shrink-0"></span>
                  <span class="text-xs sm:text-sm text-slate-800 font-medium font-sans">TK DINADO</span>
                </li>
                <li class="flex items-center gap-3">
                  <span class="w-2.5 h-2.5 rounded-full bg-brand-emerald shrink-0"></span>
                  <span class="text-xs sm:text-sm text-slate-800 font-medium font-sans">TPA KB Naneymi</span>
                </li>
                <li class="flex items-center gap-3">
                  <span class="w-2.5 h-2.5 rounded-full bg-brand-emerald shrink-0"></span>
                  <span class="text-xs sm:text-sm text-slate-800 font-medium font-sans">Graha Autis (Therapy Anak Berkebutuhan Khusus)</span>
                </li>
                <li class="flex items-center gap-3">
                  <span class="w-2.5 h-2.5 rounded-full bg-brand-emerald shrink-0"></span>
                  <span class="text-xs sm:text-sm text-slate-800 font-medium font-sans">KB Naneymi AUTIS</span>
                </li>
                <li class="flex items-center gap-3">
                  <span class="w-2.5 h-2.5 rounded-full bg-brand-emerald shrink-0"></span>
                  <span class="text-xs sm:text-sm text-slate-800 font-medium font-sans">Ponpes Tahfidz Al Qur'an AUTIS anak-anak Putra</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Struktur Organisasi / Pimpinan (Styled matching Greeting.astro) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 scroll-mt-24" id="struktur">
      <div class="max-w-3xl mx-auto text-center font-sans mb-12" data-aos="fade-up">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-900 tracking-tight font-sans">
          Struktur Kepemimpinan
        </h2>
        <div class="w-16 h-1 bg-brand-emerald mx-auto rounded-full mt-3"></div>
      </div>

      <div
        class="max-w-4xl mx-auto bg-gradient-to-br from-slate-50 via-brand-iceBlue/30 to-brand-mint/30 rounded-3xl p-8 sm:p-12 lg:p-14 border border-slate-200/80 shadow-soft relative overflow-hidden font-sans"
        data-aos="fade-up"
      >
        <!-- Decorative Quote Background Watermark -->
        <div class="absolute -right-8 -bottom-10 text-brand-emerald/5 select-none pointer-events-none font-serif text-[180px] leading-none">
          “
        </div>

        <div class="space-y-6 relative z-10 font-sans">
          <div class="w-12 h-12 rounded-2xl bg-brand-emerald/10 text-brand-emerald flex items-center justify-center mb-2">
            <span class="material-symbols-outlined text-3xl">format_quote</span>
          </div>

          <div>
            <span class="badge-pill bg-brand-iceBlue text-brand-emerald border border-brand-mint font-sans mb-2 inline-flex">
              Pesan dari Ketua Yayasan
