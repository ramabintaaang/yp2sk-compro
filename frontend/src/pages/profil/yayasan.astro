---
import Layout from "../../layouts/Layout.astro";

const profileSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://yp2sk.or.id/profil/yayasan#webpage",
      url: "https://yp2sk.or.id/profil/yayasan",
      name: "Profil Yayasan | YP2SK",
      description:
        "Profil lengkap Yayasan Pendidikan Pesantren Sunan Kudus (YP2SK) - sejarah, nilai dasar, kepemimpinan, dan komitmen kami.",
      breadcrumb: {
        "@id": "https://yp2sk.or.id/profil/yayasan/#breadcrumb",
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://yp2sk.or.id/profil/yayasan/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Beranda",
          item: "https://yp2sk.or.id",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Profil Yayasan",
          item: "https://yp2sk.or.id/profil/yayasan",
        },
      ],
    },
  ],
};
---

<Layout
  title="Profil Yayasan | YP2SK - Yayasan Pendidikan Pesantren Sunan Kudus"
  description="Dedikasi tak henti dalam membangun generasi unggul yang berakhlak mulia, cerdas, dan mandiri melalui pendidikan berkelanjutan di YP2SK."
  schema={profileSchema}
>
  <div class="pt-20">
    <!-- Hero Section -->
    <section
      class="relative h-[60vh] min-h-[500px] flex items-center justify-center overflow-hidden"
    >
      <div class="absolute inset-0 z-0">
        <div
          class="w-full h-full bg-cover bg-center"
          style="background-image: linear-gradient(rgba(0, 32, 69, 0.85), rgba(0, 32, 69, 0.7)), url('https://lh3.googleusercontent.com/aida-public/AB6AXuCavFC-99FADJK6mO15qdRLjoreFX-FK3DeOp-_BK11xqeikKtizE4CjRMes2HaSlT6lx-2Yl_6SF53rsp0awfSaGCJ_Yw1xg-jEwYgrEiUN4d29JRAEZ8jF2iBGfZceSjU6rQrSR-0aoc9vP060egOHlfluZTT0I1VU-IECfDv87L0YYmQ_Cv0qKeVfJSoQJYcJfve44NMj6h3ldF3T9lG1XF1vg4KBpuLs-10nqCanmN97hm9jfmyjg');"
          role="img"
          aria-label="Prestigious school campus at sunrise representing YP2SK foundation"
        >
        </div>
      </div>
      <div
        class="relative z-10 text-center text-on-primary px-margin-mobile md:px-margin-desktop"
      >
        <span
          class="inline-block px-4 py-1.5 bg-secondary text-on-secondary rounded-full font-label-lg text-label-lg mb-sm uppercase tracking-widest shadow-sm"
          >Tentang Kami</span
        >
        <h1
          class="font-headline-xl text-headline-xl-mobile md:text-headline-xl max-w-3xl mx-auto mb-md text-white"
        >
          Profil Yayasan
        </h1>
        <p
          class="font-body-lg text-body-lg max-w-2xl mx-auto text-on-primary/95 leading-relaxed"
        >
          Dedikasi tak henti dalam membangun generasi unggul yang berakhlak
          mulia, cerdas, dan mandiri melalui pendidikan berkelanjutan.
        </p>
      </div>
    </section>

    <!-- Nilai-Nilai Dasar (Bento Grid Style) -->
    <section
      class="py-xl px-margin-mobile md:px-margin-desktop max-w-[1140px] mx-auto scroll-mt-24"
      id="nilai-nilai"
    >
      <div class="text-center mb-xl reveal-element">
        <h2 class="font-headline-lg text-headline-lg text-primary mb-xs">
          Nilai-Nilai Dasar Kami
        </h2>
        <div class="w-16 h-1 bg-secondary mx-auto rounded-full"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
        <!-- Amanah -->
        <div
          class="bg-white p-lg rounded-xl shadow-sm border border-outline-variant/20 border-b-4 border-b-primary group hover:shadow-md transition-all duration-300 transform hover:-translate-y-1 reveal-element"
        >
          <div
            class="w-12 h-12 bg-primary-fixed flex items-center justify-center rounded-lg mb-md text-primary group-hover:bg-primary group-hover:text-white transition-colors"
          >
            <span class="material-symbols-outlined text-3xl">verified_user</span
            >
          </div>
          <h3 class="font-headline-md text-headline-md text-primary mb-sm">
            Amanah
          </h3>
          <p class="text-on-surface-variant font-body-md">
            Menjaga kepercayaan masyarakat dan stakeholder dengan integritas
            tinggi dan transparansi dalam setiap aspek pengelolaan yayasan.
          </p>
        </div>
        <!-- Tumbuh -->
        <div
          class="bg-white p-lg rounded-xl shadow-sm border border-outline-variant/20 border-b-4 border-b-secondary group hover:shadow-md transition-all duration-300 transform hover:-translate-y-1 reveal-element"
        >
          <div
            class="w-12 h-12 bg-secondary-container flex items-center justify-center rounded-lg mb-md text-secondary group-hover:bg-secondary group-hover:text-white transition-colors"
          >
            <span class="material-symbols-outlined text-3xl">trending_up</span>
          </div>
          <h3 class="font-headline-md text-headline-md text-secondary mb-sm">
            Tumbuh
          </h3>
          <p class="text-on-surface-variant font-body-md">
            Terus berkembang secara berkelanjutan, inovatif, dan adaptif
            terhadap perubahan zaman guna memberikan layanan pendidikan terbaik.
          </p>
        </div>
        <!-- Unggul -->
        <div
          class="bg-white p-lg rounded-xl shadow-sm border border-outline-variant/20 border-b-4 border-b-on-tertiary-container group hover:shadow-md transition-all duration-300 transform hover:-translate-y-1 reveal-element"
        >
          <div
            class="w-12 h-12 bg-tertiary-fixed flex items-center justify-center rounded-lg mb-md text-on-tertiary-container group-hover:bg-on-tertiary-container group-hover:text-white transition-colors"
          >
            <span class="material-symbols-outlined text-3xl"
              >workspace_premium</span
            >
          </div>
          <h3
            class="font-headline-md text-headline-md text-on-tertiary-container mb-sm"
          >
            Unggul
          </h3>
          <p class="text-on-surface-variant font-body-md">
            Berkomitmen pada kualitas pendidikan yang melampaui standar,
            mencetak lulusan yang kompetitif dan berkarakter kuat.
          </p>
        </div>
      </div>
    </section>

    <!-- Sejarah Yayasan -->
    <section class="py-xl bg-surface-container-low scroll-mt-24" id="sejarah">
      <div class="max-w-[1140px] mx-auto px-margin-mobile md:px-margin-desktop">
        <!-- Section Title -->
        <div class="text-center mb-xl reveal-element">
          <span
            class="text-secondary font-label-lg uppercase tracking-widest block mb-xs"
            >Jejak Langkah</span
          >
          <h2 class="font-headline-lg text-headline-lg text-primary mb-xs">
            Sejarah Berdirinya Yayasan
          </h2>
          <div class="w-16 h-1 bg-secondary mx-auto rounded-full"></div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-xl items-start">
          <!-- Left Column: The Timeline & Detailed History (lg:col-span-8) -->
          <div class="lg:col-span-8 space-y-lg reveal-element">
            <!-- Bismillahirrahmanirrahim Block -->
            <div
              class="bg-white p-lg rounded-2xl shadow-sm border border-outline-variant/30 text-center relative overflow-hidden"
            >
              <div class="absolute top-0 left-0 w-full h-1.5 bg-secondary">
              </div>
              <p class="font-headline-md text-primary italic mb-sm">
                Bismillahirrahmanirrahim
              </p>
              <p class="font-body-md text-on-surface-variant leading-relaxed">
                Segala puji bagi Allah SWT, Dzat Yang Maha Memberikan petunjuk,
                pertolongan, serta membuka jalan bagi setiap perjuangan yang
                diniatkan demi mencari ridha-Nya. Shalawat dan salam semoga
                senantiasa tercurah kepada junjungan Nabi Muhammad SAW, keluarga
                beliau, para sahabat, para ulama pewaris nabi, serta seluruh
                umat yang istiqamah mengikuti jalan beliau hingga akhir zaman.
              </p>
            </div>

            <!-- Timeline -->
            <div
              class="relative pl-6 md:pl-8 border-l-2 border-secondary/20 space-y-xl ml-2"
            >
              <!-- Timeline Item 1 -->
              <div class="relative">
                <!-- Timeline dot -->
                <div
                  class="absolute -left-[35px] md:-left-[43px] top-1.5 w-6 h-6 rounded-full bg-secondary flex items-center justify-center text-white ring-4 ring-white shadow-sm"
                >
                  <span class="material-symbols-outlined text-sm font-bold"
                    >assignment</span
                  >
                </div>
                <div>
                  <span
                    class="inline-block px-3 py-1 bg-secondary-container text-on-secondary-container rounded-full font-label-md text-body-sm font-semibold mb-xs"
                    >Amanah Awal (Kudus Kulon)</span
                  >
                  <h3 class="font-headline-md text-primary mb-xs">
                    Dawuh Romo KH. Umar Bachruddin
                  </h3>
                  <p
                    class="font-body-md text-on-surface-variant leading-relaxed"
                  >
                    Berdirinya Yayasan Pendidikan Pesantren Sunan Kudus (YP2SK)
                    lahir melalui perjalanan panjang penuh restu. Awal mula
                    perjuangan ini berakar dari dawuh **Romo Kyai Haji Umar
                    Bachruddin** (Tanjung Karang, Jati, Kudus) kepada **Robby
                    Yassin Abdullah** (bin Haji Zaenal Arifin bin Watono Wakilun
                    bin Kyai Raden Prawiro) untuk mendirikan pondok pesantren
                    dan lembaga pendidikan di wilayah Kudus Kulon. Amanah
                    tersebut diterima dengan penuh takzim untuk berkhidmah
                    kepada agama, bangsa, dan masyarakat.
                  </p>
                </div>
              </div>

              <!-- Timeline Item 2 -->
              <div class="relative">
                <!-- Timeline dot -->
                <div
                  class="absolute -left-[35px] md:-left-[43px] top-1.5 w-6 h-6 rounded-full bg-secondary flex items-center justify-center text-white ring-4 ring-white shadow-sm"
                >
                  <span class="material-symbols-outlined text-sm font-bold"
                    >check_circle</span
                  >
                </div>
                <div>
                  <span
                    class="inline-block px-3 py-1 bg-secondary-container text-on-secondary-container rounded-full font-label-md text-body-sm font-semibold mb-xs"
                    >Peneguhan Niat</span
                  >
                  <h3 class="font-headline-md text-primary mb-xs">
                    Petunjuk & Doa Para Sesepuh
                  </h3>
                  <p
                    class="font-body-md text-on-surface-variant leading-relaxed"
                  >
                    Niat mulia tersebut semakin diperkuat dengan nasihat dan doa
                    dari **Romo Kyai Haji Shiddiq** (Piji, Dawe, Kudus) serta
                    **Mbah Shiddiq** (Ngemplak, Undaan, Kudus). Petunjuk dari
                    para sesepuh ini meneguhkan tekad untuk menghadirkan sebuah
                    lembaga pendidikan yang mampu melahirkan generasi berilmu,
                    berakhlakul karimah, mencintai Al-Qur’an, dan istiqamah
                    dalam ajaran Islam Ahlussunnah wal Jamaah.
                  </p>
                </div>
              </div>

              <!-- Timeline Item 3 -->
              <div class="relative">
                <!-- Timeline dot -->
                <div
                  class="absolute -left-[35px] md:-left-[43px] top-1.5 w-6 h-6 rounded-full bg-secondary flex items-center justify-center text-white ring-4 ring-white shadow-sm"
                >
                  <span class="material-symbols-outlined text-sm font-bold"
                    >volunteer_activism</span
                  >
                </div>
                <div>
                  <span
                    class="inline-block px-3 py-1 bg-secondary-container text-on-secondary-container rounded-full font-label-md text-body-sm font-semibold mb-xs"
                    >Dukungan Ulama Kharismatik</span
                  >
                  <h3 class="font-headline-md text-primary mb-xs">
                    Restu KH. Sahal Mahfudz & Habib Ja'far Al Kaff
                  </h3>
                  <p
                    class="font-body-md text-on-surface-variant leading-relaxed"
                  >
                    Perjuangan memperoleh dorongan spiritual luar biasa dari
                    ulama kharismatik Nusantara, yaitu **Romo Kyai Haji Sahal
                    Mahfudz** (Kajen, Pati) dan **Habib Ja'far Al Kaff**
                    (Kudus). Dukungan dan motivasi beliau berdua memperkuat
                    cita-cita mewujudkan pondok pesantren dan lembaga pendidikan
                    sebagai media dakwah.
                  </p>
                </div>
              </div>

              <!-- Timeline Item 4 -->
              <div class="relative">
                <!-- Timeline dot -->
                <div
                  class="absolute -left-[35px] md:-left-[43px] top-1.5 w-6 h-6 rounded-full bg-secondary flex items-center justify-center text-white ring-4 ring-white shadow-sm"
                >
                  <span class="material-symbols-outlined text-sm font-bold"
                    >menu_book</span
                  >
                </div>
                <div>
                  <span
                    class="inline-block px-3 py-1 bg-secondary-container text-on-secondary-container rounded-full font-label-md text-body-sm font-semibold mb-xs"
                    >Penamaan Lembaga</span
                  >
                  <h3 class="font-headline-md text-primary mb-xs">
                    Restu Nama "Pondok Pesantren Sunan Kudus"
                  </h3>
                  <p
                    class="font-body-md text-on-surface-variant leading-relaxed"
                  >
                    Robby Yassin Abdullah sowan kepada **Romo Kyai Haji Sya’roni
                    Ahmadi Al-Hafidz** didampingi **Haji Sya’roni Anwari**
                    (pengusaha jamu). Atas izin Allah, KH. Sya’roni Ahmadi
                    memberikan nama **“Pondok Pesantren Sunan Kudus”**, yang
                    didukung oleh **Romo Kyai Haji Nursa’di Sunggingan** (cucu
                    Kyai Noor Hadi). Nama ini membawa doa agar lembaga
                    senantiasa meneladani perjuangan dakwah Sunan Kudus yang
                    penuh kebijaksanaan, keluasan ilmu, toleransi, dan
                    keteladanan akhlak.
                  </p>
                </div>
              </div>

              <!-- Timeline Item 5 -->
              <div class="relative">
                <!-- Timeline dot -->
                <div
                  class="absolute -left-[35px] md:-left-[43px] top-1.5 w-6 h-6 rounded-full bg-secondary flex items-center justify-center text-white ring-4 ring-white shadow-sm"
                >
                  <span class="material-symbols-outlined text-sm font-bold"
                    >groups</span
                  >
                </div>
                <div>
                  <span
                    class="inline-block px-3 py-1 bg-secondary-container text-on-secondary-container rounded-full font-label-md text-body-sm font-semibold mb-xs"
                    >Kolaborasi & Legalitas</span
                  >
                  <h3 class="font-headline-md text-primary mb-xs">
                    Dukungan Para Tokoh & Ulama
                  </h3>
                  <p
                    class="font-body-md text-on-surface-variant leading-relaxed"
                  >
                    Pendirian yayasan ini didukung penuh oleh berbagai tokoh
                    penting, antara lain **Kyai Haji Drs. Nadjib Hassan** (Ketua
                    Menara), **Dr. K.H. Mu'tashim Billah, S.Q., M.Pd.I.**
                    (Yogyakarta), **Romo KH. Shofwan** (Jati Wetan), **Romo KH.
                    Qomar** (Sambung), **Dr. H. Sakli Anggoro, M.PAc.**, **Ir.
                    H. Suhartono Soedibyo Putro, M.E.**, **H. Mutamam, Ak.,
                    M.Hum.**, dan **Prof. Dr. H. Gunadi, M.Sc., Ak., CPA**.
                    Berkat doa dan kerja bersama, yayasan ini berdiri resmi
                    menaungi lembaga formal dan pesantren Al-Qur'an.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Sticky Media & Quote Sidebar (lg:col-span-4) -->
          <div
            class="lg:col-span-4 space-y-md lg:sticky lg:top-24 reveal-element"
          >
            <!-- Image Card -->
            <div
              class="bg-white rounded-2xl p-sm shadow-sm border border-outline-variant/30 overflow-hidden group"
            >
              <div class="relative overflow-hidden rounded-xl">
                <img
                  class="w-full h-auto transform group-hover:scale-105 transition-transform duration-700 object-cover"
                  alt="Sejarah perkembangan gedung sekolah dan sarana prasarana YP2SK"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuAKTGMe0Do3irW0eWwCcpz1qngx-q-9ZSk8rN-2bIVyhy_8-z-mZ4hBq0mzL3B0-ecKFrW5sQCe5M85igOSMJo7eZ-W3bCB0iIi9bwa6I-KVDMv_T1OgH_Xn37NHdK3hKzN82HfFUpNyE1owO-_uD-bzUh12ofUkC5EAqWVhdzr1BEBd-jt8sKaj7gAzGFseIyxH8fQNhhunAHBRCvKQHtpjK73Gbyk3I8EYyAQgqZa-sK2OSquXe2WBA"
                />
              </div>
              <div class="p-sm text-center">
                <p
                  class="font-label-md text-body-sm text-on-surface-variant italic"
                >
                  Pondok Pesantren & Lembaga Pendidikan YP2SK Kudus
                </p>
              </div>
            </div>

            <!-- Quote Block -->
            <div
              class="bg-primary text-on-primary p-lg rounded-2xl shadow-sm relative overflow-hidden"
            >
              <div class="absolute -right-6 -bottom-6 opacity-10">
                <span class="material-symbols-outlined text-[120px]"
                  >format_quote</span
                >
              </div>
              <span
                class="material-symbols-outlined text-secondary text-4xl block mb-xs"
                >format_quote</span
              >
              <p
                class="font-headline-md italic text-white/95 leading-relaxed mb-sm"
              >
                "Pendidikan bukan sekadar transfer ilmu, melainkan proses
                penanaman nilai-nilai luhur yang akan menjadi kompas kehidupan
                bagi generasi mendatang."
              </p>
              <div class="w-10 h-0.5 bg-secondary mb-sm"></div>
              <p
                class="font-label-md text-body-sm font-semibold tracking-wider uppercase text-secondary-container"
              >
                Kutipan Esensial
              </p>
            </div>

            <!-- Formal Units Card -->
            <div
              class="bg-white p-lg rounded-2xl shadow-sm border border-outline-variant/30 space-y-sm"
            >
              <h4 class="font-headline-md text-primary text-lg">
                Unit Pendidikan Kami
              </h4>
              <p
                class="font-body-md text-on-surface-variant text-body-sm leading-relaxed"
              >
                Didirikan dengan semangat pengabdian sosial dan keagamaan, YP2SK
                menaungi beberapa unit pendidikan sejak usia dini:
              </p>
              <ul class="space-y-xs pt-xs">
                <li class="flex items-center gap-sm">
                  <span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
                  <span
                    class="font-body-md text-on-surface text-body-sm font-medium"
                    >TPA - KB DINADO</span
                  >
                </li>
                <li class="flex items-center gap-sm">
                  <span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
                  <span
                    class="font-body-md text-on-surface text-body-sm font-medium"
                    >TK DINADO</span
                  >
                </li>
                <li class="flex items-center gap-sm">
                  <span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
                  <span
                    class="font-body-md text-on-surface text-body-sm font-medium"
                    >TPA KB Naneymi</span
                  >
                </li>
                <li class="flex items-center gap-sm">
                  <span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
                  <span
                    class="font-body-md text-on-surface text-body-sm font-medium"
                    >Graha Autis (Therapy Anak Berkebutuhan Khusus)</span
                  >
                </li>
                <li class="flex items-center gap-sm">
                  <span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
                  <span
                    class="font-body-md text-on-surface text-body-sm font-medium"
                    >KB Naneymi AUTIS</span
                  >
                </li>
                <li class="flex items-center gap-sm">
                  <span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
                  <span
                    class="font-body-md text-on-surface text-body-sm font-medium"
                    >Ponpes Tahfidz Al Qur'an AUTIS anak-anak Putra</span
                  >
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Struktur Organisasi / Pimpinan -->
    <section
      class="py-xl px-margin-mobile md:px-margin-desktop max-w-[1140px] mx-auto scroll-mt-24"
      id="struktur"
    >
      <div class="text-center mb-xl reveal-element">
        <h2 class="font-headline-lg text-headline-lg text-primary mb-xs">
          Struktur Kepemimpinan
        </h2>
        <div class="w-16 h-1 bg-secondary mx-auto rounded-full"></div>
      </div>
      <div
        class="flex flex-col md:flex-row items-center gap-xl bg-white p-lg md:p-xl rounded-2xl shadow-sm border border-outline-variant/30 reveal-element"
      >
        <div class="w-full md:w-2/5">
          <img
            class="w-full rounded-xl shadow-md border-4 border-white object-cover aspect-[4/5] md:aspect-[3/4]"
            alt="Foto Ketua Yayasan YP2SK - Robby Yassin Abdullah"
            src="/ketua_yayasan.png"
          />
        </div>
        <div class="w-full md:w-3/5">
          <span
            class="text-secondary font-label-lg uppercase tracking-widest block mb-xs"
            >Pesan dari Ketua Yayasan</span
          >
          <h3 class="font-headline-md text-headline-md text-primary mb-md">
            Membangun Masa Depan Berlandaskan Amanah
          </h3>
          <p class="text-on-surface-variant font-body-md leading-relaxed mb-md">
            "Kami percaya bahwa setiap anak memiliki potensi yang luar biasa. Di
            YP2SK, tugas kami adalah menyediakan ekosistem yang tepat agar
            potensi tersebut dapat tumbuh dan mekar dengan sempurna. Dengan
            semangat Amanah, Tumbuh, and Unggul, kami mengundang Bapak/Ibu untuk
            menjadi bagian dari perjalanan transformatif ini."
          </p>
          <div class="border-t border-outline-variant pt-md">
            <p class="font-bold text-primary font-body-lg">
              Robby Yassin Abdullah
            </p>
            <p class="text-on-surface-variant text-body-sm italic">
              Ketua Yayasan Pendidikan Pesantren Sunan Kudus (YP2SK)
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="py-xl bg-primary relative overflow-hidden">
      <!-- Animated background simulation -->
      <div class="absolute inset-0 opacity-10">
        <div
          class="w-full h-full bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-secondary-fixed via-transparent to-transparent animate-pulse"
        >
        </div>
      </div>
      <div
        class="relative z-10 max-w-[800px] mx-auto text-center px-margin-mobile text-on-primary"
      >
        <h2
          class="font-headline-lg text-headline-lg-mobile md:text-headline-lg mb-md text-white"
        >
          Siap Memulai Langkah Menuju Masa Depan Unggul?
        </h2>
