---
import Layout from "../../layouts/Layout.astro";

const profileSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Beranda",
      item: "https://yp2sk.or.id",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Profil Visi & Misi",
      item: "https://yp2sk.or.id/profil/visi-misi",
    },
  ],
};
---

<Layout
  title="Visi & Misi | YP2SK - Yayasan Pendidikan Pesantren Sunan Kudus"
  description="Ketahui visi utama dan misi strategis YP2SK (Yayasan Pendidikan Pesantren Sunan Kudus) dalam membina akhlak mulia, kemandirian, dan prestasi akademik santri didik."
  schema={profileSchema}
>
  <!-- Floating Vector Ribbon Line matching yayasan.astro & index.astro -->
  <div aria-hidden="true" class="curved-line-bg">
    <svg class="w-full h-full opacity-35" fill="none" preserveAspectRatio="none" viewBox="0 0 1440 4800">
      <path d="M720,200 C1100,500 1200,900 850,1300 C500,1700 200,2000 550,2500 C900,3000 1250,3300 950,3800 C700,4200 400,4500 720,4800" stroke="#8BBB92" stroke-dasharray="8 8" stroke-width="2.5"></path>
    </svg>
  </div>

  <div class="relative z-10 font-sans">
    <!-- Hero Section (Cinematic Panoramic Banner with Overlapping Profile Card matching yayasan.astro) -->
    <section class="relative font-sans pb-6 sm:pb-10">
      <!-- Panoramic Banner -->
      <div class="relative w-full h-[320px] sm:h-[380px] lg:h-[420px] overflow-hidden bg-slate-950">
        <img
          src="https://images.unsplash.com/photo-1523050854058-8df90110c9f1?q=80&w=1200&auto=format&fit=crop"
          alt="Kepemimpinan YP2SK"
          class="w-full h-full object-cover object-center opacity-80"
          loading="eager"
        />
        <!-- Atmospheric Vignette & Gradient Overlays -->
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/35 to-brand-emeraldDark/25"></div>
      </div>

      <!-- Overlapping Profile Header Card -->
      <div class="max-w-4xl mx-auto px-4 sm:px-6 -mt-20 sm:-mt-24 lg:-mt-28 relative z-20" data-aos="fade-up">
        <div class="bg-white/95 backdrop-blur-md rounded-3xl p-8 sm:p-12 shadow-soft border border-slate-200/90 text-center">
          <div class="flex flex-wrap items-center justify-center gap-2 mb-4">
            <span class="badge-pill bg-brand-iceBlue text-brand-emerald border border-brand-mint font-sans inline-flex">
              Tentang Kami
            </span>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200/80 text-brand-emerald text-xs font-semibold">
              <span class="material-symbols-outlined text-[15px] font-bold">verified</span>
              <span>25+ Tahun Pengabdian</span>
            </div>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-slate-900 leading-tight font-sans">
            Membangun Generasi <br class="hidden sm:inline" />
            <span class="italic text-brand-emerald font-serif font-normal">Berkarakter &amp; Unggul</span>
          </h1>

          <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed font-sans font-normal">
            Yayasan Pendidikan Pesantren Sunan Kudus (YP2SK) berkomitmen penuh dalam mencetak insan yang berakhlak mulia, cerdas, dan mandiri melalui pendekatan pendidikan yang holistik dan modern.
          </p>

          <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            <a
              href="#visi-section"
              class="px-6 py-3 rounded-full bg-brand-emerald text-white hover:bg-brand-emeraldDark font-bold text-xs sm:text-sm shadow-md transition transform hover:-translate-y-0.5"
            >
              Lihat Visi &amp; Misi
            </a>
            <a
              href="#"
              class="px-6 py-3 rounded-full bg-white text-slate-800 hover:bg-slate-50 border border-slate-200 font-semibold text-xs sm:text-sm shadow-xs transition"
            >
              Hubungi Kami
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Visi Section (Styled matching yayasan.astro Greeting / Leadership Quote Card) -->
    <section id="visi-section" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 scroll-mt-24">
      <div class="max-w-3xl mx-auto text-center font-sans mb-12" data-aos="fade-up">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-900 tracking-tight font-sans">
          Visi Utama Kami
        </h2>
        <div class="w-16 h-1 bg-brand-emerald mx-auto rounded-full mt-3"></div>
      </div>

      <div
        class="max-w-4xl mx-auto bg-gradient-to-br from-slate-50 via-brand-iceBlue/30 to-brand-mint/30 rounded-3xl p-8 sm:p-12 lg:p-14 border border-slate-200/80 shadow-soft relative overflow-hidden font-sans text-center"
        data-aos="fade-up"
      >
        <!-- Decorative Quote Background Watermark -->
        <div class="absolute -right-8 -bottom-10 text-brand-emerald/5 select-none pointer-events-none font-serif text-[180px] leading-none">
          “
        </div>

        <div class="relative z-10 space-y-6">
          <div class="w-12 h-12 rounded-2xl bg-brand-emerald/10 text-brand-emerald flex items-center justify-center mx-auto text-2xl mb-2">
            <span class="material-symbols-outlined text-3xl">format_quote</span>
          </div>

          <!-- Featured Quote Callout -->
          <div class="border-l-4 border-brand-emerald bg-white/80 backdrop-blur-sm p-6 sm:p-8 rounded-r-2xl shadow-xs text-left">
            <h3 class="text-lg sm:text-xl md:text-2xl font-serif italic text-slate-800 leading-relaxed">
              "Menjadi lembaga pendidikan terdepan yang Amanah, Tumbuh, dan Unggul dalam membentuk karakter anak didik yang Islami, Cerdas, dan Berjiwa Mandiri."
            </h3>
          </div>

          <p class="text-xs sm:text-sm font-bold text-brand-emerald uppercase tracking-[0.2em] font-sans">
            — Dewan Pembina YP2SK
          </p>
        </div>
      </div>
    </section>

    <!-- Misi Section (3 Pillars Cards Layout matching yayasan.astro & Pillars.astro) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 scroll-mt-24">
      <div class="max-w-3xl mx-auto text-center font-sans mb-12 sm:mb-16" data-aos="fade-up">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-900 tracking-tight font-sans">
          Misi Strategis
        </h2>
        <div class="w-16 h-1 bg-brand-emerald mx-auto rounded-full mt-3"></div>
        <p class="mt-4 text-sm sm:text-base text-slate-600 leading-relaxed font-sans">
          Langkah nyata yang kami tempuh setiap hari untuk mewujudkan cita-cita luhur yayasan bagi masa depan putra-putri bangsa.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Misi 1 (Soft Ice Blue Card) -->
        <div
          class="bg-brand-iceBlue rounded-3xl p-8 border border-blue-100 flex flex-col justify-between transition transform hover:-translate-y-1 shadow-soft group"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <div>
            <div class="w-12 h-12 rounded-2xl bg-blue-500/10 text-blue-700 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 group-hover:bg-blue-600 group-hover:text-white transition-all">
              <span class="material-symbols-outlined text-2xl" style="font-variation-settings: 'FILL' 1;">school</span>
            </div>
            <h4 class="text-xl font-bold text-slate-900 mb-2 font-sans">
              Kualitas Pengajaran
            </h4>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans">
              Menyelenggarakan pendidikan berkualitas dengan kurikulum yang relevan dan metode pembelajaran yang inovatif untuk memacu kecerdasan intelektual.
            </p>
          </div>
        </div>

        <!-- Misi 2 (Soft Mint Card) -->
        <div
          class="bg-brand-mint rounded-3xl p-8 border border-emerald-100 flex flex-col justify-between transition transform hover:-translate-y-1 shadow-soft group"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <div>
            <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-800 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 group-hover:bg-brand-emerald group-hover:text-white transition-all">
              <span class="material-symbols-outlined text-2xl" style="font-variation-settings: 'FILL' 1;">mosque</span>
            </div>
            <h4 class="text-xl font-bold text-slate-900 mb-2 font-sans">
              Lingkungan Islami
            </h4>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans">
              Membangun ekosistem pendidikan yang kental dengan nilai-nilai islami guna membentuk akhlakul karimah dan karakter religius sejak dini.
            </p>
          </div>
        </div>

        <!-- Misi 3 (Soft Yellow Card) -->
        <div
          class="bg-brand-warmYellow rounded-3xl p-8 border border-amber-100 flex flex-col justify-between transition transform hover:-translate-y-1 shadow-soft group"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <div>
            <div class="w-12 h-12 rounded-2xl bg-amber-500/15 text-amber-900 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 group-hover:bg-amber-600 group-hover:text-white transition-all">
              <span class="material-symbols-outlined text-2xl" style="font-variation-settings: 'FILL' 1;">self_improvement</span>
            </div>
            <h4 class="text-xl font-bold text-slate-900 mb-2 font-sans">
              Kemandirian
            </h4>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans">
              Menanamkan jiwa kemandirian dan rasa percaya diri kepada anak didik agar mampu menjadi individu yang tangguh dan adaptif di masa depan.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats Counter Section (Styled matching dark emerald gradient card in yayasan.astro) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 font-sans" data-aos="fade-up">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-slate-950 via-brand-emeraldDark to-brand-emerald text-white p-8 sm:p-12 shadow-xl border border-white/10">
        <!-- Decorative Watermark & Ambient Glow -->
        <div class="absolute -right-8 -bottom-10 text-white/5 select-none pointer-events-none font-serif text-[140px] leading-none">
          ق
        </div>
        <div class="absolute -top-16 -left-16 w-64 h-64 bg-brand-emerald/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 text-center">
          <div class="space-y-1">
            <p class="text-3xl sm:text-4xl lg:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 via-teal-200 to-amber-200 font-sans">
              5000+
            </p>
            <p class="text-xs sm:text-sm text-slate-200 font-medium font-sans">
              Siswa Terbantu
            </p>
          </div>
          <div class="space-y-1">
            <p class="text-3xl sm:text-4xl lg:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 via-teal-200 to-amber-200 font-sans">
              150+
            </p>
            <p class="text-xs sm:text-sm text-slate-200 font-medium font-sans">
              Tenaga Pendidik
            </p>
          </div>
          <div class="space-y-1">
            <p class="text-3xl sm:text-4xl lg:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 via-teal-200 to-amber-200 font-sans">
              12
            </p>
            <p class="text-xs sm:text-sm text-slate-200 font-medium font-sans">
              Unit Pendidikan
            </p>
          </div>
          <div class="space-y-1">
            <p class="text-3xl sm:text-4xl lg:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 via-teal-200 to-amber-200 font-sans">
              24+
            </p>
            <p class="text-xs sm:text-sm text-slate-200 font-medium font-sans">
              Mitra Strategis
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action (Styled matching PreFooter / CTA in yayasan.astro) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 font-sans" data-aos="fade-up">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-slate-950 via-brand-emeraldDark to-brand-emerald text-white p-8 sm:p-12 shadow-xl border border-white/10 text-center">
        <!-- Decorative Watermark & Ambient Glow -->
        <div class="absolute -right-8 -bottom-10 text-white/5 select-none pointer-events-none font-serif text-[140px] leading-none">
          ق
        </div>
        <div class="absolute -top-16 -left-16 w-64 h-64 bg-brand-emerald/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 max-w-2xl mx-auto space-y-4">
          <h2 class="text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight text-white leading-snug font-sans">
            Bergabung Bersama Kami
          </h2>
          <p class="text-xs sm:text-sm text-slate-200 leading-relaxed font-light">
            Berikan pendidikan terbaik yang membentuk karakter dan masa depan putra-putri Anda bersama YP2SK.
          </p>
          <div class="pt-2 flex justify-center">
            <a
              href="#"
              class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-white text-slate-900 hover:bg-slate-100 font-bold text-xs sm:text-sm shadow-md transition transform hover:-translate-y-0.5 text-center whitespace-nowrap"
            >
              Daftar Sekarang
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
