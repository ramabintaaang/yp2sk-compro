---
import Layout from '../../layouts/Layout.astro';

const profileSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Beranda",
      "item": "https://yp2sk.or.id"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Profil Visi & Misi",
      "item": "https://yp2sk.or.id/profil/visi-misi"
    }
  ]
};
---

<Layout 
  title="Visi & Misi | YP2SK - Yayasan Pendidikan Pesantren Sunan Kudus" 
  description="Ketahui visi utama dan misi strategis YP2SK (Yayasan Pendidikan Pesantren Sunan Kudus) dalam membina akhlak mulia, kemandirian, dan prestasi akademik santri didik."
  schema={profileSchema}
>
  <div class="pt-20">
    <!-- Hero Section -->
    <section class="relative py-xl overflow-hidden">
      <div class="max-w-[1140px] mx-auto px-margin-mobile md:px-0">
        <div class="flex flex-col md:flex-row items-center gap-lg">
          <div class="w-full md:w-1/2 space-y-md">
            <span class="inline-block px-4 py-1.5 bg-secondary-container text-on-secondary-container rounded-full text-label-lg font-bold uppercase tracking-wider">
              Tentang Kami
            </span>
            <h1 class="text-headline-xl-mobile md:text-headline-xl font-headline-xl text-primary leading-tight">
              Membangun Generasi <br />
              <span class="italic text-secondary font-normal">Berkarakter &amp; Unggul</span>
            </h1>
            <p class="text-body-lg text-on-surface-variant max-w-[32rem]">
              Yayasan Pendidikan Pesantren Sunan Kudus (YP2SK) berkomitmen penuh dalam mencetak insan yang berakhlak mulia, cerdas, dan mandiri melalui pendekatan pendidikan yang holistik dan modern.
            </p>
            <div class="flex gap-4 pt-4">
              <a href="#visi-section" class="inline-block bg-primary text-on-primary px-8 py-3 rounded-lg font-label-lg font-bold shadow-lg hover:shadow-xl transition-all">
                Lihat Visi &amp; Misi
              </a>
              <a href="#" class="inline-block border border-primary text-primary px-8 py-3 rounded-lg font-label-lg font-bold hover:bg-primary/5 transition-all">
                Hubungi Kami
              </a>
            </div>
          </div>
          <div class="w-full md:w-1/2 relative group">
            <div class="absolute -inset-4 bg-secondary/10 rounded-2xl -rotate-2 group-hover:rotate-0 transition-transform duration-500"></div>
            <div class="relative overflow-hidden rounded-xl shadow-2xl aspect-[4/3]">
              <img
                alt="Kepemimpinan YP2SK"
                class="w-full h-full object-cover transform transition-transform duration-700 group-hover:scale-105"
                src="https://images.unsplash.com/photo-1523050854058-8df90110c9f1?q=80&w=800&auto=format&fit=crop"
              />
            </div>
            <div class="absolute -bottom-6 -left-6 bg-white p-6 rounded-xl shadow-xl hidden lg:block">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-secondary flex items-center justify-center rounded-full text-on-primary">
                  <span class="material-symbols-outlined">verified</span>
                </div>
                <div>
                  <p class="text-headline-md font-headline-md text-primary m-0 leading-none">25+</p>
                  <p class="text-label-md text-on-surface-variant font-medium">Tahun Pengabdian</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Visi Section (Bento Inspired) -->
    <section id="visi-section" class="scroll-mt-24 py-xl bg-surface-container-low">
      <div class="max-w-[1140px] mx-auto px-margin-mobile md:px-0">
        <div class="text-center mb-lg space-y-2">
          <h2 class="text-headline-lg font-headline-lg text-primary">Visi Utama Kami</h2>
          <div class="w-20 h-1 bg-secondary mx-auto rounded-full"></div>
        </div>
        <div class="bg-white p-lg rounded-2xl shadow-sm border border-outline-variant relative overflow-hidden">
          <div class="absolute top-0 right-0 p-8 text-primary/5">
            <span class="material-symbols-outlined !text-9xl">format_quote</span>
          </div>
          <div class="relative z-10 max-w-3xl mx-auto text-center italic">
            <h3 class="text-headline-md md:text-headline-lg font-headline-md text-primary leading-relaxed">
              "Menjadi lembaga pendidikan terdepan yang Amanah, Tumbuh, dan Unggul dalam membentuk karakter anak didik yang Islami, Cerdas, dan Berjiwa Mandiri."
            </h3>
            <p class="mt-8 text-label-lg font-bold text-secondary uppercase tracking-[0.2em]">
              — Dewan Pembina YP2SK
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Misi Section (Card Layout) -->
    <section class="py-xl">
      <div class="max-w-[1140px] mx-auto px-margin-mobile md:px-0">
        <div class="flex flex-col md:flex-row justify-between items-end mb-lg gap-4">
          <div class="max-w-[36rem]">
            <h2 class="text-headline-lg font-headline-lg text-primary">Misi Strategis</h2>
            <p class="text-body-md text-on-surface-variant mt-2">
              Langkah nyata yang kami tempuh setiap hari untuk mewujudkan cita-cita luhur yayasan bagi masa depan putra-putri bangsa.
            </p>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
          <!-- Misi 1 -->
          <div class="mission-card bg-white p-8 rounded-2xl border border-outline-variant flex flex-col items-start h-full">
            <div class="w-14 h-14 bg-primary-container rounded-xl flex items-center justify-center text-secondary-fixed mb-6">
              <span class="material-symbols-outlined !text-3xl" style="font-variation-settings: 'FILL' 1;">school</span>
            </div>
            <h4 class="text-headline-md font-headline-md text-primary mb-4">Kualitas Pengajaran</h4>
            <p class="text-body-md text-on-surface-variant">
              Menyelenggarakan pendidikan berkualitas dengan kurikulum yang relevan dan metode pembelajaran yang inovatif untuk memacu kecerdasan intelektual.
            </p>
          </div>
          <!-- Misi 2 -->
          <div class="mission-card bg-white p-8 rounded-2xl border border-outline-variant flex flex-col items-start h-full">
            <div class="w-14 h-14 bg-secondary rounded-xl flex items-center justify-center text-on-primary mb-6">
              <span class="material-symbols-outlined !text-3xl" style="font-variation-settings: 'FILL' 1;">mosque</span>
            </div>
            <h4 class="text-headline-md font-headline-md text-primary mb-4">Lingkungan Islami</h4>
            <p class="text-body-md text-on-surface-variant">
              Membangun ekosistem pendidikan yang kental dengan nilai-nilai islami guna membentuk akhlakul karimah dan karakter religius sejak dini.
            </p>
          </div>
          <!-- Misi 3 -->
          <div class="mission-card bg-white p-8 rounded-2xl border border-outline-variant flex flex-col items-start h-full">
            <div class="w-14 h-14 bg-tertiary-container rounded-xl flex items-center justify-center text-tertiary-fixed mb-6">
              <span class="material-symbols-outlined !text-3xl" style="font-variation-settings: 'FILL' 1;">self_improvement</span>
            </div>
            <h4 class="text-headline-md font-headline-md text-primary mb-4">Kemandirian</h4>
            <p class="text-body-md text-on-surface-variant">
              Menanamkan jiwa kemandirian dan rasa percaya diri kepada anak didik agar mampu menjadi individu yang tangguh dan adaptif di masa depan.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats Counter Section -->
    <section class="py-lg bg-primary text-on-primary">
      <div class="max-w-[1140px] mx-auto px-margin-mobile md:px-0 grid grid-cols-2 md:grid-cols-4 gap-gutter text-center">
        <div class="space-y-1">
          <p class="text-headline-xl font-headline-xl text-secondary-fixed">5000+</p>
          <p class="text-label-lg opacity-80">Siswa Terbantu</p>
        </div>
        <div class="space-y-1">
          <p class="text-headline-xl font-headline-xl text-secondary-fixed">150+</p>
          <p class="text-label-lg opacity-80">Tenaga Pendidik</p>
        </div>
        <div class="space-y-1">
          <p class="text-headline-xl font-headline-xl text-secondary-fixed">12</p>
          <p class="text-label-lg opacity-80">Unit Pendidikan</p>
        </div>
        <div class="space-y-1">
          <p class="text-headline-xl font-headline-xl text-secondary-fixed">24+</p>
          <p class="text-label-lg opacity-80">Mitra Strategis</p>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="py-xl">
      <div class="max-w-[1140px] mx-auto px-margin-mobile md:px-0">
        <div class="bg-secondary-container rounded-3xl p-lg md:p-xl flex flex-col md:flex-row items-center justify-between gap-md relative overflow-hidden">
          <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-secondary opacity-10 rounded-full blur-3xl"></div>
          <div class="relative z-10 space-y-4">
            <h2 class="text-headline-lg font-headline-lg text-on-secondary-container">Bergabung Bersama Kami</h2>
            <p class="text-body-lg text-on-secondary-container/80 max-w-[32rem]">
              Berikan pendidikan terbaik yang membentuk karakter dan masa depan putra-putri Anda bersama YP2SK.
            </p>
          </div>
          <div class="relative z-10">
            <a href="#" class="inline-block bg-primary text-on-primary px-10 py-4 rounded-xl font-headline-md shadow-lg hover:scale-105 active:scale-95 transition-all">
              Daftar Sekarang
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .mission-card {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .mission-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 24px -10px rgba(0, 32, 69, 0.15);
  }
</style>

<script>
  function setupScrollAnimation() {
    const observerOptions = {
      threshold: 0.1,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).style.opacity = "1";
          (entry.target as HTMLElement).style.transform = "translateY(0)";
        }
      });
    }, observerOptions);

    document.querySelectorAll(".mission-card").forEach((card) => {
      (card as HTMLElement).style.opacity = "0";
      (card as HTMLElement).style.transform = "translateY(20px)";
      (card as HTMLElement).style.transition = "all 0.6s ease-out";
      observer.observe(card);
    });
  }

  // Setup immediately
  setupScrollAnimation();

  // Re-run animation if user uses client-side routing transitions
  document.addEventListener('astro:after-swap', setupScrollAnimation);
</script>
