    title: "Program Sekolah Hijau",
    category: "Lingkungan",
    categorySlug: "lingkungan",
    desc: "Kegiatan peduli lingkungan melalui program penanaman pohon di kebun sekolah, mengajarkan anak pentingnya melestarikan bumi dan merawat alam sekitar."
  },
  {
    src: "https://lh3.googleusercontent.com/aida-public/AB6AXuDXO_BaFBVv8OOXA8ga4DfSzvFIjz-HU6KBTvF3VIExRDfJVc-ZZTRnV6GFHir50LdbLrJb7Z4oZjw0Lo_gIjl8t_-WpAbn7T2m4SfQV-ud1urVPB634H_yZuhj-oaOEtt-SnwhgOBZhtrZyXw9Vue1-2aqfzNDJkdF_6v_JoKgRWcSRvdAYWWg81Sc0i9zVUS2q5jHOwsHs0z79wOgtn3oOF-_eRfSJatjYni9kiFYgPepQV4g7vToug",
    alt: "A dynamic action shot of children playing sports on a professional blue-surfaced court. The sun is shining brightly, highlighting their energetic movements. The color palette is dominated by Navy and Slate with pops of Emerald. High-speed photography captures clear expressions of joy and determination.",
    title: "Kompetisi Tahunan",
    category: "Olahraga",
    categorySlug: "olahraga",
    desc: "Keseruan turnamen olahraga antarkelas yang melatih sportivitas, daya juang, dan kerja sama tim siswa-siswi YP2SK dalam atmosfer yang kompetitif namun menyenangkan."
  },
  {
    src: "https://lh3.googleusercontent.com/aida-public/AB6AXuDK_RQTMHdjuU9dhsVTmHOXbO1IT6Ms3MRJP2-beNXY9pOuQCbve3uqEiJMEYTIB2xXapzrHEZB5lVqnMQxgaLGHQr9g6Y44I15JVHFcIB594VC_HupuKiXAmpPC_wKCnp3qz2gok-wG05kEfgUMEDwVixYqtS79qQ6f7rxMHV7mBVGxDTusfffgQ46k9GtsAEbZgoC7ehuMn2m3clbhOqRwU0N9Q4tOou6B_GVLsxV8PjHavBURWscKg",
    alt: "Students performing a traditional Indonesian dance on a wooden stage, wearing colorful costumes with gold embroidery. The lighting is dramatic and focused, highlighting the cultural heritage and excellence. The image is sophisticated, editorial in quality, reflecting the 'Unggul' and 'Amanah' spirit.",
    title: "Pentas Seni Akhir Tahun",
    category: "Seni & Budaya",
    categorySlug: "seni-budaya",
    desc: "Ajang apresiasi seni dan budaya akhir tahun ajaran sebagai sarana ekspresi bakat tari tradisional, musik, dan teater nusantara bagi para siswa."
  },
  {
    src: "https://lh3.googleusercontent.com/aida-public/AB6AXuDKDwIlt5yVG6F3r_zIVdJIb84IeyFZ-8bWf5QHFu9wRljUbvDAheu0RFR8xm-teWi6Xu6kYP66umCyfSEUTSQJGRKJGxXl6q0oAQZIFBF30ZNG6ZlOWuVlOxkX1JWqa3d9LCj_a8lZ0CA2hD4t-ED42NFlqU8fvAqyHmzYRiRyjbrX56jMgmMNLYLl6KIt6pSAURQeR-4bO6FyUq748JRu-heBfN1Opkiy9Nhnut1oOt7iCevMoTP-eA",
    alt: "A clean, minimalist laboratory setting where a teacher is demonstrating a science experiment to curious students. Modern equipment, white lab coats, and focused expressions. The lighting is sterile yet inviting, with a palette of clean whites and Navy blue accents, conveying institutional professionalism.",
    title: "Eksperimen Laboratorium",
    category: "Akademik",
    categorySlug: "akademik",
    desc: "Praktikum sains terpadu di laboratorium modern yang lengkap untuk memfasilitasi eksplorasi ilmiah dan pembelajaran kognitif aktif berbasis penemuan."
  }
];

const galleryItems = fallbackGallery;

const galeriSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://yp2sk.or.id/galeri#webpage",
      "url": "https://yp2sk.or.id/galeri",
      "name": "Galeri & Jejak Langkah | YP2SK",
      "description": "Dokumentasi visual kegiatan belajar mengajar, fasilitas sekolah, prestasi olahraga, pentas seni, dan praktikum laboratorium di YP2SK.",
      "breadcrumb": {
        "@id": "https://yp2sk.or.id/galeri/#breadcrumb"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://yp2sk.or.id/galeri/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Beranda",
          "item": "https://yp2sk.or.id"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Galeri & Jejak Langkah",
          "item": "https://yp2sk.or.id/galeri"
        }
      ]
    },
    {
      "@type": "ImageGallery",
      "@id": "https://yp2sk.or.id/galeri#gallery",
      "name": "Galeri Dokumentasi YP2SK",
      "description": "Galeri foto resmi yang menampilkan kegiatan akademik dan non-akademik di Yayasan Pendidikan Pesantren Sunan Kudus.",
      "image": galleryItems.map(item => item.src)
    }
  ]
};
---

<Layout 
  title="Galeri & Jejak Langkah Kegiatan | YP2SK - Yayasan Pendidikan Pesantren Sunan Kudus" 
  description="Mengabadikan setiap momen pertumbuhan, keceriaan, dan pencapaian siswa kami dalam perjalanan menuju keunggulan melalui dokumentasi kegiatan akademik, olahraga, seni budaya, dan fasilitas kami."
  schema={galeriSchema}
>
  <!-- Floating Vector Ribbon Line matching yayasan.astro & index.astro -->
  <div aria-hidden="true" class="curved-line-bg">
    <svg class="w-full h-full opacity-35" fill="none" preserveAspectRatio="none" viewBox="0 0 1440 4800">
      <path d="M720,200 C1100,500 1200,900 850,1300 C500,1700 200,2000 550,2500 C900,3000 1250,3300 950,3800 C700,4200 400,4500 720,4800" stroke="#8BBB92" stroke-dasharray="8 8" stroke-width="2.5"></path>
    </svg>
  </div>

  <div class="relative z-10 font-sans">
    <!-- Hero Header Section (Cinematic Panoramic Banner with Overlapping Card matching yayasan.astro) -->
    <section class="relative font-sans pb-6 sm:pb-10">
      <!-- Panoramic Banner -->
      <div class="relative w-full h-[320px] sm:h-[380px] lg:h-[420px] overflow-hidden bg-slate-950">
        <img 
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuCavFC-99FADJK6mO15qdRLjoreFX-FK3DeOp-_BK11xqeikKtizE4CjRMes2HaSlT6lx-2Yl_6SF53rsp0awfSaGCJ_Yw1xg-jEwYgrEiUN4d29JRAEZ8jF2iBGfZceSjU6rQrSR-0aoc9vP060egOHlfluZTT0I1VU-IECfDv87L0YYmQ_Cv0qKeVfJSoQJYcJfve44NMj6h3ldF3T9lG1XF1vg4KBpuLs-10nqCanmN97hm9jfmyjg"
          alt="Galeri Dokumentasi Kegiatan Yayasan Pendidikan Pesantren Sunan Kudus" 
          class="w-full h-full object-cover object-center opacity-80"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/35 to-brand-emeraldDark/25"></div>
      </div>

      <!-- Overlapping Profile Header Card -->
      <div class="max-w-4xl mx-auto px-4 sm:px-6 -mt-20 sm:-mt-24 lg:-mt-28 relative z-20" data-aos="fade-up">
        <div class="bg-white/95 backdrop-blur-md rounded-3xl p-8 sm:p-12 shadow-soft border border-slate-200/90 text-center">
          <span class="badge-pill bg-brand-iceBlue text-brand-emerald border border-brand-mint font-sans mb-4 inline-flex items-center gap-1.5">
            <span class="material-symbols-outlined text-sm">photo_library</span>
            Amanah • Tumbuh • Unggul
          </span>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-slate-900 leading-tight font-sans">
            Galeri &amp; Jejak Langkah
          </h1>

          <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed font-sans font-normal italic">
            "Mengabadikan setiap momen pertumbuhan, keceriaan, dan pencapaian siswa kami dalam perjalanan menuju keunggulan."
          </p>
        </div>
      </div>
    </section>

    <!-- Gallery Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 font-sans">
      
      <!-- Category Filter Tabs -->
      <div class="flex flex-nowrap md:flex-wrap justify-start md:justify-center items-center gap-2 md:gap-3 mb-10 overflow-x-auto pb-4 scrollbar-none snap-x snap-mandatory">
        <button class="filter-btn active px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold border transition-all cursor-pointer bg-brand-emerald text-white border-brand-emerald shadow-sm snap-align-none shrink-0 font-sans" data-category="all">Semua</button>
        <button class="filter-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold border transition-all cursor-pointer bg-white text-slate-700 border-slate-200/90 hover:bg-slate-50 snap-align-none shrink-0 font-sans" data-category="kegiatan-siswa">Kegiatan Siswa</button>
        <button class="filter-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold border transition-all cursor-pointer bg-white text-slate-700 border-slate-200/90 hover:bg-slate-50 snap-align-none shrink-0 font-sans" data-category="fasilitas">Fasilitas</button>
        <button class="filter-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold border transition-all cursor-pointer bg-white text-slate-700 border-slate-200/90 hover:bg-slate-50 snap-align-none shrink-0 font-sans" data-category="lingkungan">Lingkungan</button>
        <button class="filter-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold border transition-all cursor-pointer bg-white text-slate-700 border-slate-200/90 hover:bg-slate-50 snap-align-none shrink-0 font-sans" data-category="olahraga">Olahraga</button>
        <button class="filter-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold border transition-all cursor-pointer bg-white text-slate-700 border-slate-200/90 hover:bg-slate-50 snap-align-none shrink-0 font-sans" data-category="seni-budaya">Seni &amp; Budaya</button>
        <button class="filter-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold border transition-all cursor-pointer bg-white text-slate-700 border-slate-200/90 hover:bg-slate-50 snap-align-none shrink-0 font-sans" data-category="akademik">Akademik</button>
      </div>

      <!-- Gallery Grid (3 Columns) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 transition-all duration-500 ease-in-out" id="gallery-grid">
        {galleryItems.map((item) => (
          <div 
            class="gallery-item group overflow-hidden rounded-3xl shadow-soft border border-slate-200/80 transition-all duration-300 hover:shadow-lg hover:-translate-y-1 cursor-pointer bg-white flex flex-col" 
            data-category={item.categorySlug}
            data-title={item.title}
            data-category-name={item.category}
            data-desc={item.desc}
          >
            <!-- Image Container -->
            <div class="relative overflow-hidden aspect-[4/3] bg-slate-900 shrink-0">
              <img 
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" 
                src={item.src} 
                alt={item.alt}
                loading="lazy"
              />
              <span class="badge-pill absolute top-3.5 left-3.5 bg-white/95 backdrop-blur-md text-brand-emerald border border-brand-mint text-[11px] font-bold uppercase tracking-wider shadow-xs font-sans">
                {item.category}
              </span>
            </div>
            
            <!-- Caption/Description Content -->
            <div class="p-6 sm:p-7 flex-grow font-sans">
              <div class="space-y-2">
                <h3 class="text-slate-900 font-bold text-lg leading-snug group-hover:text-brand-emerald transition-colors font-sans">
                  {item.title}
                </h3>
                <p class="text-slate-600 text-xs sm:text-sm leading-relaxed line-clamp-3 font-sans">
                  {item.desc}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Video Documentation Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 scroll-mt-24 font-sans" id="dokumentasi-video">
      <div class="max-w-3xl mx-auto text-center font-sans mb-12 sm:mb-16" data-aos="fade-up">
        <span class="badge-pill bg-brand-iceBlue text-brand-emerald mb-3 border border-brand-mint font-sans">
          Video Pilihan
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-900 tracking-tight leading-snug font-sans">
          Jejak Langkah &amp; Profil Video
        </h2>
        <div class="w-16 h-1 bg-brand-emerald mx-auto rounded-full mt-3"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Video Card 1 -->
        <div class="bg-white rounded-3xl overflow-hidden shadow-soft border border-slate-200/80 hover:shadow-lg transition-all duration-300 group flex flex-col justify-between" data-aos="fade-up" data-aos-delay="100">
          <div class="relative aspect-video bg-black overflow-hidden cursor-pointer video-play-trigger" data-video-id="coY5sO-Y4z0">
            <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-80" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCavFC-99FADJK6mO15qdRLjoreFX-FK3DeOp-_BK11xqeikKtizE4CjRMes2HaSlT6lx-2Yl_6SF53rsp0awfSaGCJ_Yw1xg-jEwYgrEiUN4d29JRAEZ8jF2iBGfZceSjU6rQrSR-0aoc9vP060egOHlfluZTT0I1VU-IECfDv87L0YYmQ_Cv0qKeVfJSoQJYcJfve44NMj6h3ldF3T9lG1XF1vg4KBpuLs-10nqCanmN97hm9jfmyjg" alt="Thumbnail Profil YP2SK" />
            <div class="absolute inset-0 bg-slate-950/20 group-hover:bg-slate-950/40 transition-colors flex items-center justify-center">
              <div class="w-16 h-16 rounded-full bg-brand-emerald text-white flex items-center justify-center shadow-lg transition-transform duration-300 group-hover:scale-110">
                <span class="material-symbols-outlined text-3xl font-bold">play_arrow</span>
              </div>
            </div>
          </div>
          <div class="p-6 sm:p-8 space-y-2">
            <span class="badge-pill bg-brand-mint text-brand-emeraldDark text-xs font-semibold uppercase tracking-wider font-sans">Video Profil</span>
            <h3 class="text-xl font-bold text-slate-900 group-hover:text-brand-emerald transition-colors font-sans mt-2">Video Profil Resmi YP2SK</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-sans">
              Tonton video profil resmi Yayasan Pendidikan Pesantren Sunan Kudus untuk mengenal lingkungan sekolah, staf pengajar, dan metode pembelajaran kami.
            </p>
          </div>
        </div>

        <!-- Video Card 2 -->
        <div class="bg-white rounded-3xl overflow-hidden shadow-soft border border-slate-200/80 hover:shadow-lg transition-all duration-300 group flex flex-col justify-between" data-aos="fade-up" data-aos-delay="200">
          <div class="relative aspect-video bg-black overflow-hidden cursor-pointer video-play-trigger" data-video-id="dQw4w9WgXcQ">
            <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-80" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDYfTLePOkcB-8eEDqM5C1fmxLd8oivn775jr4JItpRozPBM92Q-KejUEHjdO4jbv1mgxNR9ou9mSq1i5GSs4VXb0TqxcR9SkH-ON020ZOpk8POUzMzjZV0HBZM37JwvnuIZyPjL9FQaXF3_6Jt6MpfQ1diIEuv-MF0eV7Bt97KVmO2nA4DKt4QVCLfgFEOBrd55jNJca66wtEb_LlxJXZeEDFJc5pBTOrN6Z99mi6yB0168jB_mi948g" alt="Thumbnail Pentas Seni & Kreativitas" />
            <div class="absolute inset-0 bg-slate-950/20 group-hover:bg-slate-950/40 transition-colors flex items-center justify-center">
              <div class="w-16 h-16 rounded-full bg-brand-emerald text-white flex items-center justify-center shadow-lg transition-transform duration-300 group-hover:scale-110">
                <span class="material-symbols-outlined text-3xl font-bold">play_arrow</span>
              </div>
            </div>
          </div>
          <div class="p-6 sm:p-8 space-y-2">
            <span class="badge-pill bg-brand-mint text-brand-emeraldDark text-xs font-semibold uppercase tracking-wider font-sans">Kegiatan Seni</span>
            <h3 class="text-xl font-bold text-slate-900 group-hover:text-brand-emerald transition-colors font-sans mt-2">Dokumentasi Pentas Seni Akhir Tahun</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-sans">
              Kreativitas, keceriaan, dan talenta siswa YP2SK yang luar biasa dalam pertunjukan seni musik, teater, dan tari daerah.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action (Styled matching yayasan.astro & PreFooter.astro) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 font-sans" data-aos="fade-up">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-slate-950 via-brand-emeraldDark to-brand-emerald text-white p-8 sm:p-12 shadow-xl border border-white/10 text-center">
        <!-- Decorative Watermark & Ambient Glow matching yayasan.astro -->
        <div class="absolute -right-8 -bottom-10 text-white/5 select-none pointer-events-none font-serif text-[140px] leading-none">
          ق
        </div>
        <div class="absolute -top-16 -left-16 w-64 h-64 bg-brand-emerald/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 max-w-2xl mx-auto space-y-4">
          <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white/10 text-brand-mint text-xs font-semibold uppercase tracking-wider mb-2 border border-white/15 backdrop-blur-xs font-sans">
            Mari Menjadi Bagian Dari Kami
          </span>

          <h2 class="text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight text-white leading-snug font-sans">
            Mulai Perjalanan Belajar Anak Anda Bersama YP2SK
          </h2>

          <p class="text-xs sm:text-sm text-slate-200 leading-relaxed font-light max-w-2xl mx-auto">
            Dapatkan informasi lebih lanjut mengenai pendaftaran, agenda kunjungan, dan kurikulum pendidikan terbaik kami.
          </p>

          <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
            <a 
              href="/kontak"
              class="w-full sm:w-auto px-8 py-3 rounded-full bg-white text-slate-900 hover:bg-slate-100 font-bold text-xs sm:text-sm shadow-md transition transform hover:-translate-y-0.5 flex items-center justify-center gap-2 whitespace-nowrap"
            >
              <span class="material-symbols-outlined text-base">chat</span>
              Hubungi Kami
            </a>
            <button 
              class="w-full sm:w-auto px-6 py-3 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-white font-medium text-xs sm:text-sm transition backdrop-blur-sm text-center whitespace-nowrap cursor-pointer"
            >
              Unduh Brosur PMB
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Lightbox Modal -->
    <div id="lightbox-modal" class="fixed inset-0 z-[100] flex items-center justify-center bg-black/90 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300 px-4 sm:px-6 py-6">
      <button id="lightbox-close" class="absolute top-6 right-6 text-white hover:text-brand-mint transition-colors cursor-pointer p-2 z-[101]" aria-label="Tutup Penampil Gambar">
        <span class="material-symbols-outlined text-4xl">close</span>
      </button>
      <div class="relative max-w-4xl w-full flex flex-col md:flex-row bg-white rounded-3xl overflow-hidden shadow-2xl max-h-[85vh] md:max-h-[80vh] border border-white/20">
        <!-- Image Area -->
        <div class="md:w-2/3 bg-black flex items-center justify-center relative overflow-hidden h-[40vh] md:h-auto">
          <img id="lightbox-img" class="max-w-full max-h-full object-contain" src="" alt="" />
        </div>
        <!-- Info Area -->
        <div class="md:w-1/3 p-6 sm:p-8 flex flex-col justify-between overflow-y-auto font-sans">
          <div>
            <span id="lightbox-category" class="badge-pill bg-brand-iceBlue text-brand-emerald border border-brand-mint font-sans text-xs font-bold uppercase tracking-wider mb-3 inline-block">Kategori</span>
            <h2 id="lightbox-title" class="font-bold text-xl sm:text-2xl text-slate-900 leading-tight mb-3 font-sans">Judul Gambar</h2>
            <p id="lightbox-desc" class="text-slate-600 text-xs sm:text-sm leading-relaxed font-sans">Deskripsi lengkap gambar akan dimuat di sini secara dinamis.</p>
          </div>
          <div class="pt-6 border-t border-slate-100 mt-6 flex items-center justify-between font-sans">
            <span class="text-xs text-slate-400 font-medium flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">info</span>
              Aksesibilitas Alt aktif
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Video Modal Player -->
    <div id="video-modal" class="fixed inset-0 z-[100] flex items-center justify-center bg-black/95 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300 px-4 sm:px-6 py-6">
      <button id="video-close" class="absolute top-6 right-6 text-white hover:text-brand-mint transition-colors cursor-pointer p-2 z-[101]" aria-label="Tutup Pemutar Video">
        <span class="material-symbols-outlined text-4xl">close</span>
      </button>
      <div class="relative w-full max-w-4xl aspect-video rounded-3xl overflow-hidden shadow-2xl border border-white/20 bg-black">
        <iframe id="video-iframe" class="w-full h-full" src="" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .scrollbar-none {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }

  .gallery-item {
    transition: opacity 0.3s ease-out, transform 0.3s ease-out, box-shadow 0.3s ease-in-out;
  }
</style>

<script>
  function setupGalleryPage() {
    // 1. Category Filtering
    const filterButtons = document.querySelectorAll('.filter-btn');
    const galleryItems = document.querySelectorAll('.gallery-item');

    if (filterButtons.length > 0 && galleryItems.length > 0) {
      filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          // Remove active class from all buttons
          filterButtons.forEach(b => {
            b.classList.remove('bg-brand-emerald', 'text-white', 'border-brand-emerald', 'shadow-sm', 'active');
            b.classList.add('bg-white', 'text-slate-700', 'border-slate-200/90', 'hover:bg-slate-50');
          });

          // Add active class to clicked button
          btn.classList.add('bg-brand-emerald', 'text-white', 'border-brand-emerald', 'shadow-sm', 'active');
          btn.classList.remove('bg-white', 'text-slate-700', 'border-slate-200/90', 'hover:bg-slate-50');

          const category = btn.getAttribute('data-category');

          galleryItems.forEach(item => {
            const itemCategory = item.getAttribute('data-category');
            if (category === 'all' || itemCategory === category) {
              // Fade in
              (item as HTMLElement).style.display = 'flex';
              setTimeout(() => {
                (item as HTMLElement).style.opacity = '1';
                (item as HTMLElement).style.transform = 'scale(1)';
              }, 10);
            } else {
              // Fade out
              (item as HTMLElement).style.opacity = '0';
              (item as HTMLElement).style.transform = 'scale(0.95)';
              setTimeout(() => {
                (item as HTMLElement).style.display = 'none';
              }, 300);
            }
          });
        });
      });
    }

    // 2. Lightbox Modal
    const lightboxModal = document.getElementById('lightbox-modal');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxCategory = document.getElementById('lightbox-category');
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxDesc = document.getElementById('lightbox-desc');
    const lightboxClose = document.getElementById('lightbox-close');

    if (lightboxModal && lightboxClose) {
      galleryItems.forEach(item => {
        item.addEventListener('click', () => {
          const imgEl = item.querySelector('img') as HTMLImageElement | null;
          if (imgEl && lightboxImg && lightboxCategory && lightboxTitle && lightboxDesc) {
            lightboxImg.src = imgEl.src;
            lightboxImg.alt = imgEl.alt;
            lightboxCategory.textContent = item.getAttribute('data-category-name');
            lightboxTitle.textContent = item.getAttribute('data-title');
            lightboxDesc.textContent = item.getAttribute('data-desc');

            // Open Modal
            lightboxModal.classList.remove('opacity-0', 'pointer-events-none');
            lightboxModal.classList.add('opacity-100');
            document.body.style.overflow = 'hidden'; // Disable background scrolling
          }
        });
      });

      // Close Lightbox function
      const closeLightbox = () => {
        if (lightboxModal) {
          lightboxModal.classList.remove('opacity-100');
          lightboxModal.classList.add('opacity-0', 'pointer-events-none');
        }
        document.body.style.overflow = ''; // Re-enable scrolling
        setTimeout(() => {
          if (lightboxImg) lightboxImg.src = '';
        }, 300);
      };

      lightboxClose.addEventListener('click', closeLightbox);
      lightboxModal.addEventListener('click', (e) => {
        if (e.target === lightboxModal) {
          closeLightbox();
        }
      });

      // Close on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && lightboxModal && !lightboxModal.classList.contains('pointer-events-none')) {
          closeLightbox();
        }
      });
    }

    // 3. Video Modal Player
    const videoModal = document.getElementById('video-modal');
    const videoIframe = document.getElementById('video-iframe') as HTMLIFrameElement | null;
    const videoClose = document.getElementById('video-close');
    const videoTriggers = document.querySelectorAll('.video-play-trigger');

    if (videoModal && videoClose && videoIframe && videoTriggers.length > 0) {
      videoTriggers.forEach(trigger => {
        trigger.addEventListener('click', () => {
          const videoId = trigger.getAttribute('data-video-id');
          if (videoId) {
            videoIframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
            videoModal.classList.remove('opacity-0', 'pointer-events-none');
            videoModal.classList.add('opacity-100');
            document.body.style.overflow = 'hidden';
          }
        });
      });

      const closeVideo = () => {
        if (videoModal) {
          videoModal.classList.remove('opacity-100');
          videoModal.classList.add('opacity-0', 'pointer-events-none');
        }
        if (videoIframe) videoIframe.src = '';
        document.body.style.overflow = '';
      };

      videoClose.addEventListener('click', closeVideo);
      videoModal.addEventListener('click', (e) => {
        if (e.target === videoModal) {
          closeVideo();
        }
      });
    }
  }

  // Initial execution
  setupGalleryPage();
  // View transitions support
  document.addEventListener('astro:after-swap', setupGalleryPage);
</script>
