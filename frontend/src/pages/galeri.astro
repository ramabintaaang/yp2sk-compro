const galleryItems = fallbackGallery;

const galeriSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://yp2sk.or.id/galeri#webpage",
      "url": "https://yp2sk.or.id/galeri",
      "name": "Galeri & Jejak Langkah | YP2SK",
      "description": "Dokumentasi visual kegiatan belajar mengajar, fasilitas sekolah, prestasi olahraga, pentas seni, dan praktikum laboratorium di YP2SK.",
      "breadcrumb": {
        "@id": "https://yp2sk.or.id/galeri/#breadcrumb"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://yp2sk.or.id/galeri/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Beranda",
          "item": "https://yp2sk.or.id"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Galeri & Jejak Langkah",
          "item": "https://yp2sk.or.id/galeri"
        }
      ]
    },
    {
      "@type": "ImageGallery",
      "@id": "https://yp2sk.or.id/galeri#gallery",
      "name": "Galeri Dokumentasi YP2SK",
      "description": "Galeri foto resmi yang menampilkan kegiatan akademik dan non-akademik di Yayasan Pendidikan Pesantren Sunan Kudus.",
      "image": galleryItems.map(item => item.src)
    }
  ]
};
---

<Layout 
  title="Galeri & Jejak Langkah Kegiatan | YP2SK - Yayasan Pendidikan Pesantren Sunan Kudus" 
  description="Mengabadikan setiap momen pertumbuhan, keceriaan, dan pencapaian siswa kami dalam perjalanan menuju keunggulan melalui dokumentasi kegiatan akademik, olahraga, seni budaya, dan fasilitas kami."
  schema={galeriSchema}
>
  <div class="pt-20">
    <!-- Hero Header Section -->
    <header class="relative overflow-hidden bg-surface py-xl border-b border-outline-variant/30 page-animate">
      <div class="absolute inset-0 bg-pattern opacity-50"></div>
      <div class="max-w-[1140px] mx-auto px-margin-mobile md:px-margin-desktop relative z-10 text-center">
        <span class="inline-block px-md py-1 rounded-full bg-secondary-container text-on-secondary-container text-label-md uppercase tracking-wider mb-sm font-bold">Amanah • Tumbuh • Unggul</span>
        <h1 class="font-headline-xl text-headline-xl-mobile md:text-headline-xl text-primary mb-md">Galeri &amp; Jejak Langkah</h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-[42rem] mx-auto italic">
          "Mengabadikan setiap momen pertumbuhan, keceriaan, dan pencapaian siswa kami dalam perjalanan menuju keunggulan."
        </p>
      </div>
    </header>

    <!-- Gallery Section -->
    <section class="py-xl max-w-[1140px] mx-auto px-margin-mobile md:px-margin-desktop page-animate">
      
      <!-- Category Filter Tabs -->
      <div class="flex flex-nowrap md:flex-wrap justify-start md:justify-center items-center gap-2 md:gap-3 mb-lg overflow-x-auto pb-4 scrollbar-none snap-x snap-mandatory">
        <button class="filter-btn active px-5 py-2.5 rounded-full text-label-lg font-bold border transition-all cursor-pointer bg-secondary text-on-secondary border-secondary shadow-md snap-align-none shrink-0" data-category="all">Semua</button>
        <button class="filter-btn px-5 py-2.5 rounded-full text-label-lg font-bold border transition-all cursor-pointer bg-surface-container-lowest text-on-surface-variant border-outline-variant/30 hover:bg-surface-container hover:text-primary snap-align-none shrink-0" data-category="kegiatan-siswa">Kegiatan Siswa</button>
        <button class="filter-btn px-5 py-2.5 rounded-full text-label-lg font-bold border transition-all cursor-pointer bg-surface-container-lowest text-on-surface-variant border-outline-variant/30 hover:bg-surface-container hover:text-primary snap-align-none shrink-0" data-category="fasilitas">Fasilitas</button>
        <button class="filter-btn px-5 py-2.5 rounded-full text-label-lg font-bold border transition-all cursor-pointer bg-surface-container-lowest text-on-surface-variant border-outline-variant/30 hover:bg-surface-container hover:text-primary snap-align-none shrink-0" data-category="lingkungan">Lingkungan</button>
        <button class="filter-btn px-5 py-2.5 rounded-full text-label-lg font-bold border transition-all cursor-pointer bg-surface-container-lowest text-on-surface-variant border-outline-variant/30 hover:bg-surface-container hover:text-primary snap-align-none shrink-0" data-category="olahraga">Olahraga</button>
        <button class="filter-btn px-5 py-2.5 rounded-full text-label-lg font-bold border transition-all cursor-pointer bg-surface-container-lowest text-on-surface-variant border-outline-variant/30 hover:bg-surface-container hover:text-primary snap-align-none shrink-0" data-category="seni-budaya">Seni &amp; Budaya</button>
        <button class="filter-btn px-5 py-2.5 rounded-full text-label-lg font-bold border transition-all cursor-pointer bg-surface-container-lowest text-on-surface-variant border-outline-variant/30 hover:bg-surface-container hover:text-primary snap-align-none shrink-0" data-category="akademik">Akademik</button>
      </div>

      <!-- Gallery Grid (3 Columns) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 transition-all duration-500 ease-in-out" id="gallery-grid">
        {galleryItems.map((item) => (
          <div 
            class="gallery-item group overflow-hidden rounded-xl shadow-sm border border-outline-variant/10 transition-all duration-300 hover:shadow-md hover:-translate-y-1 cursor-pointer bg-surface-container-lowest flex flex-col" 
            data-category={item.categorySlug}
            data-title={item.title}
            data-category-name={item.category}
            data-desc={item.desc}
          >
            <!-- Image Container -->
            <div class="relative overflow-hidden aspect-[4/3] bg-surface-container-low shrink-0">
              <img 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
                src={item.src} 
                alt={item.alt}
                loading="lazy"
              />
              <span class="absolute top-3 left-3 px-3 py-1 bg-primary/80 backdrop-blur-sm text-white rounded-full text-[11px] font-bold uppercase tracking-wider">
                {item.category}
              </span>
            </div>
            
            <!-- Caption/Description Content -->
            <div class="p-5 flex-grow">
              <div class="space-y-2">
                <h3 class="text-primary font-headline-md text-headline-md leading-snug group-hover:text-secondary transition-colors">
                  {item.title}
                </h3>
                <p class="text-on-surface-variant font-body-sm text-body-sm leading-relaxed line-clamp-3">
                  {item.desc}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Video Documentation Section -->
    <section class="py-xl bg-surface-container-low border-y border-outline-variant/20 scroll-mt-24 page-animate" id="dokumentasi-video">
      <div class="max-w-[1140px] mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="text-center mb-xl">
          <span class="inline-block px-md py-1 rounded-full bg-primary-container text-on-primary-container text-label-md uppercase tracking-wider mb-sm font-bold">Video Pilihan</span>
          <h2 class="font-headline-lg text-headline-lg text-primary">Jejak Langkah &amp; Profil Video</h2>
          <div class="w-16 h-1 bg-secondary mx-auto rounded-full mt-xs"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
          <!-- Video Card 1 -->
          <div class="bg-surface-container-lowest rounded-2xl overflow-hidden shadow-md border border-outline-variant/10 hover:shadow-xl transition-all duration-300 group">
            <div class="relative aspect-video bg-black overflow-hidden cursor-pointer video-play-trigger" data-video-id="coY5sO-Y4z0">
              <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-80" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCavFC-99FADJK6mO15qdRLjoreFX-FK3DeOp-_BK11xqeikKtizE4CjRMes2HaSlT6lx-2Yl_6SF53rsp0awfSaGCJ_Yw1xg-jEwYgrEiUN4d29JRAEZ8jF2iBGfZceSjU6rQrSR-0aoc9vP060egOHlfluZTT0I1VU-IECfDv87L0YYmQ_Cv0qKeVfJSoQJYcJfve44NMj6h3ldF3T9lG1XF1vg4KBpuLs-10nqCanmN97hm9jfmyjg" alt="Thumbnail Profil YP2SK" />
              <div class="absolute inset-0 bg-primary/20 group-hover:bg-primary/40 transition-colors flex items-center justify-center">
                <div class="w-16 h-16 rounded-full bg-secondary text-white flex items-center justify-center shadow-lg transition-transform duration-300 group-hover:scale-110">
                  <span class="material-symbols-outlined text-3xl font-bold">play_arrow</span>
                </div>
              </div>
            </div>
            <div class="p-lg">
              <span class="text-xs text-secondary font-bold uppercase tracking-wider">Video Profil</span>
              <h3 class="font-headline-md text-headline-md text-primary mt-xs mb-sm">Video Profil Resmi YP2SK</h3>
              <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                Tonton video profil resmi Yayasan Pendidikan Pesantren Sunan Kudus untuk mengenal lingkungan sekolah, staf pengajar, dan metode pembelajaran kami.
              </p>
            </div>
          </div>

          <!-- Video Card 2 -->
          <div class="bg-surface-container-lowest rounded-2xl overflow-hidden shadow-md border border-outline-variant/10 hover:shadow-xl transition-all duration-300 group">
            <div class="relative aspect-video bg-black overflow-hidden cursor-pointer video-play-trigger" data-video-id="dQw4w9WgXcQ">
              <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-80" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDYfTLePOkcB-8eEDqM5C1fmxLd8oivn775jr4JItpRozPBM92Q-KejUEHjdO4jbv1mgxNR9ou9mSq1i5GSs4VXb0TqxcR9SkH-ON020ZOpk8POUzMzjZV0HBZM37JwvnuIZyPjL9FQaXF3_6Jt6MpfQ1diIEuv-MF0eV7Bt97KVmO2nA4DKt4QVCLfgFEOBrd55jNJca66wtEb_LlxJXZeEDFJc5pBTOrN6Z99mi6yB0168jB_mi948g" alt="Thumbnail Pentas Seni & Kreativitas" />
              <div class="absolute inset-0 bg-primary/20 group-hover:bg-primary/40 transition-colors flex items-center justify-center">
                <div class="w-16 h-16 rounded-full bg-secondary text-white flex items-center justify-center shadow-lg transition-transform duration-300 group-hover:scale-110">
                  <span class="material-symbols-outlined text-3xl font-bold">play_arrow</span>
                </div>
              </div>
            </div>
            <div class="p-lg">
              <span class="text-xs text-secondary font-bold uppercase tracking-wider">Kegiatan Seni</span>
              <h3 class="font-headline-md text-headline-md text-primary mt-xs mb-sm">Dokumentasi Pentas Seni Akhir Tahun</h3>
              <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                Kreativitas, keceriaan, dan talenta siswa YP2SK yang luar biasa dalam pertunjukan seni musik, teater, dan tari daerah.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="py-xl max-w-[1140px] mx-auto px-margin-mobile md:px-margin-desktop text-center page-animate">
      <div class="bg-primary p-xl rounded-2xl relative overflow-hidden group">
        <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-secondary/20 rounded-full blur-3xl transition-all group-hover:scale-150"></div>
        <div class="absolute -top-10 -right-10 w-40 h-40 bg-primary-fixed-dim/10 rounded-full blur-3xl transition-all group-hover:scale-150"></div>
        <div class="relative z-10 space-y-md">
          <span class="text-secondary-fixed text-label-md font-bold uppercase tracking-widest">Mari Menjadi Bagian Dari Kami</span>
          <h2 class="font-headline-lg text-headline-xl-mobile md:text-headline-lg text-white max-w-2xl mx-auto leading-tight">Mulai Perjalanan Belajar Anak Anda Bersama YP2SK</h2>
          <p class="font-body-md opacity-90 max-w-[36rem] mx-auto text-white/90 leading-relaxed">
            Dapatkan informasi lebih lanjut mengenai pendaftaran, agenda kunjungan, dan kurikulum pendidikan terbaik kami.
          </p>
          <div class="pt-sm flex flex-col sm:flex-row gap-4 justify-center items-center">
            <a class="w-full sm:w-auto inline-flex items-center justify-center gap-sm bg-secondary text-on-secondary px-lg py-md rounded-full font-label-lg hover:brightness-110 transition-all shadow-lg cursor-pointer" href="/kontak">
              <span class="material-symbols-outlined">chat</span>
              Hubungi Kami
            </a>
            <button class="w-full sm:w-auto inline-flex items-center justify-center gap-sm bg-white/10 hover:bg-white/20 border border-white/20 text-white px-lg py-md rounded-full font-label-lg transition-all cursor-pointer">
              Unduh Brosur PMB
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Lightbox Modal -->
    <div id="lightbox-modal" class="fixed inset-0 z-[100] flex items-center justify-center bg-black/90 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300 px-margin-mobile md:px-margin-desktop py-lg">
      <button id="lightbox-close" class="absolute top-6 right-6 text-white hover:text-secondary-fixed transition-colors cursor-pointer p-2 z-[101]" aria-label="Tutup Penampil Gambar">
        <span class="material-symbols-outlined text-4xl">close</span>
      </button>
      <div class="relative max-w-4xl w-full flex flex-col md:flex-row bg-surface-container-lowest rounded-2xl overflow-hidden shadow-2xl max-h-[85vh] md:max-h-[80vh] border border-white/10">
        <!-- Image Area -->
        <div class="md:w-2/3 bg-black flex items-center justify-center relative overflow-hidden h-[40vh] md:h-auto">
          <img id="lightbox-img" class="max-w-full max-h-full object-contain" src="" alt="" />
        </div>
        <!-- Info Area -->
        <div class="md:w-1/3 p-lg flex flex-col justify-between overflow-y-auto">
          <div>
            <span id="lightbox-category" class="inline-block px-3 py-1 bg-secondary-container text-on-secondary-container rounded-full text-label-md font-bold uppercase tracking-wider mb-sm">Kategori</span>
            <h2 id="lightbox-title" class="font-headline-lg text-headline-md text-primary leading-tight mb-md">Judul Gambar</h2>
            <p id="lightbox-desc" class="font-body-md text-body-md text-on-surface-variant leading-relaxed">Deskripsi lengkap gambar akan dimuat di sini secara dinamis.</p>
          </div>
          <div class="pt-lg border-t border-outline-variant/30 mt-lg flex items-center justify-between">
            <span class="text-xs text-on-surface-variant font-label-md flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">info</span>
              Aksesibilitas Alt aktif
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Video Modal Player -->
    <div id="video-modal" class="fixed inset-0 z-[100] flex items-center justify-center bg-black/95 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300 px-margin-mobile md:px-margin-desktop py-lg">
      <button id="video-close" class="absolute top-6 right-6 text-white hover:text-secondary-fixed transition-colors cursor-pointer p-2 z-[101]" aria-label="Tutup Pemutar Video">
        <span class="material-symbols-outlined text-4xl">close</span>
      </button>
      <div class="relative w-full max-w-4xl aspect-video rounded-2xl overflow-hidden shadow-2xl border border-white/10 bg-black">
        <iframe id="video-iframe" class="w-full h-full" src="" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
      </div>
    </div>
  </div>
</Layout>

<style>
  .bg-pattern {
    background-image: radial-gradient(circle at 2px 2px, var(--color-surface-container-highest) 1px, transparent 0);
    background-size: 32px 32px;
  }
  
  /* Hide scrollbar for Chrome, Safari and Opera */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .scrollbar-none {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }

  .gallery-item {
    transition: opacity 0.3s ease-out, transform 0.3s ease-out, box-shadow 0.3s ease-in-out;
  }
</style>

<script>
  function setupGalleryPage() {
    // 1. Category Filtering
    const filterButtons = document.querySelectorAll('.filter-btn');
    const galleryItems = document.querySelectorAll('.gallery-item');

    if (filterButtons.length > 0 && galleryItems.length > 0) {
      filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          // Remove active class from all buttons
          filterButtons.forEach(b => {
            b.classList.remove('bg-secondary', 'text-on-secondary', 'border-secondary', 'shadow-md', 'active');
            b.classList.add('bg-surface-container-lowest', 'text-on-surface-variant', 'border-outline-variant/30');
          });

          // Add active class to clicked button
          btn.classList.add('bg-secondary', 'text-on-secondary', 'border-secondary', 'shadow-md', 'active');
          btn.classList.remove('bg-surface-container-lowest', 'text-on-surface-variant', 'border-outline-variant/30');

          const category = btn.getAttribute('data-category');

          galleryItems.forEach(item => {
            const itemCategory = item.getAttribute('data-category');
            if (category === 'all' || itemCategory === category) {
              // Fade in
              (item as HTMLElement).style.display = 'flex';
              setTimeout(() => {
                (item as HTMLElement).style.opacity = '1';
                (item as HTMLElement).style.transform = 'scale(1)';
              }, 10);
            } else {
              // Fade out
              (item as HTMLElement).style.opacity = '0';
              (item as HTMLElement).style.transform = 'scale(0.95)';
              setTimeout(() => {
                (item as HTMLElement).style.display = 'none';
              }, 300);
            }
          });
        });
      });
    }

    // 2. Lightbox Modal
    const lightboxModal = document.getElementById('lightbox-modal');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxCategory = document.getElementById('lightbox-category');
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxDesc = document.getElementById('lightbox-desc');
    const lightboxClose = document.getElementById('lightbox-close');

    if (lightboxModal && lightboxClose) {
      galleryItems.forEach(item => {
        item.addEventListener('click', () => {
          const imgEl = item.querySelector('img') as HTMLImageElement | null;
          if (imgEl && lightboxImg && lightboxCategory && lightboxTitle && lightboxDesc) {
            lightboxImg.src = imgEl.src;
            lightboxImg.alt = imgEl.alt;
            lightboxCategory.textContent = item.getAttribute('data-category-name');
            lightboxTitle.textContent = item.getAttribute('data-title');
            lightboxDesc.textContent = item.getAttribute('data-desc');

            // Open Modal
            lightboxModal.classList.remove('opacity-0', 'pointer-events-none');
            lightboxModal.classList.add('opacity-100');
            document.body.style.overflow = 'hidden'; // Disable background scrolling
          }
        });
      });

      // Close Lightbox function
      const closeLightbox = () => {
        if (lightboxModal) {
          lightboxModal.classList.remove('opacity-100');
          lightboxModal.classList.add('opacity-0', 'pointer-events-none');
        }
        document.body.style.overflow = ''; // Re-enable scrolling
        setTimeout(() => {
          if (lightboxImg) lightboxImg.src = '';
        }, 300);
      };

      lightboxClose.addEventListener('click', closeLightbox);
      lightboxModal.addEventListener('click', (e) => {
        if (e.target === lightboxModal) {
          closeLightbox();
        }
      });

      // Close on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && lightboxModal && !lightboxModal.classList.contains('pointer-events-none')) {
          closeLightbox();
        }
      });
    }

    // 3. Video Modal Player
    const videoModal = document.getElementById('video-modal');
    const videoIframe = document.getElementById('video-iframe') as HTMLIFrameElement | null;
    const videoClose = document.getElementById('video-close');
    const videoTriggers = document.querySelectorAll('.video-play-trigger');

    if (videoModal && videoClose && videoIframe && videoTriggers.length > 0) {
      videoTriggers.forEach(trigger => {
        trigger.addEventListener('click', () => {
          const videoId = trigger.getAttribute('data-video-id');
          if (videoId) {
            videoIframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
            videoModal.classList.remove('opacity-0', 'pointer-events-none');
            videoModal.classList.add('opacity-100');
            document.body.style.overflow = 'hidden';
          }
        });
      });

      const closeVideo = () => {
        if (videoModal) {
          videoModal.classList.remove('opacity-100');
          videoModal.classList.add('opacity-0', 'pointer-events-none');
        }
        if (videoIframe) videoIframe.src = '';
        document.body.style.overflow = '';
      };

      videoClose.addEventListener('click', closeVideo);
      videoModal.addEventListener('click', (e) => {
        if (e.target === videoModal) {
          closeVideo();
        }
      });
    }

    // 4. Scroll Fade-in Animation (consistent with kontak.astro)
    const observerOptions = {
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('opacity-100', 'translate-y-0');
          entry.target.classList.remove('opacity-0', 'translate-y-8');
        }
      });
    }, observerOptions);

    const animatedElements = document.querySelectorAll('.page-animate');
    animatedElements.forEach(el => {
      el.classList.add('transition-all', 'duration-700', 'opacity-0', 'translate-y-8');
      observer.observe(el);
    });
  }

  // Initial execution
  setupGalleryPage();
  // View transitions support
  document.addEventListener('astro:after-swap', setupGalleryPage);
</script>
