---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/beranda/Hero.astro';
import Greeting from '../components/beranda/Greeting.astro';
import Programs from '../components/beranda/Programs.astro';
import ValuesAndStats from '../components/beranda/ValuesAndStats.astro';
import News from '../components/beranda/News.astro';

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://yp2sk.or.id/#organization",
      "name": "Yayasan Pendidikan Pesantren Sunan Kudus (YP2SK)",
      "alternateName": "YP2SK",
      "url": "https://yp2sk.or.id",
      "logo": {
        "@type": "ImageObject",
        "@id": "https://yp2sk.or.id/#logo",
        "url": "https://yp2sk.or.id/favicon.svg",
        "caption": "Logo YP2SK"
      },
      "image": {
        "@id": "https://yp2sk.or.id/#logo"
      },
      "description": "YP2SK berkomitmen menghadirkan pendidikan anak usia dini yang berkualitas, amanah, dan menumbuhkan potensi terbaik anak dalam lingkungan yang islami dan menyenangkan.",
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "telephone": "+62-21-5555-1234",
          "contactType": "customer service",
          "email": "info@yp2sk.or.id",
          "areaServed": "ID",
          "availableLanguage": ["id", "en"]
        }
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://yp2sk.or.id/#website",
      "url": "https://yp2sk.or.id",
      "name": "YP2SK | Yayasan Pendidikan Pesantren Sunan Kudus",
      "publisher": {
        "@id": "https://yp2sk.or.id/#organization"
      },
      "inLanguage": "id"
    }
  ]
};
---

<Layout 
  title="YP2SK | Yayasan Pendidikan Pesantren Sunan Kudus"
  description="YP2SK berkomitmen menghadirkan pendidikan berkualitas, amanah, dan menumbuhkan potensi terbaik anak dalam lingkungan yang islami dan menyenangkan."
  schema={homeSchema}
>
  <Hero />
  <Greeting />
  <Programs />
  <ValuesAndStats />
  <News />
</Layout>
