---
import Layout from '../layouts/Layout.astro';

const contactSchema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://yp2sk.or.id"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Hubungi Kami",
        "item": "https://yp2sk.or.id/kontak"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "School",
    "@id": "https://yp2sk.or.id/#school",
    "name": "Yayasan Pendidikan Pesantren Sunan Kudus (YP2SK)",
    "url": "https://yp2sk.or.id",
    "logo": "https://yp2sk.or.id/images/logo-yp2sk.png",
    "image": "https://yp2sk.or.id/og-image.png",
    "description": "Hubungi YP2SK untuk informasi pendaftaran siswa baru (PMB), kerjasama, donasi, dan program yayasan. Dapatkan alamat kantor, email, dan kontak WhatsApp resmi kami.",
    "telephone": "+62-21-5555-1234",
    "email": "info@yp2sk.or.id",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Jln. Madurekso No. 22, Langgar Dalem",
      "addressLocality": "Kota Kudus",
      "addressRegion": "Jawa Tengah",
      "postalCode": "59317",
      "addressCountry": "ID"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": "-6.8048",
      "longitude": "110.8404"
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday"
      ],
      "opens": "08:00",
      "closes": "16:00"
    }
  }
];
---

<Layout 
  title="Hubungi Kami | YP2SK - Yayasan Pendidikan Pesantren Sunan Kudus" 
  description="Hubungi YP2SK untuk informasi pendaftaran siswa baru (PMB), kerjasama, donasi, dan program yayasan. Dapatkan alamat kantor, email, dan kontak WhatsApp resmi kami."
  schema={contactSchema}
>
  <!-- Floating Vector Ribbon Line matching yayasan.astro & index.astro -->
  <div aria-hidden="true" class="curved-line-bg">
    <svg class="w-full h-full opacity-35" fill="none" preserveAspectRatio="none" viewBox="0 0 1440 4800">
      <path d="M720,200 C1100,500 1200,900 850,1300 C500,1700 200,2000 550,2500 C900,3000 1250,3300 950,3800 C700,4200 400,4500 720,4800" stroke="#8BBB92" stroke-dasharray="8 8" stroke-width="2.5"></path>
    </svg>
  </div>

  <div class="relative z-10 font-sans">
    <!-- Hero Header Section (Panoramic Banner with Overlapping Card matching yayasan.astro) -->
    <section class="relative font-sans pb-6 sm:pb-10">
      <!-- Panoramic Banner -->
      <div class="relative w-full h-[320px] sm:h-[380px] lg:h-[420px] overflow-hidden bg-slate-950">
        <img 
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuCavFC-99FADJK6mO15qdRLjoreFX-FK3DeOp-_BK11xqeikKtizE4CjRMes2HaSlT6lx-2Yl_6SF53rsp0awfSaGCJ_Yw1xg-jEwYgrEiUN4d29JRAEZ8jF2iBGfZceSjU6rQrSR-0aoc9vP060egOHlfluZTT0I1VU-IECfDv87L0YYmQ_Cv0qKeVfJSoQJYcJfve44NMj6h3ldF3T9lG1XF1vg4KBpuLs-10nqCanmN97hm9jfmyjg"
          alt="Gedung Kantor dan Pusat Pelayanan Yayasan Pendidikan Pesantren Sunan Kudus" 
          class="w-full h-full object-cover object-center opacity-80"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/35 to-brand-emeraldDark/25"></div>
      </div>

      <!-- Overlapping Profile Header Card -->
      <div class="max-w-4xl mx-auto px-4 sm:px-6 -mt-20 sm:-mt-24 lg:-mt-28 relative z-20" data-aos="fade-up">
        <div class="bg-white/95 backdrop-blur-md rounded-3xl p-8 sm:p-12 shadow-soft border border-slate-200/90 text-center">
          <span class="badge-pill bg-brand-iceBlue text-brand-emerald border border-brand-mint font-sans mb-4 inline-flex items-center gap-1.5">
            <span class="material-symbols-outlined text-sm">support_agent</span>
            Amanah • Tumbuh • Unggul
          </span>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-slate-900 leading-tight font-sans">
            Hubungi Kami
          </h1>

          <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed font-sans font-normal italic">
            Kami senantiasa terbuka untuk menjalin komunikasi, menjawab pertanyaan, serta menyambut aspirasi Anda demi kemajuan pendidikan dan sosial keagamaan.
          </p>
        </div>
      </div>
    </section>

    <!-- Main Content Area: Bento-style Grid -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 contact-animate font-sans">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Contact Info Cards (Left Side, 5 Cols) -->
        <div class="lg:col-span-5 space-y-6">
          <!-- Card: Address -->
          <address class="not-italic bg-white p-7 sm:p-8 rounded-3xl shadow-soft border border-slate-200/80 group hover:shadow-lg transition transform hover:-translate-y-1 block font-sans">
            <div class="flex items-start gap-5">
              <div class="w-12 h-12 rounded-2xl bg-brand-iceBlue text-brand-emerald flex items-center justify-center shrink-0 text-2xl group-hover:scale-110 group-hover:bg-brand-emerald group-hover:text-white transition-all">
                <span class="material-symbols-outlined">location_on</span>
              </div>
              <div>
                <h3 class="font-bold text-lg text-slate-900 mb-1 font-sans">Alamat Kantor</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans">
                  Jln. Madurekso No. 22, Langgar Dalem, <br/>Kota Kudus, Jawa Tengah
                </p>
              </div>
            </div>
          </address>

          <!-- Card: Phone -->
          <address class="not-italic bg-white p-7 sm:p-8 rounded-3xl shadow-soft border border-slate-200/80 group hover:shadow-lg transition transform hover:-translate-y-1 block font-sans">
            <div class="flex items-start gap-5">
              <div class="w-12 h-12 rounded-2xl bg-brand-mint text-brand-emeraldDark flex items-center justify-center shrink-0 text-2xl group-hover:scale-110 group-hover:bg-brand-emerald group-hover:text-white transition-all">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">call</span>
              </div>
              <div>
                <h3 class="font-bold text-lg text-slate-900 mb-1 font-sans">Telepon &amp; WA</h3>
                <div class="space-y-1">
                  <p class="text-xs sm:text-sm text-slate-600 font-sans">
                    <a href="tel:+622155551234" class="hover:text-brand-emerald transition-colors font-medium">+62 21 5555 1234</a>
                  </p>
                  <p class="text-xs sm:text-sm text-slate-600 font-sans">
                    <a href="https://wa.me/6281234567890" target="_blank" rel="noopener noreferrer" class="hover:text-brand-emerald transition-colors font-medium">+62 812 3456 7890</a>
                  </p>
                </div>
              </div>
            </div>
          </address>

          <!-- Card: Email -->
          <address class="not-italic bg-white p-7 sm:p-8 rounded-3xl shadow-soft border border-slate-200/80 group hover:shadow-lg transition transform hover:-translate-y-1 block font-sans">
            <div class="flex items-start gap-5">
              <div class="w-12 h-12 rounded-2xl bg-brand-warmYellow text-amber-900 flex items-center justify-center shrink-0 text-2xl group-hover:scale-110 group-hover:bg-amber-600 group-hover:text-white transition-all">
                <span class="material-symbols-outlined">mail</span>
              </div>
              <div>
                <h3 class="font-bold text-lg text-slate-900 mb-1 font-sans">Email Resmi</h3>
                <div class="space-y-1">
                  <p class="text-xs sm:text-sm text-slate-600 font-sans">
                    <a href="mailto:info@yp2sk.or.id" class="hover:text-brand-emerald transition-colors font-medium">info@yp2sk.or.id</a>
                  </p>
                  <p class="text-xs sm:text-sm text-slate-600 font-sans">
                    <a href="mailto:humas@yp2sk.or.id" class="hover:text-brand-emerald transition-colors font-medium">humas@yp2sk.or.id</a>
                  </p>
                </div>
              </div>
            </div>
          </address>
        </div>

        <!-- Message Form (Right Side, 7 Cols) -->
        <div class="lg:col-span-7">
          <div class="bg-white p-8 sm:p-10 rounded-3xl shadow-soft border border-slate-200/80 relative overflow-hidden h-full font-sans">
            <div class="absolute top-0 right-0 w-32 h-32 bg-brand-mint/30 rounded-full -mr-16 -mt-16 pointer-events-none"></div>
            
            <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2 font-sans">Kirim Pesan</h2>
            <p class="text-xs sm:text-sm text-slate-600 mb-8 leading-relaxed font-sans">
              Punya pertanyaan seputar kurikulum, donasi, atau kemitraan? Sampaikan pesan Anda melalui formulir di bawah ini.
            </p>
            
            <form id="contact-form" class="space-y-5 font-sans">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                  <label for="input-nama" class="block text-xs font-semibold text-slate-700 mb-1.5 font-sans">Nama Lengkap</label>
                  <input id="input-nama" name="nama" type="text" required class="w-full bg-slate-50 border border-slate-200/90 focus:border-brand-emerald focus:ring-2 focus:ring-brand-emerald/20 focus:bg-white rounded-2xl p-3.5 text-xs sm:text-sm transition-all outline-none font-sans text-slate-800" placeholder="Masukkan nama Anda"/>
                </div>
                <div>
                  <label for="input-email" class="block text-xs font-semibold text-slate-700 mb-1.5 font-sans">Email Aktif</label>
                  <input id="input-email" name="email" type="email" required class="w-full bg-slate-50 border border-slate-200/90 focus:border-brand-emerald focus:ring-2 focus:ring-brand-emerald/20 focus:bg-white rounded-2xl p-3.5 text-xs sm:text-sm transition-all outline-none font-sans text-slate-800" placeholder="nama@email.com"/>
                </div>
              </div>
              
              <div>
                <label for="input-subjek" class="block text-xs font-semibold text-slate-700 mb-1.5 font-sans">Subjek</label>
                <select id="input-subjek" name="subjek" class="w-full bg-slate-50 border border-slate-200/90 focus:border-brand-emerald focus:ring-2 focus:ring-brand-emerald/20 focus:bg-white rounded-2xl p-3.5 text-xs sm:text-sm transition-all outline-none font-sans text-slate-800 cursor-pointer">
                  <option value="PMB">Informasi Pendaftaran (PMB)</option>
                  <option value="Kerjasama">Kerjasama &amp; Donasi</option>
                  <option value="Akademik">Informasi Akademik</option>
                  <option value="Lainnya">Lainnya</option>
                </select>
              </div>

              <div>
                <label for="input-pesan" class="block text-xs font-semibold text-slate-700 mb-1.5 font-sans">Pesan Anda</label>
                <textarea id="input-pesan" name="pesan" rows="5" required class="w-full bg-slate-50 border border-slate-200/90 focus:border-brand-emerald focus:ring-2 focus:ring-brand-emerald/20 focus:bg-white rounded-2xl p-3.5 text-xs sm:text-sm transition-all outline-none font-sans text-slate-800 resize-y" placeholder="Tuliskan pesan atau pertanyaan Anda di sini..."></textarea>
              </div>

              <button id="btn-kirim" class="w-full md:w-auto px-8 py-3.5 rounded-full bg-brand-emerald text-white hover:bg-brand-emeraldDark font-bold text-xs sm:text-sm shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 active:scale-95 flex items-center justify-center gap-2 cursor-pointer font-sans" type="submit">
                <span>Kirim Pesan</span>
                <span class="material-symbols-outlined text-[18px]">send</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- Location Map Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 contact-animate font-sans">
      <div class="text-center mb-10" data-aos="fade-up">
        <span class="badge-pill bg-brand-iceBlue text-brand-emerald mb-3 border border-brand-mint font-sans">
          Lokasi Kampus
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-900 tracking-tight leading-snug font-sans">
          Lokasi Kampus Utama
        </h2>
        <div class="w-16 h-1 bg-brand-emerald mx-auto rounded-full mt-3"></div>
        <p class="text-xs sm:text-sm text-slate-600 mt-3 italic font-sans">Kunjungi pusat pendidikan dan administrasi kami.</p>
      </div>

      <div class="w-full h-[450px] rounded-3xl overflow-hidden shadow-soft relative border border-slate-200/80">
        <!-- Placeholder for Map Injection -->
        <div class="absolute inset-0 bg-slate-900 flex items-center justify-center">
          <div class="absolute inset-0 bg-cover bg-center" aria-label="Peta lokasi Yayasan Pendidikan Pesantren Sunan Kudus di Jln. Madurekso No. 22, Langgar Dalem, Kota Kudus, Jawa Tengah" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBtWZICZXhmBS6cMwuezEgrCBFpaehCO8ylwcbzzfOKANcg8z_E9qsGeFnDTDFk3NsTurPmy2_KVxCjiQS4ADpINDNlmMJ2zdpncp8iD5-cEGoVY9tqPv3nBJ-j5ARfeK22hDqnXR4lLFOo734ZusddH4fx_7WT8Tr5-dntuwuJaaabL-230CBxurYztsOsnNUADiu0EVLf_58-pYjqI6X5RPNtCHypVbmKcu06fNkfgwq2hahUPbkSzw')"></div>
          
          <!-- Overlay Marker Info -->
          <div class="relative z-10 bg-white/95 backdrop-blur-md p-6 sm:p-7 rounded-3xl shadow-xl max-w-[280px] text-center border border-slate-200/90 font-sans">
            <span class="material-symbols-outlined text-brand-emerald text-4xl mb-1 inline-block" style="font-variation-settings: 'FILL' 1;">location_on</span>
            <h4 class="font-bold text-lg text-slate-900 font-sans">YP2SK HQ</h4>
            <p class="text-xs text-slate-600 mt-1 font-sans">Jln. Madurekso No. 22, Langgar Dalem</p>
            <a href="https://maps.google.com/?q=Jln.+Madurekso+No.+22,+Langgar+Dalem,+Kota+Kudus,+Jawa+Tengah" target="_blank" rel="noopener noreferrer" class="inline-block mt-4 bg-brand-emerald text-white text-xs font-bold px-5 py-2 rounded-full cursor-pointer hover:bg-brand-emeraldDark transition-colors shadow-xs">Buka di Maps</a>
          </div>
        </div>
        <!-- Actual Data Location for system hook -->
        <div class="hidden" data-location="Jln. Madurekso No. 22, Langgar Dalem, Kota Kudus, Jawa Tengah"></div>
      </div>
    </section>

    <!-- Quick FAQ / Support Section (Styled matching yayasan.astro & PreFooter.astro) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 font-sans contact-animate" data-aos="fade-up">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-slate-950 via-brand-emeraldDark to-brand-emerald text-white p-8 sm:p-12 shadow-xl border border-white/10 text-center">
        <!-- Decorative Watermark & Ambient Glow matching yayasan.astro -->
        <div class="absolute -right-8 -bottom-10 text-white/5 select-none pointer-events-none font-serif text-[140px] leading-none">
          ق
        </div>
        <div class="absolute -top-16 -left-16 w-64 h-64 bg-brand-emerald/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 max-w-2xl mx-auto space-y-4">
          <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white/10 text-brand-mint text-xs font-semibold uppercase tracking-wider mb-2 border border-white/15 backdrop-blur-xs font-sans">
            Pusat Bantuan &amp; Konsultasi
          </span>

          <h2 class="text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight text-white leading-snug font-sans">
            Butuh Respon Cepat?
          </h2>

          <p class="text-xs sm:text-sm text-slate-200 leading-relaxed font-light max-w-2xl mx-auto">
            Layanan WhatsApp kami aktif pada jam kerja (Senin-Jumat, 08:00 - 16:00 WIB) untuk konsultasi pendaftaran siswa baru.
          </p>

          <div class="pt-4 flex justify-center">
            <a 
              class="w-full sm:w-auto px-8 py-3 rounded-full bg-white text-slate-900 hover:bg-slate-100 font-bold text-xs sm:text-sm shadow-md transition transform hover:-translate-y-0.5 flex items-center justify-center gap-2 whitespace-nowrap cursor-pointer" 
              href="https://wa.me/6281234567890" 
              target="_blank" 
              rel="noopener noreferrer" 
              title="Hubungi kami melalui WhatsApp"
            >
              <span class="material-symbols-outlined text-base">chat</span>
              Hubungi via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  function setupContactPage() {
    // Form submit interaction
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const btnKirim = document.getElementById('btn-kirim') as HTMLButtonElement | null;
    if (form && btnKirim) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const originalText = btnKirim.innerHTML;
        btnKirim.disabled = true;
        btnKirim.innerHTML = '<span>Mengirim...</span>';
        
        try {
          const formData = new FormData(form);
          const data = Object.fromEntries(formData.entries());
          
          // Simulasi pengiriman data ke server untuk demo statis
          await new Promise((resolve) => setTimeout(resolve, 1200));
          
          alert('Pesan Anda telah terkirim! Tim kami akan segera menghubungi Anda. (Demo Mode)');
          form.reset();
        } catch (error) {
          console.error('Error submitting form:', error);
          alert('Terjadi kesalahan saat mengirim pesan.');
        } finally {
          btnKirim.disabled = false;
          btnKirim.innerHTML = originalText;
        }
      });
    }

    // Scroll Fade-in Animation
    const observerOptions = {
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('opacity-100', 'translate-y-0');
          entry.target.classList.remove('opacity-0', 'translate-y-8');
        }
      });
    }, observerOptions);

    const animatedElements = document.querySelectorAll('.contact-animate');
    animatedElements.forEach(el => {
      el.classList.add('transition-all', 'duration-700', 'opacity-0', 'translate-y-8');
      observer.observe(el);
    });
  }

  // Initial load execution
  setupContactPage();
  // View transitions support
  document.addEventListener('astro:after-swap', setupContactPage);
</script>
