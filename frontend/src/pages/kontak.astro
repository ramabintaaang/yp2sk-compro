---
import Layout from '../layouts/Layout.astro';

const contactSchema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://yp2sk.or.id"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Hubungi Kami",
        "item": "https://yp2sk.or.id/kontak"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "School",
    "@id": "https://yp2sk.or.id/#school",
    "name": "Yayasan Pendidikan Pesantren Sunan Kudus (YP2SK)",
    "url": "https://yp2sk.or.id",
    "logo": "https://yp2sk.or.id/favicon.svg",
    "image": "https://yp2sk.or.id/og-image.png",
    "description": "Hubungi YP2SK untuk informasi pendaftaran siswa baru (PMB), kerjasama, donasi, dan program yayasan. Dapatkan alamat kantor, email, dan kontak WhatsApp resmi kami.",
    "telephone": "+62-21-5555-1234",
    "email": "info@yp2sk.or.id",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Jl. Pembangunan No. 123",
      "addressLocality": "Kota Pendidikan",
      "addressRegion": "Jawa Tengah",
      "postalCode": "12345",
      "addressCountry": "ID"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": "-6.8048",
      "longitude": "110.8404"
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday"
      ],
      "opens": "08:00",
      "closes": "16:00"
    }
  }
];
---

<Layout 
  title="Hubungi Kami | YP2SK - Yayasan Pendidikan Pesantren Sunan Kudus" 
  description="Hubungi YP2SK untuk informasi pendaftaran siswa baru (PMB), kerjasama, donasi, dan program yayasan. Dapatkan alamat kantor, email, dan kontak WhatsApp resmi kami."
  schema={contactSchema}
>
  <div class="pt-20">
    <!-- Hero Header Section -->
    <header class="relative overflow-hidden bg-surface py-xl border-b border-outline-variant/30 contact-animate">
      <div class="absolute inset-0 bg-pattern opacity-50"></div>
      <div class="max-w-[1140px] mx-auto px-margin-mobile md:px-margin-desktop relative z-10 text-center">
        <span class="inline-block px-md py-1 rounded-full bg-secondary-container text-on-secondary-container text-label-md uppercase tracking-wider mb-sm">Amanah • Tumbuh • Unggul</span>
        <h1 class="font-headline-xl text-headline-xl-mobile md:text-headline-xl text-primary mb-md">Hubungi Kami</h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-[42rem] mx-auto italic">
          Kami senantiasa terbuka untuk menjalin komunikasi, menjawab pertanyaan, serta menyambut aspirasi Anda demi kemajuan pendidikan dan sosial keagamaan.
        </p>
      </div>
    </header>

    <!-- Main Content Area: Bento-style Grid -->
    <section class="py-xl max-w-[1140px] mx-auto px-margin-mobile md:px-margin-desktop contact-animate">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
        <!-- Contact Info Cards (Left Side) -->
        <div class="lg:col-span-5 space-y-gutter">
          <!-- Card: Address -->
          <address class="not-italic bg-surface-container-lowest p-lg rounded-xl shadow-sm border border-outline-variant/10 group hover:shadow-md transition-all duration-300 block">
            <div class="flex items-start gap-md">
              <div class="p-sm bg-primary-container text-on-primary-container rounded-lg group-hover:bg-primary transition-colors">
                <span class="material-symbols-outlined">location_on</span>
              </div>
              <div>
                <h3 class="font-headline-md text-headline-md text-primary mb-xs">Alamat Kantor</h3>
                <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                  Jl. Pembangunan No. 123, <br/>Kota Pendidikan, Indonesia 12345
                </p>
              </div>
            </div>
          </address>

          <!-- Card: Phone -->
          <address class="not-italic bg-surface-container-lowest p-lg rounded-xl shadow-sm border border-outline-variant/10 group hover:shadow-md transition-all duration-300 block">
            <div class="flex items-start gap-md">
              <div class="p-sm bg-secondary-container text-on-secondary-container rounded-lg group-hover:bg-secondary transition-colors">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">call</span>
              </div>
              <div>
                <h3 class="font-headline-md text-headline-md text-primary mb-xs">Telepon &amp; WA</h3>
                <div class="space-y-1">
                  <p class="font-body-md text-body-md text-on-surface-variant">
                    <a href="tel:+622155551234" class="hover:text-primary transition-colors font-medium">+62 21 5555 1234</a>
                  </p>
                  <p class="font-body-md text-body-md text-on-surface-variant">
                    <a href="https://wa.me/6281234567890" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors font-medium">+62 812 3456 7890</a>
                  </p>
                </div>
              </div>
            </div>
          </address>

          <!-- Card: Email -->
          <address class="not-italic bg-surface-container-lowest p-lg rounded-xl shadow-sm border border-outline-variant/10 group hover:shadow-md transition-all duration-300 block">
            <div class="flex items-start gap-md">
              <div class="p-sm bg-tertiary-fixed text-on-tertiary-fixed rounded-lg group-hover:bg-tertiary-container group-hover:text-on-tertiary-container transition-colors">
                <span class="material-symbols-outlined">mail</span>
              </div>
              <div>
                <h3 class="font-headline-md text-headline-md text-primary mb-xs">Email Resmi</h3>
                <div class="space-y-1">
                  <p class="font-body-md text-body-md text-on-surface-variant">
                    <a href="mailto:info@yp2sk.or.id" class="hover:text-primary transition-colors font-medium">info@yp2sk.or.id</a>
                  </p>
                  <p class="font-body-md text-body-md text-on-surface-variant">
                    <a href="mailto:humas@yp2sk.or.id" class="hover:text-primary transition-colors font-medium">humas@yp2sk.or.id</a>
                  </p>
                </div>
              </div>
            </div>
          </address>
        </div>

        <!-- Message Form (Right Side) -->
        <div class="lg:col-span-7">
          <div class="bg-white p-lg md:p-xl rounded-xl shadow-lg border border-outline-variant/10 relative overflow-hidden h-full">
            <div class="absolute top-0 right-0 w-32 h-32 bg-secondary/5 rounded-full -mr-16 -mt-16"></div>
            <h2 class="font-headline-lg text-headline-lg text-primary mb-md">Kirim Pesan</h2>
            <p class="font-body-md text-body-md text-on-surface-variant mb-lg">
              Punya pertanyaan seputar kurikulum, donasi, atau kemitraan? Sampaikan pesan Anda melalui formulir di bawah ini.
            </p>
            <form id="contact-form" class="space-y-md">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
                <div>
                  <label for="input-nama" class="block font-label-lg text-label-lg text-on-surface-variant mb-xs">Nama Lengkap</label>
                  <input id="input-nama" name="nama" type="text" required class="w-full bg-surface-container-low border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 rounded-lg p-sm font-body-md transition-all outline-none" placeholder="Masukkan nama Anda"/>
                </div>
                <div>
                  <label for="input-email" class="block font-label-lg text-label-lg text-on-surface-variant mb-xs">Email Aktif</label>
                  <input id="input-email" name="email" type="email" required class="w-full bg-surface-container-low border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 rounded-lg p-sm font-body-md transition-all outline-none" placeholder="nama@email.com"/>
                </div>
              </div>
              <div>
                <label for="input-subjek" class="block font-label-lg text-label-lg text-on-surface-variant mb-xs">Subjek</label>
                <select id="input-subjek" name="subjek" class="w-full bg-surface-container-low border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 rounded-lg p-sm font-body-md transition-all outline-none">
                  <option value="PMB">Informasi Pendaftaran (PMB)</option>
                  <option value="Kerjasama">Kerjasama &amp; Donasi</option>
                  <option value="Akademik">Informasi Akademik</option>
                  <option value="Lainnya">Lainnya</option>
                </select>
              </div>
              <div>
                <label for="input-pesan" class="block font-label-lg text-label-lg text-on-surface-variant mb-xs">Pesan Anda</label>
                <textarea id="input-pesan" name="pesan" rows="5" required class="w-full bg-surface-container-low border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 rounded-lg p-sm font-body-md transition-all outline-none" placeholder="Tuliskan pesan atau pertanyaan Anda di sini..."></textarea>
              </div>
              <button id="btn-kirim" class="w-full md:w-auto bg-primary text-on-primary font-label-lg px-xl py-md rounded-lg shadow-md hover:bg-primary-container hover:shadow-lg transition-all transform active:scale-95 flex items-center justify-center gap-sm cursor-pointer" type="submit">
                <span>Kirim Pesan</span>
                <span class="material-symbols-outlined text-[18px]">send</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- Location Map Section -->
    <section class="py-xl bg-surface-container contact-animate">
      <div class="max-w-[1140px] mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="text-center mb-lg">
          <h2 class="font-headline-lg text-headline-lg text-primary">Lokasi Kampus Utama</h2>
          <p class="font-body-md text-body-md text-on-surface-variant mt-xs italic">Kunjungi pusat pendidikan dan administrasi kami.</p>
        </div>
        <div class="w-full h-[450px] rounded-2xl overflow-hidden shadow-2xl relative border-4 border-white">
          <!-- Placeholder for Map Injection -->
          <div class="absolute inset-0 bg-surface-dim flex items-center justify-center">
            <div class="absolute inset-0 bg-cover bg-center" aria-label="Peta satelit profesional dan ilustrasi peta bergaya yang menunjukkan kampus pendidikan modern YP2SK dengan bangunan putih bersih, taman hijau zamrud, dan jalan akses yang ditandai dengan jelas di Kota Pendidikan, Indonesia." style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBtWZICZXhmBS6cMwuezEgrCBFpaehCO8ylwcbzzfOKANcg8z_E9qsGeFnDTDFk3NsTurPmy2_KVxCjiQS4ADpINDNlmMJ2zdpncp8iD5-cEGoVY9tqPv3nBJ-j5ARfeK22hDqnXR4lLFOo734ZusddH4fx_7WT8Tr5-dntuwuJaaabL-230CBxurYztsOsnNUADiu0EVLf_58-pYjqI6X5RPNtCHypVbmKcu06fNkfgwq2hahUPbkSzw')"></div>
            <!-- Overlay Marker Info -->
            <div class="relative z-10 bg-white/90 backdrop-blur-md p-md rounded-xl shadow-xl max-w-[280px] text-center border border-primary/20">
              <span class="material-symbols-outlined text-secondary text-4xl mb-xs" style="font-variation-settings: 'FILL' 1;">location_on</span>
              <h4 class="font-headline-md text-primary">YP2SK HQ</h4>
              <p class="font-body-sm text-on-surface-variant">Kampus Terpadu &amp; Gedung Pusat</p>
              <a href="https://maps.google.com/?q=Kota+Pendidikan,+Indonesia" target="_blank" rel="noopener noreferrer" class="inline-block mt-sm bg-secondary text-white text-label-md px-md py-xs rounded-full cursor-pointer hover:bg-on-secondary-container transition-colors">Buka di Maps</a>
            </div>
          </div>
          <!-- Actual Data Location for system hook -->
          <div class="hidden" data-location="Kota Pendidikan, Indonesia"></div>
        </div>
      </div>
    </section>

    <!-- Quick FAQ / Support Section -->
    <section class="py-xl max-w-[1140px] mx-auto px-margin-mobile md:px-margin-desktop text-center contact-animate">
      <div class="bg-primary-container p-xl rounded-2xl relative overflow-hidden group">
        <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-secondary/20 rounded-full blur-3xl transition-all group-hover:scale-150"></div>
        <div class="relative z-10">
          <h2 class="font-headline-md text-white mb-sm">Butuh Respon Cepat?</h2>
          <p class="font-body-md opacity-90 max-w-[32rem] mx-auto mb-lg text-white">
            Layanan WhatsApp kami aktif pada jam kerja (Senin-Jumat, 08:00 - 16:00 WIB) untuk konsultasi pendaftaran siswa baru.
          </p>
          <a class="inline-flex items-center gap-sm bg-secondary text-on-secondary px-lg py-md rounded-full font-label-lg hover:bg-on-secondary-container transition-colors shadow-lg cursor-pointer" href="https://wa.me/6281234567890" target="_blank" rel="noopener noreferrer" title="Hubungi kami melalui WhatsApp">
            <span class="material-symbols-outlined">chat</span>
            Hubungi via WhatsApp
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .bg-pattern {
    background-image: radial-gradient(circle at 2px 2px, var(--color-surface-container-highest) 1px, transparent 0);
    background-size: 32px 32px;
  }
</style>

<script>
  function setupContactPage() {
    // Form submit interaction
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const btnKirim = document.getElementById('btn-kirim') as HTMLButtonElement | null;
    if (form && btnKirim) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const originalText = btnKirim.innerHTML;
        btnKirim.disabled = true;
        btnKirim.innerHTML = '<span>Mengirim...</span>';
        
        try {
          const formData = new FormData(form);
          const data = Object.fromEntries(formData.entries());
          
          // Simulasi pengiriman data ke server untuk demo statis
          await new Promise((resolve) => setTimeout(resolve, 1200));
          
          alert('Pesan Anda telah terkirim! Tim kami akan segera menghubungi Anda. (Demo Mode)');
          form.reset();
        } catch (error) {
          console.error('Error submitting form:', error);
          alert('Terjadi kesalahan saat mengirim pesan.');
        } finally {
          btnKirim.disabled = false;
          btnKirim.innerHTML = originalText;
        }
      });
    }

    // Scroll Fade-in Animation
    const observerOptions = {
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('opacity-100', 'translate-y-0');
          entry.target.classList.remove('opacity-0', 'translate-y-8');
        }
      });
    }, observerOptions);

    const animatedElements = document.querySelectorAll('.contact-animate');
    animatedElements.forEach(el => {
      el.classList.add('transition-all', 'duration-700', 'opacity-0', 'translate-y-8');
      observer.observe(el);
    });
  }

  // Initial load execution
  setupContactPage();
  // View transitions support
  document.addEventListener('astro:after-swap', setupContactPage);
</script>
