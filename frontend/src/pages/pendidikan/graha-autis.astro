---
import Layout from '../../layouts/Layout.astro';

const grahaAutisSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://yp2sk.or.id/pendidikan/graha-autis#webpage",
      "url": "https://yp2sk.or.id/pendidikan/graha-autis",
      "name": "Graha Autis | Pusat Terapi Anak Berkebutuhan Khusus YP2SK",
      "description": "Layanan terapi terpadu untuk anak autisme dan berkebutuhan khusus di Graha Autis YP2SK. Menyediakan terapi wicara, okupasi, perilaku, dan sensomotorik.",
      "breadcrumb": {
        "@id": "https://yp2sk.or.id/pendidikan/graha-autis#breadcrumb"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://yp2sk.or.id/pendidikan/graha-autis#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Beranda",
          "item": "https://yp2sk.or.id"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Pendidikan",
          "item": "https://yp2sk.or.id/pendidikan/graha-autis"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Graha Autis",
          "item": "https://yp2sk.or.id/pendidikan/graha-autis"
        }
      ]
    },
    {
      "@type": "MedicalBusiness",
      "@id": "https://yp2sk.or.id/pendidikan/graha-autis#clinic",
      "name": "Graha Autis YP2SK (Therapy Anak Berkebutuhan Khusus)",
      "description": "Pusat klinik terapi tumbuh kembang khusus untuk anak dengan spektrum autisme, ADHD, dan keterlambatan perkembangan di bawah naungan YP2SK.",
      "image": "https://yp2sk.or.id/images/graha_autis.png",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Jl. Pendidikan No. 123",
        "addressLocality": "Kota Dinado",
        "addressCountry": "ID"
      }
    }
  ]
};
---

<Layout 
  title="Graha Autis | Terapi Anak Berkebutuhan Khusus Terpadu - YP2SK" 
  description="Graha Autis menyediakan pusat terapi komprehensif (wicara, okupasi, sensomotorik, perilaku) dengan terapis tersertifikasi untuk melatih kemandirian anak berkebutuhan khusus."
  schema={grahaAutisSchema}
>
  <div class="pt-20">
    <!-- Hero Section -->
    <section class="relative h-[65vh] min-h-[500px] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <div 
          class="w-full h-full bg-cover bg-center" 
          style="background-image: linear-gradient(rgba(0, 32, 69, 0.8), rgba(0, 32, 69, 0.65)), url('/images/graha_autis.png');"
          role="img"
          aria-label="A modern, warm sensory room at Graha Autis with therapeutic equipment"
        ></div>
      </div>
      <div class="relative z-10 text-center text-on-primary px-margin-mobile md:px-margin-desktop">
        <span class="inline-block px-4 py-1.5 bg-secondary text-on-secondary rounded-full font-label-lg text-label-lg mb-sm uppercase tracking-widest shadow-sm">Pusat Terapi Anak Berkebutuhan Khusus</span>
        <h1 class="font-headline-xl text-headline-xl-mobile md:text-headline-xl max-w-[56rem] mx-auto mb-md text-white leading-tight">Graha Autis</h1>
        <p class="font-body-lg text-body-lg max-w-[42rem] mx-auto text-on-primary/90 leading-relaxed mb-lg">
          Membimbing anak dengan spektrum autisme menuju kemandirian perilaku, komunikasi, dan motorik melalui terapi terintegrasi yang dipandu oleh ahli berpengalaman.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/kontak" class="w-full sm:w-auto text-center bg-secondary text-on-secondary px-8 py-3.5 rounded-lg font-label-lg font-bold hover:brightness-110 active:scale-95 transition-all shadow-md">
            Konsultasi Sekarang
          </a>
          <a href="#layanan-terapi" class="w-full sm:w-auto text-center border-2 border-white/30 text-white px-8 py-3.5 rounded-lg font-label-lg font-bold hover:bg-white/10 transition-all">
            Lihat Program Terapi
          </a>
        </div>
      </div>
    </section>

    <!-- Overview Section & Stats -->
    <section class="py-xl px-margin-mobile md:px-margin-desktop max-w-[1140px] mx-auto reveal-element">
      <div class="grid md:grid-cols-2 gap-xl items-center">
        <div class="space-y-md">
          <span class="text-secondary font-label-lg uppercase tracking-wider block font-bold">Tentang Graha Autis</span>
          <h2 class="font-headline-lg text-headline-lg text-primary">Layanan Terapi Individual untuk Tumbuh Kembang Mandiri</h2>
          <p class="text-on-surface-variant font-body-md leading-relaxed">
            Graha Autis didirikan sebagai pusat intervensi dini yang terintegrasi bagi anak-anak berkebutuhan khusus, terutama penyandang spektrum autisme (ASD), ADHD, Down Syndrome, dan keterlambatan wicara (speech delay). Kami percaya bahwa dengan deteksi dini dan stimulasi terapi yang terarah, setiap anak memiliki peluang besar untuk berkembang secara optimal dan mandiri.
          </p>
          <p class="text-on-surface-variant font-body-md leading-relaxed">
            Tim kami terdiri dari psikolog perkembangan anak, terapis wicara, terapis okupasi, dan okupasional ortopedik yang berpengalaman. Setiap anak yang masuk akan melewati proses asesmen komprehensif terlebih dahulu untuk merumuskan Program Terapi Individual (PTI) yang disesuaikan dengan kebutuhan unik sang anak.
          </p>
          
          <!-- Key Specs Grid -->
          <div class="grid grid-cols-2 gap-sm pt-4 border-t border-outline-variant/30">
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-secondary text-3xl shrink-0">clinical_notes</span>
              <div>
                <p class="text-[12px] text-on-surface-variant font-bold uppercase m-0 leading-none">Sesi Terapi</p>
                <p class="font-headline-md text-primary m-0">1-on-1 Privat</p>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-secondary text-3xl shrink-0">psychology</span>
              <div>
                <p class="text-[12px] text-on-surface-variant font-bold uppercase m-0 leading-none">Asesmen</p>
                <p class="font-headline-md text-primary m-0">Berkala 3 Bulan</p>
              </div>
            </div>
          </div>
        </div>
        <div class="relative group">
          <div class="absolute -top-4 -right-4 w-full h-full border-2 border-secondary rounded-xl z-0"></div>
          <div class="relative z-10 overflow-hidden rounded-xl shadow-lg aspect-[4/3] bg-surface-container-low">
            <img 
              class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700" 
              alt="Therapist helping a child in a therapy room at Graha Autis" 
              src="/images/graha_autis.png"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section id="layanan-terapi" class="py-xl bg-surface-container-low scroll-mt-24">
      <div class="max-w-[1140px] mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="text-center mb-xl reveal-element">
          <span class="text-secondary font-label-lg uppercase tracking-wider block font-bold mb-xs">Layanan Intervensi</span>
          <h2 class="font-headline-lg text-headline-lg text-primary">Program Terapi Unggulan Kami</h2>
          <div class="w-16 h-1 bg-secondary mx-auto rounded-full mt-sm"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-gutter">
          <!-- Terapi Wicara -->
          <div class="bg-white p-lg rounded-xl shadow-sm border border-outline-variant/10 hover:shadow-md transition-all duration-300 reveal-element">
            <div class="w-12 h-12 bg-secondary-container flex items-center justify-center rounded-lg mb-md text-secondary">
              <span class="material-symbols-outlined text-3xl">record_voice_over</span>
            </div>
            <h3 class="font-headline-md text-headline-md text-primary mb-xs">Terapi Wicara</h3>
            <p class="text-on-surface-variant text-sm leading-relaxed">
              Melatih kefasihan artikulasi, pemahaman bahasa reseptif dan ekspresif, kontak mata saat berbicara, serta kemampuan berkomunikasi dua arah secara fungsional.
            </p>
          </div>

          <!-- Terapi Okupasi -->
          <div class="bg-white p-lg rounded-xl shadow-sm border border-outline-variant/10 hover:shadow-md transition-all duration-300 reveal-element">
            <div class="w-12 h-12 bg-secondary-container flex items-center justify-center rounded-lg mb-md text-secondary">
              <span class="material-symbols-outlined text-3xl">hand_gesture</span>
            </div>
            <h3 class="font-headline-md text-headline-md text-primary mb-xs">Terapi Okupasi</h3>
            <p class="text-on-surface-variant text-sm leading-relaxed">
              Meningkatkan kemandirian motorik halus (memegang pensil, menyendok makanan, mengancing baju) agar anak dapat melakukan aktivitas hidup sehari-hari.
            </p>
          </div>

          <!-- Terapi Sensori Integrasi -->
          <div class="bg-white p-lg rounded-xl shadow-sm border border-outline-variant/10 hover:shadow-md transition-all duration-300 reveal-element">
            <div class="w-12 h-12 bg-secondary-container flex items-center justify-center rounded-lg mb-md text-secondary">
              <span class="material-symbols-outlined text-3xl">adjust</span>
            </div>
            <h3 class="font-headline-md text-headline-md text-primary mb-xs">Sensori Integrasi</h3>
            <p class="text-on-surface-variant text-sm leading-relaxed">
              Membantu anak yang mengalami hipersensitif atau hiposensitif terhadap stimulasi suara, tekstur, cahaya, dan melatih keseimbangan tubuh (vestibular/proprioseptif).
            </p>
          </div>

          <!-- Terapi Perilaku (ABA) -->
          <div class="bg-white p-lg rounded-xl shadow-sm border border-outline-variant/10 hover:shadow-md transition-all duration-300 reveal-element">
            <div class="w-12 h-12 bg-secondary-container flex items-center justify-center rounded-lg mb-md text-secondary">
              <span class="material-symbols-outlined text-3xl">diversity_3</span>
            </div>
            <h3 class="font-headline-md text-headline-md text-primary mb-xs">Terapi Perilaku (ABA)</h3>
            <p class="text-on-surface-variant text-sm leading-relaxed">
              Menggunakan metode *Applied Behavior Analysis* (ABA) untuk meminimalkan perilaku tantrum, melatih kepatuhan instruksi, dan meningkatkan keterampilan interaksi sosial.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-xl bg-white reveal-element">
      <div class="max-w-[800px] mx-auto px-margin-mobile">
        <div class="text-center mb-xl">
          <span class="text-secondary font-label-lg uppercase tracking-wider block font-bold mb-xs">FAQ</span>
          <h2 class="font-headline-lg text-headline-lg text-primary">Pertanyaan Seputar Layanan Terapi</h2>
          <div class="w-16 h-1 bg-secondary mx-auto rounded-full mt-sm"></div>
        </div>

        <div class="space-y-4">
          <!-- FAQ 1 -->
          <div class="faq-item border border-outline-variant/35 rounded-xl bg-white overflow-hidden transition-all duration-300">
            <button class="faq-toggle w-full p-md md:p-lg flex items-center justify-between text-left font-bold text-primary hover:bg-surface transition-colors cursor-pointer">
              <span>Bagaimana proses awal pendaftaran terapi di Graha Autis?</span>
              <span class="material-symbols-outlined transition-transform duration-300 faq-icon">expand_more</span>
            </button>
            <div class="faq-answer hidden px-md md:px-lg pb-md md:pb-lg text-on-surface-variant text-sm leading-relaxed border-t border-outline-variant/20 pt-sm">
              Proses awal dimulai dengan wawancara orang tua mengenai riwayat tumbuh kembang anak, diikuti dengan sesi asesmen klinis langsung oleh psikolog anak kami. Hasil asesmen ini akan menentukan jenis terapi, frekuensi sesi per minggu, serta terapis yang sesuai untuk menyusun Program Terapi Individual (PTI).
            </div>
          </div>

          <!-- FAQ 2 -->
          <div class="faq-item border border-outline-variant/35 rounded-xl bg-white overflow-hidden transition-all duration-300">
            <button class="faq-toggle w-full p-md md:p-lg flex items-center justify-between text-left font-bold text-primary hover:bg-surface transition-colors cursor-pointer">
              <span>Berapa lama durasi per sesi terapi dan berapa kali dalam seminggu?</span>
              <span class="material-symbols-outlined transition-transform duration-300 faq-icon">expand_more</span>
            </button>
            <div class="faq-answer hidden px-md md:px-lg pb-md md:pb-lg text-on-surface-variant text-sm leading-relaxed border-t border-outline-variant/20 pt-sm">
              Satu sesi terapi berlangsung selama 50-60 menit (termasuk 5-10 menit evaluasi singkat dan pelaporan progres harian kepada orang tua). Frekuensi terapi sangat bervariasi bergantung hasil asesmen awal, umumnya berkisar antara 2 hingga 4 sesi per minggu.
            </div>
          </div>

          <!-- FAQ 3 -->
          <div class="faq-item border border-outline-variant/35 rounded-xl bg-white overflow-hidden transition-all duration-300">
            <button class="faq-toggle w-full p-md md:p-lg flex items-center justify-between text-left font-bold text-primary hover:bg-surface transition-colors cursor-pointer">
              <span>Apakah orang tua diperkenankan masuk ke dalam ruang terapi?</span>
              <span class="material-symbols-outlined transition-transform duration-300 faq-icon">expand_more</span>
            </button>
            <div class="faq-answer hidden px-md md:px-lg pb-md md:pb-lg text-on-surface-variant text-sm leading-relaxed border-t border-outline-variant/20 pt-sm">
              Pada sesi terapi privat 1-on-1, demi menjaga kefokusan perhatian anak terhadap instruksi terapis dan menghindari distraksi emosi, orang tua disarankan menunggu di ruang tunggu. Kami menyediakan ruang pantau kaca satu arah (one-way mirror) atau CCTV untuk orang tua yang ingin mengamati proses terapi tanpa mengganggu anak.
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA Section -->
    <section class="py-xl bg-primary relative overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="w-full h-full bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-secondary-fixed via-transparent to-transparent animate-pulse"></div>
      </div>
      <div class="relative z-10 max-w-[800px] mx-auto text-center px-margin-mobile text-on-primary">
        <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg mb-md text-white">Mari Dampingi Langkah Tumbuh Kembang Buah Hati Anda</h2>
        <p class="font-body-md mb-xl opacity-90 leading-relaxed max-w-[36rem] mx-auto">
          Hubungi kami untuk mengatur jadwal sesi konsultasi dan asesmen tumbuh kembang anak bersama psikolog klinis Graha Autis YP2SK.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-md">
          <a 
            href="/kontak" 
            class="w-full sm:w-auto text-center bg-secondary text-on-secondary px-8 py-3.5 rounded-lg font-label-lg font-bold hover:brightness-115 hover:scale-105 active:scale-95 transition-all shadow-lg"
          >
            Atur Jadwal Asesmen
          </a>
          <a 
            href="/kontak" 
            class="w-full sm:w-auto text-center border border-white/30 text-white px-8 py-3.5 rounded-lg font-label-lg font-bold hover:bg-white/10 hover:scale-105 active:scale-95 transition-all"
          >
            Hubungi Customer Care
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  function setupPage() {
    // FAQ Toggle
    const toggles = document.querySelectorAll('.faq-toggle');
    toggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        const item = toggle.parentElement;
        const answer = item?.querySelector('.faq-answer');
        const icon = toggle.querySelector('.faq-icon');
        
        const isHidden = answer?.classList.contains('hidden');
        
        // Close other items
        document.querySelectorAll('.faq-answer').forEach(ans => ans.classList.add('hidden'));
        document.querySelectorAll('.faq-icon').forEach(ic => ic.classList.remove('rotate-180'));
        document.querySelectorAll('.faq-item').forEach(it => it.classList.remove('border-secondary'));

        if (isHidden) {
          answer?.classList.remove('hidden');
          icon?.classList.add('rotate-180');
          item?.classList.add('border-secondary');
        }
      });
    });

    // Reveal animations on scroll
    const observerOptions = {
      threshold: 0.1,
      rootMargin: "0px 0px -50px 0px"
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('opacity-100', 'translate-y-0');
          entry.target.classList.remove('opacity-0', 'translate-y-10');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    const elements = document.querySelectorAll('.reveal-element');
    elements.forEach(el => {
      el.classList.add('transition-all', 'duration-700', 'ease-out', 'opacity-0', 'translate-y-10');
      observer.observe(el);
    });
  }

  // Setup on load and page transition
  setupPage();
  document.addEventListener('astro:after-swap', setupPage);
</script>
