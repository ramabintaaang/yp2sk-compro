---
import Layout from '../../layouts/Layout.astro';

const grahaAutisSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://yp2sk.or.id/pendidikan/graha-autis#webpage",
      "url": "https://yp2sk.or.id/pendidikan/graha-autis",
      "name": "Graha Autis | Pusat Terapi Anak Berkebutuhan Khusus YP2SK",
      "description": "Layanan terapi terpadu untuk anak autisme dan berkebutuhan khusus di Graha Autis YP2SK. Menyediakan terapi wicara, okupasi, perilaku, dan sensomotorik.",
      "breadcrumb": {
        "@id": "https://yp2sk.or.id/pendidikan/graha-autis#breadcrumb"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://yp2sk.or.id/pendidikan/graha-autis#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Beranda",
          "item": "https://yp2sk.or.id"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Pendidikan",
          "item": "https://yp2sk.or.id/pendidikan/graha-autis"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Graha Autis",
          "item": "https://yp2sk.or.id/pendidikan/graha-autis"
        }
      ]
    },
    {
      "@type": "MedicalBusiness",
      "@id": "https://yp2sk.or.id/pendidikan/graha-autis#clinic",
      "name": "Graha Autis YP2SK (Therapy Anak Berkebutuhan Khusus)",
      "description": "Pusat klinik terapi tumbuh kembang khusus untuk anak dengan spektrum autisme, ADHD, dan keterlambatan perkembangan di bawah naungan YP2SK.",
      "image": "https://yp2sk.or.id/images/graha_autis.png",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Jln. Madurekso No. 22, Langgar Dalem",
        "addressLocality": "Kota Kudus",
        "addressRegion": "Jawa Tengah",
        "postalCode": "59317",
        "addressCountry": "ID"
      }
    }
  ]
};
---

<Layout 
  title="Graha Autis | Terapi Anak Berkebutuhan Khusus Terpadu - YP2SK" 
  description="Graha Autis menyediakan pusat terapi komprehensif (wicara, okupasi, sensomotorik, perilaku) dengan terapis tersertifikasi untuk melatih kemandirian anak berkebutuhan khusus."
  schema={grahaAutisSchema}
>
  <!-- Floating Vector Ribbon Line matching yayasan & naneymi -->
  <div aria-hidden="true" class="curved-line-bg">
    <svg class="w-full h-full opacity-35" fill="none" preserveAspectRatio="none" viewBox="0 0 1440 4800">
      <path d="M720,200 C1100,500 1200,900 850,1300 C500,1700 200,2000 550,2500 C900,3000 1250,3300 950,3800 C700,4200 400,4500 720,4800" stroke="#8BBB92" stroke-dasharray="8 8" stroke-width="2.5"></path>
    </svg>
  </div>

  <!-- Calming Sensory-Friendly Soft Ambient Bubbles -->
  <div aria-hidden="true" class="absolute inset-0 pointer-events-none overflow-hidden z-0 opacity-40">
    <div class="absolute -top-20 -left-20 w-80 h-80 rounded-full bg-sky-200/50 blur-3xl"></div>
    <div class="absolute top-1/4 -right-20 w-96 h-96 rounded-full bg-teal-200/40 blur-3xl"></div>
    <div class="absolute top-2/3 -left-24 w-96 h-96 rounded-full bg-emerald-200/40 blur-3xl"></div>
    <div class="absolute bottom-10 right-10 w-80 h-80 rounded-full bg-amber-200/40 blur-3xl"></div>
  </div>

  <div class="relative z-10 font-sans">
    <!-- Hero Section (Calm, Warm & Inclusive with Neurodiversity-Friendly Badges & Overlapping Card) -->
    <section class="relative font-sans pb-8 sm:pb-14">
      <!-- Panoramic Banner with Calm Warm Atmosphere -->
      <div class="relative w-full h-[340px] sm:h-[400px] lg:h-[440px] overflow-hidden bg-slate-950 rounded-b-[2.5rem] sm:rounded-b-[3.5rem] shadow-md">
        <img 
          src="/images/graha_autis.png" 
          alt="A modern, warm sensory room at Graha Autis with therapeutic equipment" 
          class="w-full h-full object-cover object-center opacity-85"
          loading="eager"
        />
        <!-- Calming Sky & Emerald Gradient Overlays -->
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/35 to-sky-900/30"></div>

        <!-- Floating Soothing Badges inside Banner -->
        <div class="absolute top-6 left-6 sm:top-8 sm:left-12 flex items-center gap-2 bg-white/95 backdrop-blur-md px-3.5 py-1.5 rounded-full shadow-lg border border-sky-200 animate-float">
          <span class="text-xl">🧩</span>
          <span class="text-xs font-bold text-sky-800">Pusat Terapi &amp; Inklusi</span>
        </div>

        <div class="absolute top-6 right-6 sm:top-8 sm:right-12 hidden sm:flex items-center gap-2 bg-white/95 backdrop-blur-md px-3.5 py-1.5 rounded-full shadow-lg border border-teal-200 animate-float-delayed">
          <span class="text-xl">💙</span>
          <span class="text-xs font-bold text-teal-700">Penuh Cinta &amp; Kesabaran</span>
        </div>
      </div>
      
      <!-- Overlapping Soothing Profile Header Card -->
      <div class="max-w-4xl mx-auto px-4 sm:px-6 -mt-20 sm:-mt-24 lg:-mt-28 relative z-20" data-aos="zoom-in" data-aos-duration="700">
        <!-- Floating Sticker 1: Puzzle Piece on top left (Autism Growth & Special Mind) -->
        <div class="absolute -top-7 left-8 sm:left-12 z-30 w-14 h-14 rounded-2xl bg-sky-100 border-2 border-sky-300 shadow-md flex items-center justify-center text-3xl animate-wiggle select-none">
          🧩
        </div>

        <!-- Floating Sticker 2: Butterfly on top right (Metamorphosis & Unique Potential) -->
        <div class="absolute -top-6 right-8 sm:right-12 z-30 w-13 h-13 rounded-2xl bg-teal-100 border-2 border-teal-300 shadow-md flex items-center justify-center text-3xl animate-float select-none">
          🦋
        </div>

        <div class="bg-white/98 backdrop-blur-xl rounded-[2.5rem] p-8 sm:p-12 shadow-[0_15px_40px_-10px_rgba(14,165,233,0.15)] border-4 border-sky-100 text-center relative overflow-hidden">
          <div class="absolute -top-10 -right-10 w-32 h-32 bg-sky-100/60 rounded-full blur-xl pointer-events-none"></div>
          <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-teal-100/60 rounded-full blur-xl pointer-events-none"></div>

          <!-- Cute Pill Badge for Autism & Inclusion -->
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-gradient-to-r from-sky-100 via-teal-100 to-emerald-100 text-sky-900 border-2 border-sky-200/80 font-sans mb-4 shadow-2xs">
            <span class="text-sm">🧩</span>
            <span class="text-xs sm:text-sm font-bold tracking-wide">Pusat Terapi Anak Berkebutuhan Khusus &amp; Inklusi</span>
            <span class="text-sm">🌟</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight font-sans">
            Graha Autis <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-600 via-teal-600 to-emerald-600">YP2SK</span>
          </h1>

          <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed font-sans font-medium italic font-serif">
            "Memuliakan Amanah Fitrah dengan Cinta, Kesabaran, dan Rahmat." Membimbing anak berkebutuhan khusus menuju kemandirian perilaku, komunikasi, dan motorik melalui terapi terintegrasi.
          </p>

          <div class="mt-8 flex flex-wrap items-center justify-center gap-3.5">
            <a 
              href="/kontak" 
              class="px-7 py-3.5 rounded-full bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-bold text-xs sm:text-sm shadow-md hover:shadow-lg transition transform hover:-translate-y-1 active:translate-y-0 flex items-center gap-2"
            >
              <span>Konsultasi Sekarang</span>
              <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </a>
            <a 
              href="#layanan-terapi" 
              class="px-6 py-3.5 rounded-full bg-sky-50 hover:bg-sky-100 text-sky-900 border-2 border-sky-300 font-bold text-xs sm:text-sm shadow-xs transition transform hover:-translate-y-1 flex items-center gap-2"
            >
              <span>Lihat Program Terapi</span>
              <span class="material-symbols-outlined text-sm text-sky-600">expand_more</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Overview Section & Stats (Calm, Informative & Warm) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 scroll-mt-24">
      <div class="grid md:grid-cols-2 gap-10 lg:gap-14 items-center">
        <!-- Text Left -->
        <div class="space-y-5" data-aos="fade-right">
          <div class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-sky-100 text-sky-800 font-bold text-xs uppercase tracking-widest border border-sky-200">
            <span>💙</span>
            <span>Tentang Graha Autis</span>
          </div>

          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight leading-snug font-sans">
            Layanan Terapi Individual untuk Tumbuh Kembang Mandiri
          </h2>

          <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-sans">
            Graha Autis didirikan sebagai pusat intervensi dini yang terintegrasi bagi anak-anak berkebutuhan khusus, terutama penyandang spektrum autisme (ASD), ADHD, Down Syndrome, dan keterlambatan wicara (speech delay). Kami percaya bahwa dengan deteksi dini dan stimulasi terapi yang terarah, setiap anak memiliki peluang besar untuk berkembang secara optimal dan mandiri.
          </p>

          <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-sans">
            Tim kami terdiri dari psikolog perkembangan anak, terapis wicara, terapis okupasi, dan okupasional ortopedik yang berpengalaman. Setiap anak yang masuk akan melewati proses asesmen komprehensif terlebih dahulu untuk merumuskan Program Terapi Individual (PTI) yang disesuaikan dengan kebutuhan unik sang anak.
          </p>
          
          <!-- Key Specs Grid -->
          <div class="grid grid-cols-2 gap-4 pt-4 border-t border-slate-200">
            <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-sky-50 border border-sky-200/80">
              <span class="material-symbols-outlined text-sky-600 text-3xl shrink-0">clinical_notes</span>
              <div>
                <p class="text-[11px] text-slate-500 font-bold uppercase m-0 leading-none">Sesi Terapi</p>
                <p class="font-bold text-slate-900 text-sm sm:text-base m-0 mt-1">1-on-1 Privat</p>
              </div>
            </div>
            <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-teal-50 border border-teal-200/80">
              <span class="material-symbols-outlined text-teal-600 text-3xl shrink-0">psychology</span>
              <div>
                <p class="text-[11px] text-slate-500 font-bold uppercase m-0 leading-none">Asesmen</p>
                <p class="font-bold text-slate-900 text-sm sm:text-base m-0 mt-1">Berkala 3 Bulan</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Image Right in Playful Rounded Frame -->
        <div class="relative group" data-aos="fade-left" data-aos-delay="150">
          <div class="absolute -inset-3 bg-gradient-to-tr from-sky-200 via-teal-100 to-emerald-200 rounded-[2.5rem] -rotate-1.5 opacity-70 blur-xs transition-transform duration-500"></div>
          <div class="relative z-10 overflow-hidden rounded-[2.5rem] shadow-soft border-3 border-sky-200 aspect-[4/3] bg-slate-100">
            <img 
              class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700" 
              alt="Therapist helping a child in a therapy room at Graha Autis" 
              src="/images/graha_autis.png"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section (4 Calm, Cheerful & Sensory-Friendly Program Cards) -->
    <section id="layanan-terapi" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 scroll-mt-24">
      <div class="max-w-3xl mx-auto text-center font-sans mb-12 sm:mb-16" data-aos="fade-up">
        <div class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-teal-100 text-teal-800 font-bold text-xs uppercase tracking-widest border border-teal-200 mb-3 shadow-2xs">
          <span>🧩</span>
          <span>Layanan Intervensi</span>
          <span>✨</span>
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight leading-snug font-sans">
          Program Terapi Unggulan Kami
        </h2>
        <div class="w-20 h-1.5 bg-gradient-to-r from-sky-400 via-teal-400 to-emerald-400 mx-auto rounded-full mt-3"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- 1. Terapi Wicara (Soft Sky Blue) -->
        <div 
          class="relative bg-gradient-to-b from-sky-50/90 to-white rounded-[2.5rem] p-7 border-3 border-sky-200 shadow-soft hover:shadow-xl flex flex-col justify-between transition-all duration-300 hover:-translate-y-2 group"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <div class="absolute -top-3.5 right-6 bg-sky-200 text-sky-800 text-xs font-bold px-3 py-1 rounded-full border border-sky-300 flex items-center gap-1 shadow-xs">
            <span>Bahasa</span> <span>🗣️</span>
          </div>

          <div>
            <div class="w-14 h-14 rounded-3xl bg-sky-500 text-white flex items-center justify-center text-2xl mb-6 shadow-md shadow-sky-200 group-hover:scale-110 group-hover:rotate-6 transition-transform">
              <span class="material-symbols-outlined text-3xl">record_voice_over</span>
            </div>
            <h3 class="text-lg sm:text-xl font-extrabold text-slate-900 mb-2 font-sans group-hover:text-sky-600 transition-colors">
              Terapi Wicara
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans">
              Melatih kefasihan artikulasi, pemahaman bahasa reseptif dan ekspresif, kontak mata saat berbicara, serta kemampuan berkomunikasi dua arah secara fungsional.
            </p>
          </div>
        </div>

        <!-- 2. Terapi Okupasi (Soft Mint / Emerald) -->
        <div 
          class="relative bg-gradient-to-b from-emerald-50/90 to-white rounded-[2.5rem] p-7 border-3 border-emerald-200 shadow-soft hover:shadow-xl flex flex-col justify-between transition-all duration-300 hover:-translate-y-2 group"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <div class="absolute -top-3.5 right-6 bg-emerald-200 text-emerald-800 text-xs font-bold px-3 py-1 rounded-full border border-emerald-300 flex items-center gap-1 shadow-xs">
            <span>Motorik</span> <span>🖐️</span>
          </div>

          <div>
            <div class="w-14 h-14 rounded-3xl bg-emerald-600 text-white flex items-center justify-center text-2xl mb-6 shadow-md shadow-emerald-200 group-hover:scale-110 group-hover:-rotate-6 transition-transform">
              <span class="material-symbols-outlined text-3xl">hand_gesture</span>
            </div>
            <h3 class="text-lg sm:text-xl font-extrabold text-slate-900 mb-2 font-sans group-hover:text-emerald-700 transition-colors">
              Terapi Okupasi
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans">
              Meningkatkan kemandirian motorik halus (memegang pensil, menyendok makanan, mengancing baju) agar anak dapat melakukan aktivitas hidup sehari-hari.
            </p>
          </div>
        </div>

        <!-- 3. Sensori Integrasi (Warm Butter Amber) -->
        <div 
          class="relative bg-gradient-to-b from-amber-50/90 to-white rounded-[2.5rem] p-7 border-3 border-amber-200 shadow-soft hover:shadow-xl flex flex-col justify-between transition-all duration-300 hover:-translate-y-2 group"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <div class="absolute -top-3.5 right-6 bg-amber-200 text-amber-900 text-xs font-bold px-3 py-1 rounded-full border border-amber-300 flex items-center gap-1 shadow-xs">
            <span>Sensori</span> <span>🎈</span>
          </div>

          <div>
            <div class="w-14 h-14 rounded-3xl bg-amber-500 text-white flex items-center justify-center text-2xl mb-6 shadow-md shadow-amber-200 group-hover:scale-110 group-hover:rotate-6 transition-transform">
              <span class="material-symbols-outlined text-3xl">adjust</span>
            </div>
            <h3 class="text-lg sm:text-xl font-extrabold text-slate-900 mb-2 font-sans group-hover:text-amber-600 transition-colors">
              Sensori Integrasi
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans">
              Membantu anak yang mengalami hipersensitif atau hiposensitif terhadap stimulasi suara, tekstur, cahaya, dan melatih keseimbangan tubuh (vestibular/proprioseptif).
            </p>
          </div>
        </div>

        <!-- 4. Terapi Perilaku (ABA) (Gentle Lavender / Violet) -->
        <div 
          class="relative bg-gradient-to-b from-purple-50/90 to-white rounded-[2.5rem] p-7 border-3 border-purple-200 shadow-soft hover:shadow-xl flex flex-col justify-between transition-all duration-300 hover:-translate-y-2 group"
          data-aos="fade-up"
          data-aos-delay="400"
        >
          <div class="absolute -top-3.5 right-6 bg-purple-200 text-purple-800 text-xs font-bold px-3 py-1 rounded-full border border-purple-300 flex items-center gap-1 shadow-xs">
            <span>Perilaku</span> <span>🤝</span>
          </div>

          <div>
            <div class="w-14 h-14 rounded-3xl bg-purple-600 text-white flex items-center justify-center text-2xl mb-6 shadow-md shadow-purple-200 group-hover:scale-110 group-hover:-rotate-6 transition-transform">
              <span class="material-symbols-outlined text-3xl">diversity_3</span>
            </div>
            <h3 class="text-lg sm:text-xl font-extrabold text-slate-900 mb-2 font-sans group-hover:text-purple-700 transition-colors">
              Terapi Perilaku (ABA)
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans">
              Menggunakan metode *Applied Behavior Analysis* (ABA) untuk meminimalkan perilaku tantrum, melatih kepatuhan instruksi, dan meningkatkan keterampilan interaksi sosial.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section (Clean & Tidy Accordion Cards) -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 font-sans">
      <div class="text-center mb-12 sm:mb-14" data-aos="fade-up">
        <div class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-sky-100 text-sky-800 font-bold text-xs uppercase tracking-widest border border-sky-200 mb-3 shadow-2xs">
          <span>❓</span>
          <span>FAQ</span>
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight leading-snug font-sans">
          Pertanyaan Seputar Layanan Terapi
        </h2>
        <div class="w-16 h-1 bg-brand-emerald mx-auto rounded-full mt-3"></div>
      </div>

      <div class="space-y-4" data-aos="fade-up">
        <!-- FAQ 1 -->
        <div class="faq-item border-2 border-slate-200/90 hover:border-sky-300 rounded-3xl bg-white overflow-hidden shadow-soft transition-all duration-300">
          <button class="faq-toggle w-full p-6 sm:p-7 flex items-center justify-between text-left font-bold text-slate-900 hover:text-sky-700 transition-colors cursor-pointer">
            <span class="text-sm sm:text-base pr-4">Bagaimana proses awal pendaftaran terapi di Graha Autis?</span>
            <span class="material-symbols-outlined transition-transform duration-300 faq-icon text-slate-400 shrink-0">expand_more</span>
          </button>
          <div class="faq-answer hidden px-6 sm:px-7 pb-6 text-slate-600 text-xs sm:text-sm leading-relaxed border-t border-slate-100 pt-4">
            Proses awal dimulai dengan wawancara orang tua mengenai riwayat tumbuh kembang anak, diikuti dengan sesi asesmen klinis langsung oleh psikolog anak kami. Hasil asesmen ini akan menentukan jenis terapi, frekuensi sesi per minggu, serta terapis yang sesuai untuk menyusun Program Terapi Individual (PTI).
          </div>
        </div>

        <!-- FAQ 2 -->
        <div class="faq-item border-2 border-slate-200/90 hover:border-sky-300 rounded-3xl bg-white overflow-hidden shadow-soft transition-all duration-300">
          <button class="faq-toggle w-full p-6 sm:p-7 flex items-center justify-between text-left font-bold text-slate-900 hover:text-sky-700 transition-colors cursor-pointer">
            <span class="text-sm sm:text-base pr-4">Berapa lama durasi per sesi terapi dan berapa kali dalam seminggu?</span>
            <span class="material-symbols-outlined transition-transform duration-300 faq-icon text-slate-400 shrink-0">expand_more</span>
          </button>
          <div class="faq-answer hidden px-6 sm:px-7 pb-6 text-slate-600 text-xs sm:text-sm leading-relaxed border-t border-slate-100 pt-4">
            Satu sesi terapi berlangsung selama 50-60 menit (termasuk 5-10 menit evaluasi singkat dan pelaporan progres harian kepada orang tua). Frekuensi terapi sangat bervariasi bergantung hasil asesmen awal, umumnya berkisar antara 2 hingga 4 sesi per minggu.
          </div>
        </div>

        <!-- FAQ 3 -->
        <div class="faq-item border-2 border-slate-200/90 hover:border-sky-300 rounded-3xl bg-white overflow-hidden shadow-soft transition-all duration-300">
          <button class="faq-toggle w-full p-6 sm:p-7 flex items-center justify-between text-left font-bold text-slate-900 hover:text-sky-700 transition-colors cursor-pointer">
            <span class="text-sm sm:text-base pr-4">Apakah orang tua diperkenankan masuk ke dalam ruang terapi?</span>
            <span class="material-symbols-outlined transition-transform duration-300 faq-icon text-slate-400 shrink-0">expand_more</span>
          </button>
          <div class="faq-answer hidden px-6 sm:px-7 pb-6 text-slate-600 text-xs sm:text-sm leading-relaxed border-t border-slate-100 pt-4">
            Pada sesi terapi privat 1-on-1, demi menjaga kefokusan perhatian anak terhadap instruksi terapis dan menghindari distraksi emosi, orang tua disarankan menunggu di ruang tunggu. Kami menyediakan ruang pantau kaca satu arah (one-way mirror) atau CCTV untuk orang tua yang ingin mengamati proses terapi tanpa mengganggu anak.
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA Section (Tidy & Refined matching yayasan & naneymi) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 font-sans" data-aos="fade-up">
