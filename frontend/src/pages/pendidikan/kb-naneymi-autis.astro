      "url": "https://yp2sk.or.id/pendidikan/kb-naneymi-autis",
      "name": "KB Naneymi AUTIS | Kelompok Bermain Khusus Autisme YP2SK",
      "description": "Program Kelompok Bermain (KB) khusus untuk anak-anak dengan kondisi autisme. Menawarkan pembelajaran sensori, interaksi sosial terbimbing, dan Individualized Education Program (IEP).",
      "breadcrumb": {
        "@id": "https://yp2sk.or.id/pendidikan/kb-naneymi-autis#breadcrumb"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://yp2sk.or.id/pendidikan/kb-naneymi-autis#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Beranda",
          "item": "https://yp2sk.or.id"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Pendidikan",
          "item": "https://yp2sk.or.id/pendidikan/kb-naneymi-autis"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "KB Naneymi AUTIS",
          "item": "https://yp2sk.or.id/pendidikan/kb-naneymi-autis"
        }
      ]
    },
    {
      "@type": "EducationalOrganization",
      "@id": "https://yp2sk.or.id/pendidikan/kb-naneymi-autis#school",
      "name": "KB Naneymi AUTIS (Kelompok Bermain Khusus Autisme)",
      "description": "Lembaga pendidikan anak usia dini khusus untuk anak dengan spektrum autisme di bawah naungan YP2SK.",
      "image": "https://yp2sk.or.id/images/kb_naneymi_autis.png",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Jln. Madurekso No. 22, Langgar Dalem",
